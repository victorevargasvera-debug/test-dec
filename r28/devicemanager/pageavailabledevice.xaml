<Page x:Class="MackinawCPS.PageAvailableDevice"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:CommonResxNS="clr-namespace:CommonResources;assembly=CommonResources"
      Title="{x:Static CommonResxNS:AppResources.Page_Available_Device}">
  <Grid>
    <Button x:Name="button" HorizontalAlignment="Left" VerticalAlignment="Top" Width="Auto" Height="Auto"
            ToolTip="{x:Static CommonResxNS:AppResources.Read_Device}">
      <Image HorizontalAlignment="Stretch" Margin="0,0,0,0" VerticalAlignment="Stretch" Width="22" Height="17"
             Source="../../icons/Radio.ico"/>
    </Button>
    <Button HorizontalAlignment="Left" Margin="34,0,0,0" VerticalAlignment="Top" Width="Auto" Height="Auto"
            ToolTip="{x:Static CommonResxNS:AppResources.Write_Device}">
      <Image HorizontalAlignment="Stretch" Margin="0,0,0,0" VerticalAlignment="Stretch" Width="22" Height="17"
             Source="../../icons/ModOpt.ico"/>
    </Button>
    <Button HorizontalAlignment="Left" Margin="65.684,0,0,0" VerticalAlignment="Top" Width="Auto" Height="Auto"
            ToolTip="{x:Static CommonResxNS:AppResources.Clone_Id}">
      <Image HorizontalAlignment="Stretch" Margin="0,0,0,0" VerticalAlignment="Stretch" Width="22" Height="17"
             Source="../../icons/users.ico"/>
    </Button>
    <Button HorizontalAlignment="Left" Margin="94.684,0,0,0" VerticalAlignment="Top" Width="Auto" Height="Auto"
            ToolTip="{x:Static CommonResxNS:AppResources.FLASHport_Id}">
      <Image Margin="0,0,0,0" VerticalAlignment="Stretch" Width="22" Height="17" Source="../../icons/Radio.ico"/>
    </Button>
    <TreeView Name="MyTreeView" Margin="0,40,0,0" BorderThickness="0" HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Stretch" Background="{x:Null}"/>
  </Grid>
</Page>