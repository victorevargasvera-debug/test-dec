<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:AcpUINS="clr-namespace:AcpUI;assembly=AcpUI">
  <Style TargetType="{x:Type Button}">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="rectangle" OpacityMask="#FF000000" BorderThickness="1" CornerRadius="2.252"
                  Width="{TemplateBinding FrameworkElement.Width}" Height="{TemplateBinding FrameworkElement.Height}"
                  Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpButton, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpButtonNormalBackground}}}">
            <UIElement.BitmapEffect>
              <DropShadowBitmapEffect Opacity="0.515"/>
            </UIElement.BitmapEffect>
            <Border OpacityMask="#FF000000" RenderTransformOrigin="0.5,0.5" BorderThickness="1" Margin="2"
                    CornerRadius="2.252" Background="{x:Null}"
                    BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpButton, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpButtonBorderBrush}}}">
              <TextBlock Name="Text_PART" VerticalAlignment="Center" HorizontalAlignment="Center"
                         Text="{TemplateBinding ContentControl.Content}"
                         Foreground="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpButton, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpButtonNormalForeground}}}"/>
            </Border>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsFocused" Value="true"/>
            <Trigger Property="Button.IsDefaulted" Value="true"/>
            <Trigger Property="UIElement.IsMouseOver" Value="true">
              <Setter TargetName="rectangle"
                      Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpButton, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpButtonHoverBackground}}}"
                      Property="Border.Background"/>
            </Trigger>
            <Trigger Property="ButtonBase.IsPressed" Value="true">
              <Setter TargetName="rectangle"
                      Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpButton, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpButtonPressedBackground}}}"
                      Property="Border.Background"/>
            </Trigger>
            <Trigger Property="UIElement.IsEnabled" Value="false">
              <Setter TargetName="Text_PART" Property="TextBlock.Foreground"
                      Value="{DynamicResource ResourceKey={x:Static JetSystemColors.GrayTextBrushKey}}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type AcpUINS:AcpButton}" BasedOn="{StaticResource {x:Type Button}}">
    <Style.Triggers>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpValid}" Value="false">
        <Setter Property="Control.Foreground"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpButton, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpButtonInValidForeground}}}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpApplicable}" Value="false">
        <Setter Property="UIElement.IsEnabled" Value="false"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpEditable}" Value="false">
        <Setter Property="UIElement.IsEnabled" Value="false"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpVisible}" Value="false">
        <Setter Property="UIElement.Visibility" Value="Collapsed"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>