<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:AcpUINS="clr-namespace:AcpUI;assembly=AcpUI">
  <Style TargetType="{x:Type AcpUINS:AcpTreeViewItem}">
    <Setter Property="HeaderedItemsControl.HeaderTemplate">
      <Setter.Value>
        <DataTemplate>
          <StackPanel Name="HeaderPanel_PART" Orientation="Horizontal">
            <Image Name="HeaderDiffIcon" Visibility="Collapsed" Width="10" Height="10" HorizontalAlignment="Right"
                   Margin="5,0,0,0" Source="../../icons/warning.ico"/>
            <TextBlock Name="HeaderLbl" HorizontalAlignment="Left" Margin="5,0" Text="{Binding}"
                       Foreground="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTreeViewItem, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTreeViewItemForeground}}}"/>
          </StackPanel>
          <DataTemplate.Triggers>
            <DataTrigger Value="True" Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ShowDiffIcon}">
              <Setter TargetName="HeaderDiffIcon" Property="UIElement.Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Value="True" Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsSelected}">
              <Setter TargetName="HeaderPanel_PART"
                      Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTreeViewItem, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTreeViewItemSelectedBackground}}}"
                      Property="Panel.Background"/>
              <Setter TargetName="HeaderLbl"
                      Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTreeViewItem, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTreeViewItemSelectedForeground}}}"
                      Property="TextBlock.Foreground"/>
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>