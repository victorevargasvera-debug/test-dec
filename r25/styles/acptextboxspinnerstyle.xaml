  <AcpUICommonNS:EditabilityToOpacityConverter x:Key="editabilityToOpacity"/>
  <Style x:Key="MyFocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-2" StrokeThickness="1" Stroke="Black" StrokeDashArray="1 2"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type AcpUINS:AcpTextBoxSpinner}">
    <Style.Resources>
      <AcpUICommonNS:substitutionValueConverter x:Key="mySubstitutionConverter"/>
    </Style.Resources>
    <Style.Triggers>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpValid}" Value="false">
        <Setter Property="Control.Foreground"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBoxSpinner, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTextBoxSpinnerInValidForeground}}}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpApplicable}" Value="false">
        <Setter Property="UIElement.IsEnabled" Value="false"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpEditable}" Value="false">
        <Setter Property="UIElement.IsEnabled" Value="false"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpVisible}" Value="false">
        <Setter Property="UIElement.Visibility" Value="Collapsed"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="{x:Type AcpUINS:AcpTableTextBoxSpinner}">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type AcpUINS:AcpTableTextBoxSpinner}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition/>
              <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="5*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <AcpUINS:AcpTableTextBoxBase x:Name="AcpTextBoxMember" TabIndex="0" Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                                         FocusVisualStyle="{DynamicResource MyFocusVisual}"
                                         MaskType="{Binding Path=MaskTypeSpinner, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                         Text="{Binding Path=Text, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                         IsAcpValid="{Binding Path=IsAcpValid, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                         IsAcpApplicable="{Binding Path=IsAcpApplicable, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                         IsAcpEditable="{Binding Path=IsAcpEditable, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <i:Interaction.Triggers>
                <i:EventTrigger EventName="PreviewKeyDown">
                  <AcpUINS:AcpInvokeCommandAction Command="{Binding Source={StaticResource viewModel}, Path=KeyCommand}"
                                                  CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=., Mode=TwoWay}"/>
                </i:EventTrigger>
                <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                  <AcpUINS:AcpInvokeCommandAction Command="{Binding Source={StaticResource viewModel}, Path=MouseLeftButtonDownCommand}"
                                                  CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=., Mode=TwoWay}"/>
                </i:EventTrigger>
              </i:Interaction.Triggers>
            </AcpUINS:AcpTableTextBoxBase>
            <RepeatButton x:Name="UpClick" KeyboardNavigation.IsTabStop="false" Opacity="0" Grid.Column="1"
                          Height="11.63833333333335" Width="20" Delay="500" Interval="10" HorizontalAlignment="Right"
                          VerticalAlignment="Top" ToolTip="{x:Static AcpCommonResources:AcpResources.Increment_Id}"
                          IsEnabled="{Binding Path=IsAcpEditable, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <Image Source="../icons/SpinnerArrowUp.png"
                     Opacity="{Binding ElementName=UpClick, Path=IsEnabled, Converter={StaticResource editabilityToOpacity}, Mode=Oneway}"/>
              <i:Interaction.Triggers>
                <i:EventTrigger EventName="Click">
                  <AcpUINS:AcpInvokeCommandAction Command="{Binding Source={StaticResource viewModel}, Path=UpDownCommand}"
                                                  CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=MyBLObject, Mode=TwoWay}"/>
                </i:EventTrigger>
              </i:Interaction.Triggers>
            </RepeatButton>
            <RepeatButton x:Name="DownClick" KeyboardNavigation.IsTabStop="false" Opacity="0" Grid.Row="1" Grid.Column="1"
                          Height="11.63833333333335" Width="20" Delay="500" Interval="10" HorizontalAlignment="Right"
                          ToolTip="{x:Static AcpCommonResources:AcpResources.Decrement_Id}"
                          IsEnabled="{Binding Path=IsAcpEditable, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <Image Source="../icons/SpinnerArrowDown.png"
                     Opacity="{Binding ElementName=DownClick, Path=IsEnabled, Converter={StaticResource editabilityToOpacity}, Mode=Oneway}"/>
              <i:Interaction.Triggers>
                <i:EventTrigger EventName="Click">
                  <AcpUINS:AcpInvokeCommandAction Command="{Binding Source={StaticResource viewModel}, Path=UpDownCommand}"
                                                  CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=MyBLObject, Mode=TwoWay}"/>
                </i:EventTrigger>
              </i:Interaction.Triggers>
            </RepeatButton>
          </Grid>
          <ControlTemplate.Triggers>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="UIElement.IsMouseOver" Value="true"/>
                <Condition Property="AcpUINS:AcpTableTextBoxSpinner.IsAcpEditable" Value="true"/>
                <Condition Property="AcpUINS:AcpTableTextBoxSpinner.IsAcpApplicable" Value="true"/>
              </MultiTrigger.Conditions>
              <MultiTrigger.Setters>
                <Setter TargetName="UpClick" Property="UIElement.Opacity" Value="1"/>
                <Setter TargetName="DownClick" Property="UIElement.Opacity" Value="1"/>
              </MultiTrigger.Setters>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Resources>
