<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:AcpUICommonNS="clr-namespace:AcpUI.Common;assembly=AcpUI"
                    xmlns:PresentationOptions="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:AcpUINS="clr-namespace:AcpUI;assembly=AcpUI">
  <AcpUINS:AcpViewModel x:Key="viewModel"/>
  <LinearGradientBrush x:Key="WebBrowserBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientBrush.GradientStops>
      <GradientStop Color="#FFFFFF" Offset="0"/>
      <GradientStop Color="#E3E8F4" Offset="0.5"/>
      <GradientStop Color="#CFD7EB" Offset="0.5"/>
      <GradientStop Color="#E9ECFA" Offset="1.0"/>
    </GradientBrush.GradientStops>
  </LinearGradientBrush>
  <Style x:Key="AcpFocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-1" StrokeThickness="2" Stroke="#FF000037"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="MyFocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="0" StrokeThickness="1" Stroke="Black" StrokeDashArray="1 2"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="WelcomeScreenTextBlockStyle" TargetType="{x:Type TextBlock}">
    <Style.Triggers>
      <Trigger Property="UIElement.IsMouseOver" Value="true">
        <Setter Property="TextBlock.Foreground" Value="Red"/>
        <Setter Property="TextBlock.TextDecorations" Value="Underline"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="{x:Type ScrollBar}">
    <Setter Property="Control.Background" Value="Black"/>
  </Style>
  <Style x:Key="Image32x32Style" TargetType="{x:Type Image}">
    <Setter Property="FrameworkElement.Height" Value="32"/>
    <Setter Property="FrameworkElement.Width" Value="32"/>
  </Style>
  <Style x:Key="Image24x24Style" TargetType="{x:Type Image}">
    <Setter Property="FrameworkElement.Height" Value="24"/>
    <Setter Property="FrameworkElement.Width" Value="24"/>
  </Style>
  <Style x:Key="Image16x16Style" TargetType="{x:Type Image}">
    <Setter Property="FrameworkElement.Height" Value="16"/>
    <Setter Property="FrameworkElement.Width" Value="16"/>
  </Style>
  <AcpUICommonNS:ComboBoxItemsWidthConverter x:Key="comboBoxItemsWidthConverter"/>
  <DataTemplate x:Key="AcpComboBoxItemsTemplate">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{Binding RelativeSource={RelativeSource AncestorType={x:Type AcpUINS:AcpComboBox}}, Path=ActualWidth, Converter={StaticResource comboBoxItemsWidthConverter}}"/>
        <ColumnDefinition MinWidth="16"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="{Binding Path=ItemName}"/>
      <Image Grid.Column="1" Style="{StaticResource Image16x16Style}" Source="{Binding Path=ItemImage}"/>
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="AcpCheckBoxContentStyle">
    <TextBlock Margin="5,0,0,0" Text="{Binding}"/>
  </DataTemplate>
  <Style x:Key="UndoButton" TargetType="{x:Type Button}" BasedOn="{x:Null}">
    <Setter Property="Control.Template"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=Button, ResourceId={x:Static AcpUINS:AcpColorKeys.UndoButtonTempalte}}}"/>
  </Style>
  <Style x:Key="RedoButton" TargetType="{x:Type Button}" BasedOn="{x:Null}">
    <Setter Property="Control.Template"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=Button, ResourceId={x:Static AcpUINS:AcpColorKeys.RedoButtonTempalte}}}"/>
  </Style>
