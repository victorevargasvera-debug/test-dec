<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:AcpUINS="clr-namespace:AcpUI;assembly=AcpUI">
  <Style TargetType="{x:Type AcpUINS:AcpExpander}">
    <Setter Property="Control.Foreground"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpLabel, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpLabelForeground}}}"/>
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type AcpUINS:AcpExpander}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="25"/>
              <RowDefinition x:Name="ContentRow" Height="0"/>
            </Grid.RowDefinitions>
            <Border Name="Border" Grid.Row="0" BorderThickness="1" CornerRadius="2,2,0,0"
                    Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpExpander, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpExpanderBorderBackground}}}"
                    BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpExpander, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpExpanderBorderBrush1}}}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="20"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ToggleButton x:Name="ExpanderButton" DockPanel.Dock="Top" Grid.Column="0"
                              Template="{DynamicResource GroupExpanderToggleButtonTemplate}"
                              Content="{TemplateBinding HeaderedContentControl.Header}"
                              Background="{TemplateBinding FrameworkElement.Tag}" OverridesDefaultStyle="true" Padding="1.5,0"
                              IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"/>
                <TextBlock Grid.Column="1"/>
                <ContentPresenter Grid.Column="2" VerticalAlignment="Center" ContentSource="ExpToolbar"/>
              </Grid>
            </Border>
            <Border Name="Content" Grid.Row="1" BorderThickness="1,0,1,1" CornerRadius="0,0,2,2"
                    BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpExpander, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpExpanderBorderBrush2}}}">
              <ContentPresenter Margin="4"/>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Expander.IsExpanded" Value="true">
              <Setter TargetName="ContentRow" Value="{Binding ElementName=Content, Path=DesiredHeight}"
                      Property="RowDefinition.Height"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpValid}" Value="false">
        <Setter Property="Control.Foreground"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpExpander, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpExpanderInValidForeground}}}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpApplicable}" Value="false">
        <Setter Property="UIElement.IsEnabled" Value="false"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpEditable}" Value="false">
        <Setter Property="UIElement.IsEnabled" Value="false"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpVisible}" Value="false">
        <Setter Property="UIElement.Visibility" Value="Collapsed"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpVisible}" Value="true">
        <Setter Property="UIElement.Visibility" Value="Visible"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <DrawingBrush x:Key="TriangleDown" Stretch="Uniform">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <DrawingGroup.Children>
          <GeometryDrawing Brush="#003E3E3E"
                           Geometry="F1 M 0,0.00134277 L 511.999,0.00134277 511.999,512 0,512 0,0.00134277 Z"/>
          <GeometryDrawing Brush="#FF3E3E3E" Geometry="F1 M 256,416 L 416,96 96,96 256,416 Z"/>
        </DrawingGroup.Children>
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>
  <DrawingBrush x:Key="TriangleRight" Stretch="Uniform">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <DrawingGroup.Children>
          <GeometryDrawing Brush="#003E3E3E"
                           Geometry="F1 M 0,0.00134277 L 511.999,0.00134277 511.999,512 0,512 0,0.00134277 Z"/>
          <GeometryDrawing Brush="#FF3E3E3E" Geometry="F1 M 416,256 L 96,96 96,416 416,256 Z"/>
        </DrawingGroup.Children>
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>
  <ControlTemplate x:Key="GroupExpanderToggleButtonTemplate" TargetType="{x:Type ToggleButton}">
    <Border x:Name="ExpanderButtonBorder" Background="{TemplateBinding Control.Background}"
            BorderBrush="{TemplateBinding Control.BorderBrush}"
            BorderThickness="{TemplateBinding Control.BorderThickness}"
            Padding="{TemplateBinding Control.Padding}" FocusVisualStyle="{x:Null}">
      <Grid FocusVisualStyle="{x:Null}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Rectangle Fill="Transparent" Grid.ColumnSpan="2"/>
        <Rectangle Name="Sign" Grid.Column="0" Width="17" Height="17" Fill="{DynamicResource TriangleRight}"
                   FocusVisualStyle="{x:Null}"/>
        <ContentPresenter x:Name="HeaderContent" Grid.Column="1" Margin="0,0,0,0" ContentSource="Content"
                          VerticalAlignment="Center" FocusVisualStyle="{x:Null}"/>
      </Grid>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="ToggleButton.IsChecked" Value="True">
        <Setter TargetName="Sign" Value="{DynamicResource TriangleDown}" Property="Shape.Fill"/>
        <Setter Property="FrameworkElement.FocusVisualStyle">
          <Setter.Value>
            <Style/>
          </Setter.Value>
        </Setter>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style TargetType="{x:Type Expander}">
    <Setter Property="Control.Foreground"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpLabel, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpLabelForeground}}}"/>
  </Style>
</ResourceDictionary>