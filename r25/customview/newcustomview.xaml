<Page x:Class="MackinawCPS.CustomView.NewCustomView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:CommonResxNS="clr-namespace:CommonResources;assembly=CommonResources"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      Width="{DynamicResource 386}" Height="{DynamicResource 266}" Background="Transparent">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="35"/>
      <RowDefinition/>
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="{x:Static CommonResxNS:AppResources.Creating_A_New_Custom_View_File}"
               Margin="0,15,0,0" VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="Arial"
               FontSize="14" FontWeight="Bold" Foreground="{DynamicResource '176-176-139 Text on Screen'}"/>
    <TextBlock Grid.Row="1" Background="Transparent" Margin="21.502,28,25.418,0" VerticalAlignment="Top"
               FontFamily="Arial" FontSize="12" Foreground="{DynamicResource '176-176-139 Text on Screen'}"
               TextAlignment="Left" TextWrapping="Wrap" HorizontalAlignment="Center"
               Text="{x:Static CommonResxNS:AppResources.New_Exit_Custom_View_action_describe}"/>
  </Grid>
</Page>