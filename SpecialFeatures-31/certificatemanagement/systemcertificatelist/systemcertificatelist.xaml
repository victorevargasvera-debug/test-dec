<SystemCertificateRecSetNS:SystemCertificateListPage xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                                                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                                     xmlns:AcpUINS="clr-namespace:AcpUI;assembly=AcpUI"
                                                     xmlns:AcpBLConverterNS="clr-namespace:AcpBusinessLayer.ValueConverters;assembly=AcpBusinessLayer"
                                                     xmlns:igcontrols="http://infragistics.com/DataPresenter"
                                                     xmlns:igEditors="http://infragistics.com/Editors"
                                                     xmlns:igwindows="http://infragistics.com/Windows"
                                                     xmlns:sys="clr-namespace:System;assembly=mscorlib"
                                                     xmlns:SystemCertificateRecSetNS="clr-namespace:SpecialFeatures.SystemCertificates.List"
                                                     xmlns:AcpCommonLibNS="clr-namespace:AcpCommonLib;assembly=AcpCommonLib"
                                                     xmlns:src="clr-namespace:ConstraintHelper;assembly=AllFeatures"
                                                     xmlns:AcpUICommonNS="clr-namespace:AcpUI.Common;assembly=AcpUI"
                                                     xmlns:CommonResxNS="clr-namespace:CommonResources;assembly=CommonResources"
                                                     Page.Title="{x:Static CommonResxNS:AppResources.System_Cerfiticate_List_ID}">
  <AcpUINS:AcpPageFeature.PageRecNavToolbar>
    <AcpUINS:AcpParentRecNavToolbar FrameworkElement.Name="RecNavToolbarPageSystemCertificateList" DockPanel.Dock="Top"
                                    TableMode="False"
                                    MyRecordsetDataSource="{Binding RelativeSource={RelativeSource Self}, Path=DataContext}"/>
  </AcpUINS:AcpPageFeature.PageRecNavToolbar>
  <FrameworkElement.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>
    <AcpBLConverterNS:InvertBoolConverter x:Key="InvertBoolConverter"/>
    <AcpUICommonNS:CellVisibilityStausConverter x:Key="CellVisibilityStatus"/>
    <SystemCertificateRecSetNS:SystemCertificateParentControlVisibilityConverter x:Key="systemCertificateParentControlVisibilityConverter"/>
    <AcpUICommonNS:AcpRtdButtonVisibilityConverter x:Key="acpRtdButtonVisibilityConverter"/>
    <AcpUICommonNS:AcpCopyButtonVisibilityConverter x:Key="acpCopyButtonVisibilityConverter"/>
    <AcpUICommonNS:AcpCustomViewCheckBoxVisibilityConverter x:Key="acpCustomViewCheckBoxVisibilityConverter"/>
    <AcpUICommonNS:EditabilityConverter x:Key="editabilityConverter"/>
    <AcpUICommonNS:ParentControlVisibilityConverter x:Key="parentControlVisibilityConverter"/>
    <AcpUICommonNS:ComparatorControlVisibilityConverter x:Key="comparatorControlVisibilityConverter"/>
    <AcpUICommonNS:AcpRecNavToolbarTableModeConverter x:Key="acpRecNavToolbarTableModeConverter"/>
    <AcpUICommonNS:AcpFlyInButtonVisibilityConverter x:Key="flyInVisibilityConverter"/>
    <AcpUICommonNS:ParentContainerVisibilityConverter x:Key="parentContainerVisibilityConverter"/>
    <AcpUICommonNS:BooleanToColorConverter x:Key="BooleanToColor"/>
    <AcpUICommonNS:MultiValueToColorConverter x:Key="MultiValueToColor"/>
    <ObjectDataProvider x:Key="GetParentFeature" MethodName="GetRecordset"
                        ObjectType="{x:Type AcpUINS:AcpObjectDataProvider}">
      <ObjectDataProvider.MethodParameters>
        <sys:Int32>4228</sys:Int32>
      </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
    <ObjectDataProvider x:Key="GetComparatorParentFeature" MethodName="GetComparatorRecordset"
                        ObjectType="{x:Type AcpUINS:AcpObjectDataProvider}">
      <ObjectDataProvider.MethodParameters>
        <sys:Int32>4228</sys:Int32>
      </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
  </FrameworkElement.Resources>
  <DockPanel>
    <WrapPanel DockPanel.Dock="Top">
      <AcpUICommonNS:AcpThemeBase FrameworkElement.Name="ThemeBaseObj"/>
      <TextBlock Margin="25 3 0 0"
                 Visibility="{Binding ElementName=ExpanderSystemCertificateGeneral, Path=IsAcpVisible, Converter={StaticResource BooleanToVisibility}}">
        <Hyperlink x:Name="HLinkSystemCertificateGeneral" Tag="ExpanderSystemCertificateGeneral">
          <TextBlock Text="{x:Static CommonResxNS:AppResources.General_Id}" TextDecorations="Underline">
            <TextBlock.Foreground>
              <MultiBinding Converter="{StaticResource MultiValueToColor}">
                <Binding Source="false"/>
                <Binding Path="ThemeName" ElementName="ThemeBaseObj"/>
              </MultiBinding>
            </TextBlock.Foreground>
          </TextBlock>
        </Hyperlink>
      </TextBlock>
    </WrapPanel>
    <DockPanel Height="20" Background="Transparent" Dock="Top">
      <Rectangle Height="2" RadiusX="20" RadiusY="20" Stroke="Black" Fill="Gray" VerticalAlignment="Center"/>
    </DockPanel>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" DockPanel.Dock="Top">
      <StackPanel Name="MyStackPanel" Width="Auto" Height="Auto">
        <AcpUINS:AcpExpander FrameworkElement.Name="ExpanderSystemCertificateGeneral" FrameworkElement.Width="Auto"
                             HeaderedContentControl.Header="{Binding Path=General.UIName}"
                             ShowDiffIcon="{Binding Path=General.HasDiffs, Mode=OneWay}">
          <AcpUINS:AcpExpander.IsAcpVisible>
            <MultiBinding Converter="{StaticResource parentContainerVisibilityConverter}">
              <Binding ElementName="GrpBoxExpanderSystemCertificateListGeneralPseudo0" Path="IsAcpVisible"/>
            </MultiBinding>
          </AcpUINS:AcpExpander.IsAcpVisible>
          <StackPanel>
            <Grid Name="ExpanderSystemCertificateGeneralGrid">
              <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <AcpUINS:AcpGroupBox FrameworkElement.Name="GrpBoxExpanderSystemCertificateListGeneralPseudo0"
                                   Control.BorderBrush="Black" Grid.Row="0" Grid.Column="0" Control.BorderThickness="0">
                <AcpUINS:AcpGroupBox.IsAcpVisible>
                  <MultiBinding Converter="{StaticResource parentContainerVisibilityConverter}">
                    <Binding ElementName="SecSysCertGeneralCertificateFilename_A43634" Path="IsAcpVisible"/>
                  </MultiBinding>
                </AcpUINS:AcpGroupBox.IsAcpVisible>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Grid Name="StdGrpBoxExpanderSystemCertificateGeneralPseudo0" Column="0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="150"/>
                      <ColumnDefinition Width="300"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition/>
                      <RowDefinition/>
                    </Grid.RowDefinitions>
                    <AcpUINS:AcpCustomViewCheckBox FrameworkElement.Name="CVBtnSystemCertificateName" FrameworkElement.Margin="0,5,0,0" Grid.Row="0"
                                                   Grid.Column="0"
                                                   MyParentCtrl="{Binding ElementName=SecSysCertGeneralKeyofSystemCertificates_A43633}"
                                                   ToggleButton.IsChecked="{Binding ElementName=SecSysCertGeneralKeyofSystemCertificates_A43633, Path=MyBLObject.CustomViewVisibility}">
                      <AcpUINS:AcpCustomViewCheckBox.IsAcpVisible>
                        <MultiBinding Converter="{StaticResource acpCustomViewCheckBoxVisibilityConverter}" Mode="OneWay">
                          <Binding Source="{x:Static AcpCommonLibNS:AppInfoManager.AppInfoHelper}" Path="AppMode"/>
                          <Binding ElementName="SecSysCertGeneralKeyofSystemCertificates_A43633" Path="IsAcpVisible"/>
                        </MultiBinding>
                      </AcpUINS:AcpCustomViewCheckBox.IsAcpVisible>
                    </AcpUINS:AcpCustomViewCheckBox>
                    <AcpUINS:AcpLabel FrameworkElement.Name="LblSystemCertificateName"
                                      ContentControl.Content="{x:Static CommonResxNS:AppResources.System_Certificate_Name_ID}"
                                      Grid.Row="0" Grid.Column="1"
                                      HelpText="{x:Static CommonResxNS:AppResources.System_Certificate_Name_ID}"
                                      MyParentCtrl="{Binding ElementName=SecSysCertGeneralKeyofSystemCertificates_A43633}"
                                      IsAcpValid="{Binding ElementName=SecSysCertGeneralKeyofSystemCertificates_A43633, Path=IsAcpValid}"
                                      IsAcpApplicable="{Binding ElementName=SecSysCertGeneralKeyofSystemCertificates_A43633, Path=IsAcpApplicable}"
                                      IsAcpVisible="{Binding ElementName=SecSysCertGeneralKeyofSystemCertificates_A43633, Path=IsAcpVisible}"/>
                    <AcpUINS:AcpTextBox FrameworkElement.Name="SecSysCertGeneralKeyofSystemCertificates_A43633"
                                        FrameworkElement.Width="Auto" Grid.Row="0" Grid.Column="2"
                                        TextBox.Text="{Binding Path=General.SecSysCertGeneralKeyofSystemCertificates_A43633Value}"
                                        MyParentCtrl="{Binding ElementName=StdGrpBoxExpanderSystemCertificateGeneralPseudo0}"
                                        MyExpander="{Binding ElementName=ExpanderSystemCertificateGeneral}"
                                        MyBLObject="{Binding Path=General.SecSysCertGeneralKeyofSystemCertificates_A43633Object}"
                                        MyLabelCtrl="{Binding ElementName=LblSystemCertificateName}"
                                        IsAcpValid="{Binding Path=General.SecSysCertGeneralKeyofSystemCertificates_A43633_Valid}"
                                        IsAcpApplicable="{Binding Path=General.SecSysCertGeneralKeyofSystemCertificates_A43633_Applicable}"
                                        AreValuesEqual="{Binding Path=General.SecSysCertGeneralKeyofSystemCertificates_A43633_HasDiffs, Converter={StaticResource InvertBoolConverter}, Mode=OneWay}">
                      <AcpUINS:AcpTextBox.IsAcpEditable>
                        <MultiBinding Converter="{StaticResource editabilityConverter}" Mode="OneWay">
                          <Binding Source="{x:Static AcpCommonLibNS:AppInfoManager.AppInfoHelper}" Path="AppMode"/>
                          <Binding Path="General.SecSysCertGeneralKeyofSystemCertificates_A43633_Editable"/>
                          <Binding Path="General.SecSysCertGeneralKeyofSystemCertificates_A43633Object"/>
                        </MultiBinding>
                      </AcpUINS:AcpTextBox.IsAcpEditable>
                      <AcpUINS:AcpTextBox.IsAcpVisible>
                        <MultiBinding Converter="{StaticResource systemCertificateParentControlVisibilityConverter}" Mode="OneWay">
                          <Binding Source="{x:Static AcpCommonLibNS:AppInfoManager.AppInfoHelper}" Path="AppMode"/>
                          <Binding Source="{x:Static AcpCommonLibNS:AppInfoManager.AppInfoHelper}" Path="AppHideMatches"/>
                          <Binding Path="AreValuesEqual" RelativeSource="{RelativeSource Self}"/>
                          <Binding Path="General.SecSysCertGeneralKeyofSystemCertificates_A43633_Visible"/>
                          <Binding Path="General.SecSysCertGeneralCertificateFileData_A43635_HasDiffs"/>
                        </MultiBinding>
                      </AcpUINS:AcpTextBox.IsAcpVisible>
                    </AcpUINS:AcpTextBox>
                    <AcpUINS:AcpCustomViewCheckBox FrameworkElement.Name="CVBtnSystemCertificateFileName_A43634" FrameworkElement.Margin="0,5,0,0"
                                                   Grid.Row="1" Grid.Column="0"
                                                   MyParentCtrl="{Binding ElementName=SecSysCertGeneralCertificateFilename_A43634}"
                                                   ToggleButton.IsChecked="{Binding ElementName=SecSysCertGeneralCertificateFilename_A43634, Path=MyBLObject.CustomViewVisibility}">
                      <AcpUINS:AcpCustomViewCheckBox.IsAcpVisible>
                        <MultiBinding Converter="{StaticResource acpCustomViewCheckBoxVisibilityConverter}" Mode="OneWay">
                          <Binding Source="{x:Static AcpCommonLibNS:AppInfoManager.AppInfoHelper}" Path="AppMode"/>
                          <Binding ElementName="SecSysCertGeneralCertificateFilename_A43634" Path="IsAcpVisible"/>
                        </MultiBinding>
                      </AcpUINS:AcpCustomViewCheckBox.IsAcpVisible>
                    </AcpUINS:AcpCustomViewCheckBox>
                    <AcpUINS:AcpLabel FrameworkElement.Name="LblSystemCertificateFileName_A43634"
                                      ContentControl.Content="{x:Static CommonResxNS:AppResources.System_Certificate_Filename_ID}"
                                      Grid.Row="1" Grid.Column="1"
                                      HelpText="{x:Static CommonResxNS:AppResources.System_Certificate_Filename_ID}"
                                      MyParentCtrl="{Binding ElementName=SystemsystemCertificateFileName_A43634}"
                                      IsAcpValid="{Binding ElementName=SystemsystemCertificateFileName_A43634, Path=IsAcpValid}"
                                      IsAcpApplicable="{Binding ElementName=SystemsystemCertificateFileName_A43634, Path=IsAcpApplicable}"
                                      IsAcpVisible="{Binding ElementName=SystemsystemCertificateFileName_A43634, Path=IsAcpVisible}"/>
                    <AcpUINS:AcpTextBoxFileBrowser FrameworkElement.Name="SecSysCertGeneralCertificateFilename_A43634" FrameworkElement.Width="Auto"
                                                   Grid.Row="1" Grid.Column="2"
                                                   Text="{Binding Path=General.SecSysCertGeneralCertificateFilename_A43634Value}"
                                                   MyParentCtrl="{Binding ElementName=StdGrpBoxExpanderSystemCertificateGeneralPseudo0}"
                                                   MyExpander="{Binding ElementName=ExpanderSystemCertificateGeneral}"
                                                   MyBLObject="{Binding Path=General.SecSysCertGeneralCertificateFilename_A43634Object}"
                                                   MyLabelCtrl="{Binding ElementName=LblSystemCertificateFileName_A43634}"
                                                   IsAcpValid="{Binding Path=General.SecSysCertGeneralCertificateFilename_A43634_Valid}"
                                                   IsAcpApplicable="{Binding Path=General.SecSysCertGeneralCertificateFilename_A43634_Applicable}"
                                                   AreValuesEqual="{Binding Path=General.SecSysCertGeneralCertificateFilename_A43634_HasDiffs, Converter={StaticResource InvertBoolConverter}, Mode=OneWay}">
                      <AcpUINS:AcpTextBoxFileBrowser.IsAcpEditable>
                        <MultiBinding Converter="{StaticResource editabilityConverter}" Mode="OneWay">
                          <Binding Source="{x:Static AcpCommonLibNS:AppInfoManager.AppInfoHelper}" Path="AppMode"/>
                          <Binding Path="General.SecSysCertGeneralCertificateFilename_A43634_Editable"/>
                          <Binding Path="General.SecSysCertGeneralCertificateFilename_A43634Object"/>
                        </MultiBinding>
                      </AcpUINS:AcpTextBoxFileBrowser.IsAcpEditable>
                      <AcpUINS:AcpTextBoxFileBrowser.IsAcpVisible>
                        <MultiBinding Converter="{StaticResource systemCertificateParentControlVisibilityConverter}" Mode="OneWay">
                          <Binding Source="{x:Static AcpCommonLibNS:AppInfoManager.AppInfoHelper}" Path="AppMode"/>
                          <Binding Source="{x:Static AcpCommonLibNS:AppInfoManager.AppInfoHelper}" Path="AppHideMatches"/>
                          <Binding Path="AreValuesEqual" RelativeSource="{RelativeSource Self}"/>
                          <Binding Path="General.SecSysCertGeneralCertificateFilename_A43634_Visible"/>
                          <Binding Path="General.SecSysCertGeneralCertificateFileData_A43635_HasDiffs"/>
                        </MultiBinding>
                      </AcpUINS:AcpTextBoxFileBrowser.IsAcpVisible>
                    </AcpUINS:AcpTextBoxFileBrowser>
                  </Grid>
                  <Grid Name="CompGrpBoxExpanderSystemCertificateGeneralPseudo0" Column="1"
                        DataContext="{Binding Source={StaticResource GetComparatorParentFeature}}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition/>
                    </Grid.RowDefinitions>
                    <AcpUINS:AcpCopyButton FrameworkElement.Name="CpyBtnSystemCertificateFileName_A43634" Grid.Row="0" Grid.Column="0"
                                           MyParentCtrl="{Binding ElementName=SecSysCertGeneralCertificateFilename_A43634}"
                                           MyCompCtrl="{Binding ElementName=SystemCertificateFileName_A43634Comp}"
                                           AreValuesEqual="{Binding ElementName=SecSysCertGeneralCertificateFilename_A43634, Path=AreValuesEqual}">
                      <AcpUINS:AcpCopyButton.IsAcpVisible>
                        <MultiBinding Converter="{StaticResource acpCopyButtonVisibilityConverter}" Mode="OneWay">
                          <Binding Source="{x:Static AcpCommonLibNS:AppInfoManager.AppInfoHelper}" Path="AppMode"/>
                          <Binding ElementName="SecSysCertGeneralCertificateFilename_A43634" Path="MyBLObject"/>
                          <Binding ElementName="SecSysCertGeneralCertificateFilename_A43634" Path="IsAcpVisible"/>
                          <Binding ElementName="SecSysCertGeneralCertificateFilename_A43634" Path="IsAcpEditable"/>
                        </MultiBinding>
                      </AcpUINS:AcpCopyButton.IsAcpVisible>
                    </AcpUINS:AcpCopyButton>
                    <AcpUINS:AcpViewOnlyCtrl FrameworkElement.Name="SystemCertificateFileName_A43634Comp" FrameworkElement.Width="Auto"
                                             Grid.Row="0" Grid.Column="1"
                                             ContentControl.Content="{Binding Path=General.SystemsystemCertificateFileName_A43634Value}"
                                             MyBLObject="{Binding Path=General.SecSysCertGeneralCertificateFilename_A43634Object}"
                                             MyParentCtrl="{Binding ElementName=SecSysCertGeneralCertificateFilename_A43634}"
                                             MyCopyButtonCtrl="{Binding ElementName=CpyBtnSystemCertificateFileName_A43634}">
                      <AcpUINS:AcpViewOnlyCtrl.IsAcpVisible>
                        <MultiBinding Converter="{StaticResource comparatorControlVisibilityConverter}" Mode="OneWay">
                          <Binding Source="{x:Static AcpCommonLibNS:AppInfoManager.AppInfoHelper}" Path="AppMode"/>
                          <Binding ElementName="SystemsCertificateFileName_A43634" Path="IsAcpVisible"/>
                        </MultiBinding>
                      </AcpUINS:AcpViewOnlyCtrl.IsAcpVisible>
                    </AcpUINS:AcpViewOnlyCtrl>
                  </Grid>
                </Grid>
              </AcpUINS:AcpGroupBox>
            </Grid>
          </StackPanel>
        </AcpUINS:AcpExpander>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</SystemCertificateRecSetNS:SystemCertificateListPage>