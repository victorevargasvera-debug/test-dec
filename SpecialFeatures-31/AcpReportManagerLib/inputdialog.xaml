             xmlns:CommonResxNS="clr-namespace:CommonResources;assembly=CommonResources"
             Title="{x:Static CommonResxNS:AppResources.Go_To_Page_Suspension_Points}" Height="124" Width="208"
             WindowStyle="ThreeDBorderWindow" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
  <Grid>
    <TextBox Name="txtUserInput" Margin="35,16,37,45">
    </TextBox>
    <Button Name="BtnOk" Content="{x:Static CommonResxNS:AppResources.OK_Id}" Margin="58,0,0,9"
            VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="75" DataContext="{Binding}"/>
  </Grid>
</InputDialog>