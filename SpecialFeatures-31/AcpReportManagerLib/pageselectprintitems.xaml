<PageSelectPrintItems xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:sys="clr-namespace:System;assembly=mscorlib"
                      xmlns:AcpUINS="clr-namespace:AcpUI;assembly=AcpUI"
                      xmlns:CommonResxNS="clr-namespace:CommonResources;assembly=CommonResources"
                      Title="{x:Static CommonResxNS:AppResources.Select_Print_Items}" Focusable="True">
  <FrameworkElement.Resources>
    <RoutedCommand x:Key="F1Help"/>
  </FrameworkElement.Resources>
  <UIElement.CommandBindings>
    <CommandBinding Command="{StaticResource F1Help}"/>
  </UIElement.CommandBindings>
  <UIElement.InputBindings>
    <KeyBinding Command="{StaticResource F1Help}" Key="F1"/>
  </UIElement.InputBindings>
  <Grid Name="gReportsSelectPrintItems" Opacity="1" Height="419" Width="635"
        Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=Frame, ResourceId={x:Static AcpUINS:AcpColorKeys.FrameContentAreaPopupDialogueBackground}}}">
    <Label Name="lblAvailablePrint" Height="29" HorizontalAlignment="Left" Margin="14,39,0,0"
           VerticalAlignment="Top" Width="128" FontSize="14">
      <TextBlock Text="{x:Static CommonResxNS:AppResources.Available_Features}"/>
    </Label>
    <Label Name="lblSelectPrint" Height="29.277" HorizontalAlignment="Right" Margin="0,39,178,0"
           VerticalAlignment="Top" Width="127" FontSize="14">
      <TextBlock Text="{x:Static CommonResxNS:AppResources.Selected_Features}"/>
    </Label>
    <TreeView Name="tvAvailable" HorizontalAlignment="Left" Margin="14,61,0,22" Width="200"/>
    <TreeView Name="tvSelected" HorizontalAlignment="Right" Margin="0,61,105,22" Width="200"/>
    <Button Name="btnAddSelectedItems" HorizontalAlignment="Left" Margin="223,155,0,0" Width="76" FontSize="12"
            Height="31" VerticalAlignment="Top">&gt;&gt;</Button>
    <Button Name="btnRemSelectedItems" Height="31" HorizontalAlignment="Left" Margin="223,0,0,139"
            VerticalAlignment="Bottom" Width="76" FontSize="12">&lt;&lt;</Button>
    <Button Name="btnSave" Content="{x:Static CommonResxNS:AppResources.Save_ID}" Height="31"
            HorizontalAlignment="Right" Margin="0,61,10,0" VerticalAlignment="Top" Width="85" FontSize="14"/>
    <Button Name="btnSaveAs" Content="{x:Static CommonResxNS:AppResources.Save_As_}" Height="31"
            HorizontalAlignment="Right" Margin="0,0,10,294" VerticalAlignment="Bottom" Width="85" FontSize="14"/>
    <Button Name="btnCancel" Content="{x:Static CommonResxNS:AppResources.Cancel_Id}"
            HorizontalAlignment="Right" Margin="0,0,10,62" Width="85" FontSize="14" Height="31"
            VerticalAlignment="Bottom"/>
    <Button Name="btnHelp" Content="{x:Static CommonResxNS:AppResources.Help_Id}" HorizontalAlignment="Right"
            Margin="0,0,10,22" Width="85" FontSize="14" Height="31" VerticalAlignment="Bottom"/>
    <Image Name="imgMotologo" Margin="2,0,0,0" Height="45" VerticalAlignment="Top" Stretch="UniformToFill"/>
  </Grid>
</PageSelectPrintItems>