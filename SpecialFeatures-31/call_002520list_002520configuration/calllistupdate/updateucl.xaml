<CallListUpdateNS:UpdateUCL xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:AcpUINS="clr-namespace:AcpUI;assembly=AcpUI"
                            xmlns:AcpUICommonNS="clr-namespace:AcpUI.Common;assembly=AcpUI"
                            xmlns:AcpCommonLibNS="clr-namespace:AcpCommonLib;assembly=AcpCommonLib"
                            xmlns:AcpBLNS="clr-namespace:AcpBusinessLayer;assembly=AcpBusinessLayer"
                            xmlns:AcpBLConverterNS="clr-namespace:AcpBusinessLayer.ValueConverters;assembly=AcpBusinessLayer"
                            xmlns:dc="clr-namespace:DevComponents.WpfEditors;assembly=AcpWpfEditors"
                            xmlns:CallListUpdateNS="clr-namespace:SpecialFeatures.UCL.CallListUpdate"
                            xmlns:TrkCallList="clr-namespace:SpecialFeatures.Ucl.Contact"
                            xmlns:CommonResxNS="clr-namespace:CommonResources;assembly=CommonResources"
                            Title="{x:Static CommonResxNS:AppResources.Import_Call_List_From_Console}" Height="Auto"
                            Width="Auto" MaxWidth="630" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
                            WindowStartupLocation="CenterScreen"
                            Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=Frame, ResourceId={x:Static AcpUINS:AcpColorKeys.FrameContentAreaPopupDialogueBackground}}}">
  <FrameworkElement.Resources>
    <RoutedCommand x:Key="F1Help"/>
    <AcpUICommonNS:EditabilityToOpacityConverter x:Key="editabilityToOpacity"/>
  </FrameworkElement.Resources>
  <UIElement.CommandBindings>
    <CommandBinding Command="{StaticResource F1Help}"/>
  </UIElement.CommandBindings>
  <UIElement.InputBindings>
    <KeyBinding Command="{StaticResource F1Help}" Key="F1"/>
  </UIElement.InputBindings>
  <DockPanel Width="auto" Height="auto" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
    <Grid Height="auto" Width="auto" DockPanel.Dock="Top" ShowGridLines="False" VerticalAlignment="Stretch"
          HorizontalAlignment="Stretch" DataContext="{Binding}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="180"/>
        <ColumnDefinition Width="180"/>
        <ColumnDefinition Width="180"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="40"/>
        <RowDefinition Height="40"/>
        <RowDefinition Height="40"/>
        <RowDefinition Height="auto"/>
        <RowDefinition Height="40"/>
        <RowDefinition Height="40"/>
        <RowDefinition Height="40"/>
        <RowDefinition Height="20"/>
        <RowDefinition Height="60"/>
        <RowDefinition Height="60"/>
      </Grid.RowDefinitions>
      <AcpUINS:AcpLabel FrameworkElement.Name="lbAliasesListFilePath" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                        ContentControl.Content="{x:Static CommonResxNS:AppResources.Aliases_List_File_Path}"
                        FrameworkElement.Height="23" FrameworkElement.HorizontalAlignment="Left"
                        FrameworkElement.Margin="4,0,0,0" FrameworkElement.VerticalAlignment="Center"
                        FrameworkElement.Width="Auto"/>
      <AcpUINS:AcpTextBox FrameworkElement.Name="txtboxAliasesListFilePath" Grid.Row="1" Grid.ColumnSpan="2" Grid.RowSpan="1"
                          FrameworkElement.Height="40" FrameworkElement.HorizontalAlignment="Left"
                          FrameworkElement.Margin="6,2,0,0" FrameworkElement.VerticalAlignment="Top"
                          FrameworkElement.Width="360" TextBoxBase.HorizontalScrollBarVisibility="Visible"
                          FrameworkElement.ToolTip="{Binding RelativeSource={x:Static RelativeSource.Self}, Path=Text}"/>
      <Button Name="btnAliasesListFilePathBrowse" Grid.Row="1" Grid.Column="2" Margin="0,0,0,0"
              Content="{x:Static CommonResxNS:AppResources.Browse_Suspension}" Height="23"
              HorizontalAlignment="Center" VerticalAlignment="Top" Width="80"/>
      <GroupBox Name="groupBoxSysInfo" Grid.Row="3" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="3"
                Width="auto" Height="auto"
                Header="{x:Static CommonResxNS:AppResources.Trunking_System_Information}"
                HorizontalAlignment="Left" Margin="6,2,6,0">
        <Grid Row="3" RowSpan="3" Column="0" ColumnSpan="3" Height="auto" Width="auto">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="240"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
          </Grid.RowDefinitions>
          <AcpUINS:AcpLabel FrameworkElement.Name="lbSysType" Grid.Row="0" Grid.Column="0"
                            ContentControl.Content="{x:Static CommonResxNS:AppResources.System_Type}"
                            FrameworkElement.Height="28" FrameworkElement.HorizontalAlignment="Left"
                            FrameworkElement.Margin="4,2,0,0" FrameworkElement.VerticalAlignment="Top"/>
          <AcpUINS:AcpComboBox FrameworkElement.Name="comboSysType" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                               FrameworkElement.Height="23" FrameworkElement.HorizontalAlignment="left"
                               FrameworkElement.Margin="6,2,0,0" FrameworkElement.VerticalAlignment="Top"
                               FrameworkElement.Width="170" Selector.SelectedIndex="0"
                               ItemsControl.ItemsSource="{Binding SysTypeList}" Selector.SelectedItem="{Binding TypeSelection}"/>
          <AcpUINS:AcpLabel FrameworkElement.Name="lbSystemName" Grid.Row="1" Grid.Column="0"
                            ContentControl.Content="{x:Static CommonResxNS:AppResources.System_Name}"
                            FrameworkElement.Height="28" FrameworkElement.HorizontalAlignment="Left"
                            FrameworkElement.Margin="4,2,0,0" FrameworkElement.VerticalAlignment="Top"/>
          <AcpUINS:AcpComboBox FrameworkElement.Name="comboSysName" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                               FrameworkElement.Height="23" FrameworkElement.HorizontalAlignment="left"
                               FrameworkElement.Margin="6,2,0,0" FrameworkElement.VerticalAlignment="Top"
                               FrameworkElement.Width="170" ItemsControl.ItemsSource="{Binding lstSystemName}"
                               Selector.SelectedItem="{Binding NameSelection}"/>
          <AcpUINS:AcpLabel FrameworkElement.Name="LblTrkSysSystemID" Grid.Row="2" Grid.Column="0"
                            ContentControl.Content="{x:Static CommonResxNS:AcgResources.ID_SYSTEMID}"
                            FrameworkElement.Margin="4,2,0,0" FrameworkElement.Height="28"
                            FrameworkElement.HorizontalAlignment="Left" FrameworkElement.VerticalAlignment="Top"/>
          <AcpUINS:AcpTextBox FrameworkElement.Name="txSystemID" Grid.Row="2" UIElement.IsEnabled="False" Grid.Column="1"
                              Grid.ColumnSpan="2" FrameworkElement.Height="23" FrameworkElement.HorizontalAlignment="left"
                              FrameworkElement.Margin="6,2,0,0" FrameworkElement.VerticalAlignment="Top"
                              FrameworkElement.Width="170" TextBox.Text="{Binding Systemid}"/>
          <Grid x:Name="txspCustomSystemId" Row="2" Column="1" ColumnSpan="2" Height="23"
                HorizontalAlignment="left" Margin="6,2,0,0" VerticalAlignment="Top" Width="170">
            <Grid.RowDefinitions>
              <RowDefinition/>
              <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="5*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="5*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <AcpUINS:AcpTextBox x:Name="SystemidDec" Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" MaskType="{number:0-268435455}"
                                TextBox.Text="{Binding SystemidDecValue, Mode=Twoway}"/>
            <AcpUINS:AcpLabel Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" FrameworkElement.ContextMenu="{x:Null}">-</AcpUINS:AcpLabel>
            <AcpUINS:AcpTextBox x:Name="SystemidHex" Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" MaskType="{char:7:0-9a-fA-F}"
                                TextBox.Text="{Binding SystemidHexValue, Mode=Twoway}"/>
            <RepeatButton x:Name="UpClickSystemid" Grid.Row="0" Grid.Column="3" Height="11.63833333333335" Width="20"
                          Delay="500" Interval="10" HorizontalAlignment="Right">
              <Image Source="../../icons/SpinnerArrowUp.png"
                     Opacity="{Binding ElementName=UpClickSystemid, Path=IsEnabled, Converter={StaticResource editabilityToOpacity}, Mode=Oneway}"/>
            </RepeatButton>
            <RepeatButton x:Name="DownClickSystemid" Grid.Row="1" Grid.Column="3" Height="11.63833333333335" Width="20"
                          Delay="500" Interval="10" HorizontalAlignment="Right">
              <Image Source="../../icons/SpinnerArrowDown.png"
                     Opacity="{Binding ElementName=DownClickSystemid, Path=IsEnabled, Converter={StaticResource editabilityToOpacity}, Mode=Oneway}"/>
            </RepeatButton>
          </Grid>
          <AcpUINS:AcpLabel FrameworkElement.Name="LblTrkSysHomeWACNID" Grid.Row="3" Grid.Column="0"
                            ContentControl.Content="{x:Static CommonResxNS:AcgResources.ID_HOMEWACNID}"
                            FrameworkElement.Margin="4,2,0,0" FrameworkElement.Height="28"
                            FrameworkElement.HorizontalAlignment="Left" FrameworkElement.VerticalAlignment="Top"/>
          <AcpUINS:AcpTextBox FrameworkElement.Name="txWACNID" Grid.Row="3" UIElement.IsEnabled="False" Grid.Column="1"
                              Grid.ColumnSpan="2" FrameworkElement.Height="23" FrameworkElement.HorizontalAlignment="left"
                              FrameworkElement.Margin="6,2,0,0" FrameworkElement.VerticalAlignment="Top"
                              FrameworkElement.Width="170" TextBox.Text="{Binding Wacnid}"/>
          <Grid x:Name="txspCustomWACNID" Row="3" Column="1" ColumnSpan="2" Height="23" HorizontalAlignment="left"
                Margin="6,2,0,0" VerticalAlignment="Top" Width="170">
            <Grid.RowDefinitions>
              <RowDefinition/>
              <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="5*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="5*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <AcpUINS:AcpTextBox x:Name="CustomWACNIDDec" Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                                MaskType="{number:0-268435455}" TextBox.Text="{Binding WacnidDecValue, Mode=Twoway}"/>
            <AcpUINS:AcpLabel Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" FrameworkElement.ContextMenu="{x:Null}">-</AcpUINS:AcpLabel>
            <AcpUINS:AcpTextBox x:Name="CustomWACNIDHex" Grid.Row="0" Grid.Column="2" Grid.RowSpan="2"
                                MaskType="{char:7:0-9a-fA-F}" TextBox.Text="{Binding WacnidHexValue, Mode=Twoway}"/>
            <RepeatButton x:Name="UpClickCustomWACNID" Grid.Row="0" Grid.Column="3" Height="11.63833333333335" Width="20"
                          Delay="500" Interval="10" HorizontalAlignment="Right">
              <Image Source="../../icons/SpinnerArrowUp.png"
                     Opacity="{Binding ElementName=UpClickCustomWACNID, Path=IsEnabled, Converter={StaticResource editabilityToOpacity}, Mode=Oneway}"/>
            </RepeatButton>
            <RepeatButton x:Name="DownClickCustomWACNID" Grid.Row="1" Grid.Column="3" Height="11.63833333333335" Width="20"
                          Delay="500" Interval="10" HorizontalAlignment="Right">
              <Image Source="../../icons/SpinnerArrowDown.png"
                     Opacity="{Binding ElementName=DownClickCustomWACNID, Path=IsEnabled, Converter={StaticResource editabilityToOpacity}, Mode=Oneway}"/>
            </RepeatButton>
          </Grid>
        </Grid>
      </GroupBox>
      <Grid Row="7" Column="0" ColumnSpan="3" Height="40" HorizontalAlignment="left">
        <Grid.RowDefinitions>
          <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="60"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <AcpUINS:AcpCheckBox FrameworkElement.Name="ckDeleteExtra" FrameworkElement.Margin="35,5,0,0" Grid.Row="0"
                             Grid.Column="0" FrameworkElement.Width="15" FrameworkElement.HorizontalAlignment="Left"
                             FrameworkElement.VerticalAlignment="Top"/>
        <AcpUINS:AcpLabel FrameworkElement.Name="lbDeleteExtra" Grid.Row="0" Grid.Column="1"
                          ContentControl.Content="{x:Static CommonResxNS:AppResources.Delete_Extra_CallIDs_Or_Contacts}"
                          FrameworkElement.HorizontalAlignment="Left" FrameworkElement.VerticalAlignment="Top"/>
      </Grid>
      <AcpUINS:AcpLabel FrameworkElement.Name="lbNoteToUser" Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3"
                        ContentControl.Content="{x:Static CommonResxNS:AppResources.Update_Call_List_Option}"
                        FrameworkElement.Height="60" FrameworkElement.HorizontalAlignment="Left"
                        FrameworkElement.Margin="33,0,0,0" FrameworkElement.VerticalAlignment="Top"/>
      <Button Name="btnImport" Grid.Row="9" Grid.Column="0"
              Content="{x:Static CommonResxNS:AppResources.Import_ID_Button}" Height="23"
              HorizontalAlignment="Center" VerticalAlignment="Top" Width="100"/>
      <Button Name="btnCancel" Grid.Row="9" Grid.Column="1"
              Content="{x:Static CommonResxNS:AppResources.Cancel_Id}" Height="23" HorizontalAlignment="Center"
              VerticalAlignment="Top" Width="100"/>
      <Button Name="btnHelp" Grid.Row="9" Grid.Column="2" Content="{x:Static CommonResxNS:AppResources.Help_Id}"
              Height="23" HorizontalAlignment="Center" VerticalAlignment="Top" Width="100"/>
    </Grid>
  </DockPanel>
</CallListUpdateNS:UpdateUCL>