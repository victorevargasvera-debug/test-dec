<ACPUCLContactFeatureNS:UclContactPageTblView xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                              xmlns:AcpUINS="clr-namespace:AcpUI;assembly=AcpUI"
                                              xmlns:ACPUCLContactFeatureNS="clr-namespace:SpecialFeatures.Ucl.Contact"
                                              xmlns:AcpUIDragDropNS="clr-namespace:AcpUI.DragDrop;assembly=AcpUI"
                                              xmlns:AcpUICommonNS="clr-namespace:AcpUI.Common;assembly=AcpUI"
                                              xmlns:AcpCommonLibNS="clr-namespace:AcpCommonLib;assembly=AcpCommonLib"
                                              xmlns:AcpBLConverterNS="clr-namespace:AcpBusinessLayer.ValueConverters;assembly=AcpBusinessLayer"
                                              xmlns:igcontrols="http://infragistics.com/DataPresenter"
                                              xmlns:igEditors="http://infragistics.com/Editors"
                                              xmlns:sys="clr-namespace:System;assembly=mscorlib"
                                              xmlns:CommonResxNS="clr-namespace:CommonResources;assembly=CommonResources"
                                              Page.Title="{x:Static CommonResxNS:AppResources.Unified_Call_List_Table_View}">
  <AcpUINS:AcpPageFeature.PageRecNavToolbar>
    <AcpUINS:AcpRecNavToolbar FrameworkElement.Name="RecNavToolbarPageUclContact" Grid.Row="0" TableMode="True" MaskMaxLength="5"
                              DefaultMaskType="nnnnn"
                              MyRecordsetDataSource="{Binding ElementName=UclContactList, Path=DataSource}"/>
  </AcpUINS:AcpPageFeature.PageRecNavToolbar>
  <FrameworkElement.Resources>
    <AcpUICommonNS:AcpRtdButtonVisibilityConverter x:Key="acpRtdButtonVisibilityConverter"/>
    <AcpUICommonNS:AcpCopyButtonVisibilityConverter x:Key="acpCopyButtonVisibilityConverter"/>
    <AcpUICommonNS:AcpCustomViewCheckBoxVisibilityConverter x:Key="acpCustomViewCheckBoxVisibilityConverter"/>
    <AcpUICommonNS:AcpXamDataPresenterVisibilityConverter x:Key="acpXamDataPresenterVisibityConverter"/>
    <AcpUICommonNS:EditabilityConverter x:Key="editabilityConverter"/>
    <AcpUICommonNS:ParentControlVisibilityConverter x:Key="parentControlVisibilityConverter"/>
    <AcpUICommonNS:ComparatorControlVisibilityConverter x:Key="comparatorControlVisibilityConverter"/>
    <AcpUICommonNS:AcpRecNavToolbarTableModeConverter x:Key="acpRecNavToolbarTableModeConverter"/>
    <AcpUICommonNS:AcpRecNavToolbarVisibilityConverter x:Key="acpRecNavToolbarVisibityConverter"/>
    <AcpUICommonNS:TableViewVisibilityConverter x:Key="tableViewVisibityConverter"/>
    <AcpUICommonNS:SRecViewVisibilityConverter x:Key="sRecViewVisibityConverter"/>
    <AcpUICommonNS:AcpFlyInButtonVisibilityConverter x:Key="flyInVisibilityConverter"/>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>
    <AcpBLConverterNS:InvertBoolConverter x:Key="InvertBoolConverter"/>
    <AcpUICommonNS:ClmVisibilityStausConverter x:Key="ClmVisibilityStatus"/>
    <AcpUICommonNS:CellVisibilityStausConverter x:Key="CellVisibilityStatus"/>
    <AcpUICommonNS:DateTimeFormatConverter x:Key="dateTimeFormatter"/>
    <AcpUICommonNS:ParentContainerVisibilityConverter x:Key="groupboxVisibilityConverter"/>
    <ObjectDataProvider x:Key="GetParentRecset" MethodName="GetRecordset"
                        ObjectType="{x:Type AcpUINS:AcpObjectDataProvider}">
      <ObjectDataProvider.MethodParameters>
        <sys:Int32>2200</sys:Int32>
      </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
    <ObjectDataProvider x:Key="GetComparatorParentFeature" MethodName="GetComparatorRecordset"
                        ObjectType="{x:Type AcpUINS:AcpObjectDataProvider}">
      <ObjectDataProvider.MethodParameters>
        <sys:Int32>2200</sys:Int32>
      </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
    <ObjectDataProvider x:Key="GetTrunkingRecset" MethodName="GetRecordset"
                        ObjectType="{x:Type AcpUINS:AcpObjectDataProvider}">
      <ObjectDataProvider.MethodParameters>
        <sys:Int32>2200</sys:Int32>
        <sys:Int32>0</sys:Int32>
        <sys:Int32>10401</sys:Int32>
      </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
    <ObjectDataProvider x:Key="GetTrunkingT2Recset" MethodName="GetRecordset"
                        ObjectType="{x:Type AcpUINS:AcpObjectDataProvider}">
      <ObjectDataProvider.MethodParameters>
        <sys:Int32>2200</sys:Int32>
        <sys:Int32>0</sys:Int32>
        <sys:Int32>10411</sys:Int32>
      </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
    <ObjectDataProvider x:Key="GetAstroRecset" MethodName="GetRecordset"
                        ObjectType="{x:Type AcpUINS:AcpObjectDataProvider}">
      <ObjectDataProvider.MethodParameters>
        <sys:Int32>2200</sys:Int32>
        <sys:Int32>0</sys:Int32>
        <sys:Int32>10403</sys:Int32>
      </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
    <ObjectDataProvider x:Key="GetMDCRecset" MethodName="GetRecordset" ObjectType="{x:Type AcpUINS:AcpObjectDataProvider}">
      <ObjectDataProvider.MethodParameters>
        <sys:Int32>2200</sys:Int32>
        <sys:Int32>0</sys:Int32>
        <sys:Int32>10405</sys:Int32>
      </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
    <ObjectDataProvider x:Key="GetPhoneRecset" MethodName="GetRecordset"
                        ObjectType="{x:Type AcpUINS:AcpObjectDataProvider}">
      <ObjectDataProvider.MethodParameters>
        <sys:Int32>2200</sys:Int32>
        <sys:Int32>0</sys:Int32>
        <sys:Int32>10413</sys:Int32>
      </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
    <Style x:Key="FlyIn" TargetType="{x:Type CellValuePresenter}"
           BasedOn="{StaticResource MyCellValuePresenter}">
      <Setter Property="ContentControl.ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <AcpUINS:AcpFlyInButton FrameworkElement.ToolTip="{x:Static CommonResxNS:AppResources.Fly_In}" FrameworkElement.Width="30"
                                    FrameworkElement.Height="27" Control.Foreground="Black"
                                    ShowDiffIcon="{Binding RelativeSource={RelativeSource AncestorType={x:Type CellValuePresenter}}, Path=Record.DataItem._HasDiffs, Mode=OneWay}"/>
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ContactAliasCellStyle" TargetType="{x:Type CellValuePresenter}"
           BasedOn="{StaticResource MyCellValuePresenter}">
      <Setter Property="ContentControl.ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <AcpUINS:AcpTableTextBox TextBox.MaxLength="14" MyExpander="{Binding ElementName=ExpGeneral}"
                                     TextBox.Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type CellValuePresenter}}, Path=Record.DataItem.General.UclGen_ContactAlias_A00009Value, Mode=TwoWay}"
                                     MyBLObject="{Binding RelativeSource={RelativeSource AncestorType={x:Type CellValuePresenter}}, Path=Record.DataItem.General.UclGen_ContactAlias_A00009Object, Mode=OneWay}"
                                     IsAcpValid="{Binding RelativeSource={RelativeSource AncestorType={x:Type CellValuePresenter}}, Path=Record.DataItem.General.UclGen_ContactAlias_A00009_Valid, Mode=TwoWay}"
                                     IsAcpApplicable="{Binding RelativeSource={RelativeSource AncestorType={x:Type CellValuePresenter}}, Path=Record.DataItem.General.UclGen_ContactAlias_A00009_Applicable, Mode=TwoWay}"
                                     IsAcpVisible="{Binding RelativeSource={RelativeSource AncestorType={x:Type CellValuePresenter}}, Path=Record.DataItem.General.UclGen_ContactAlias_A00009_Visible, Mode=TwoWay}">
              <AcpUINS:AcpTextBox.IsAcpEditable>
                <MultiBinding Converter="{StaticResource editabilityConverter}" Mode="OneWay">
                  <Binding Source="{x:Static AcpCommonLibNS:AppInfoManager.AppInfoHelper}" Path="AppMode"/>
                  <Binding Path="Record.DataItem.General.UclGen_ContactAlias_A00009_Editable"
                           RelativeSource="{RelativeSource AncestorType={x:Type CellValuePresenter}}"/>
                  <Binding Path="Record.DataItem.General.UclGen_ContactAlias_A00009Object"
                           RelativeSource="{RelativeSource AncestorType={x:Type CellValuePresenter}}"/>
                </MultiBinding>
              </AcpUINS:AcpTextBox.IsAcpEditable>
            </AcpUINS:AcpTableTextBox>
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition/>
    </Grid.RowDefinitions>
    <AcpUINS:AcpXamDataPresenter x:Name="UclContactList" KeyboardNavigation.AcceptsReturn="True" Grid.Row="1">
      <AcpUINS:AcpXamDataPresenter.IsAcpVisible>
        <MultiBinding Converter="{StaticResource acpXamDataPresenterVisibityConverter}" Mode="OneWay">
          <Binding Source="{x:Static AcpCommonLibNS:AppInfoManager.AppInfoHelper}" Path="AppMode"/>
          <Binding Source="{x:Static AcpCommonLibNS:AppInfoManager.AppInfoHelper}" Path="AppHideMatches"/>
          <Binding Source="{StaticResource GetParentRecset}" Path="_HasDiffs"/>
          <Binding Path="IsAcpVisible" RelativeSource="{RelativeSource Self}"/>
          <Binding Path="FieldLayouts[0].Fields[0].Visibility" RelativeSource="{RelativeSource Self}"/>
        </MultiBinding>
      </AcpUINS:AcpXamDataPresenter.IsAcpVisible>
      <DataPresenterBase.FieldLayouts>
        <FieldLayout>
          <FieldLayout.Fields>
            <UnboundField Name="{x:Static CommonResxNS:AppResources.Contact_Name}"
                          BindingPath="General.UclGen_ContactAlias_A00009Object" BindingMode="OneWay"
                          Visibility="{Binding Source={StaticResource GetParentRecset}, Path=General.UclGen_ContactAlias_A00009_Visible, Converter={StaticResource BooleanToVisibility}}">
              <Field.Settings>
                <FieldSettings CellValuePresenterStyle="{StaticResource ContactAliasCellStyle}"/>
              </Field.Settings>
            </UnboundField>
          </FieldLayout.Fields>
        </FieldLayout>
      </DataPresenterBase.FieldLayouts>
    </AcpUINS:AcpXamDataPresenter>
  </Grid>
</ACPUCLContactFeatureNS:UclContactPageTblView>