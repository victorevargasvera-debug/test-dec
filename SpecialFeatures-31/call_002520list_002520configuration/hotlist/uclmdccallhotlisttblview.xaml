<UclMDCCallHotListTblView xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:AcpUINS="clr-namespace:AcpUI;assembly=AcpUI"
                          xmlns:AcpUICommonNS="clr-namespace:AcpUI.Common;assembly=AcpUI"
                          xmlns:AcpUIDragDropNS="clr-namespace:AcpUI.DragDrop;assembly=AcpUI"
                          xmlns:igcontrols="http://infragistics.com/DataPresenter"
                          xmlns:igEditors="http://infragistics.com/Editors"
                          xmlns:sys="clr-namespace:System;assembly=mscorlib"
                          xmlns:AcpCommonLibNS="clr-namespace:AcpCommonLib;assembly=AcpCommonLib"
                          xmlns:AcpBLConverterNS="clr-namespace:AcpBusinessLayer.ValueConverters;assembly=AcpBusinessLayer"
                          xmlns:CommonResxNS="clr-namespace:CommonResources;assembly=CommonResources"
                          Page.Title="{x:Static CommonResxNS:AppResources.MDC_Conventional_Hot_List_Table_View}">
  <AcpUINS:AcpPageFeature.PageRecNavToolbar>
    <AcpUINS:AcpRecNavToolbar FrameworkElement.Name="RecNavToolbarPageUclMDCHotList" Grid.Row="0" TableMode="True"
                              MyRecordsetDataSource="{Binding ElementName=UclMDCHotList, Path=DataSource}"/>
  </AcpUINS:AcpPageFeature.PageRecNavToolbar>
  <FrameworkElement.Resources>
    <AcpUICommonNS:AcpRtdButtonVisibilityConverter x:Key="acpRtdButtonVisibilityConverter"/>
    <AcpUICommonNS:AcpCopyButtonVisibilityConverter x:Key="acpCopyButtonVisibilityConverter"/>
    <AcpUICommonNS:AcpCustomViewCheckBoxVisibilityConverter x:Key="acpCustomViewCheckBoxVisibilityConverter"/>
    <AcpUICommonNS:AcpXamDataPresenterVisibilityConverter x:Key="acpXamDataPresenterVisibityConverter"/>
    <AcpUICommonNS:EditabilityConverter x:Key="editabilityConverter"/>
    <AcpUICommonNS:ParentControlVisibilityConverter x:Key="parentControlVisibilityConverter"/>
    <AcpUICommonNS:ComparatorControlVisibilityConverter x:Key="comparatorControlVisibilityConverter"/>
    <AcpUICommonNS:AcpRecNavToolbarTableModeConverter x:Key="acpRecNavToolbarTableModeConverter"/>
    <AcpUICommonNS:AcpRecNavToolbarVisibilityConverter x:Key="acpRecNavToolbarVisibityConverter"/>
    <AcpUICommonNS:TableViewVisibilityConverter x:Key="tableViewVisibityConverter"/>
    <AcpUICommonNS:SRecViewVisibilityConverter x:Key="sRecViewVisibityConverter"/>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>
    <AcpBLConverterNS:InvertBoolConverter x:Key="InvertBoolConverter"/>
    <AcpUICommonNS:ClmVisibilityStausConverter x:Key="ClmVisibilityStatus"/>
    <AcpUICommonNS:CellVisibilityStausConverter x:Key="CellVisibilityStatus"/>
    <AcpUICommonNS:DateTimeFormatConverter x:Key="dateTimeFormatter"/>
    <AcpUICommonNS:ParentContainerVisibilityConverter x:Key="groupboxVisibilityConverter"/>
    <ObjectDataProvider x:Key="GetParentRecset" MethodName="GetRecordset"
                        ObjectType="{x:Type AcpUINS:AcpObjectDataProvider}">
      <ObjectDataProvider.MethodParameters>
        <sys:Int32>2212</sys:Int32>
      </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
    <ObjectDataProvider x:Key="GetChildRecset" MethodName="GetRecordset"
                        ObjectType="{x:Type AcpUINS:AcpObjectDataProvider}">
      <ObjectDataProvider.MethodParameters>
        <sys:Int32>2212</sys:Int32>
        <sys:Int32>0</sys:Int32>
        <sys:Int32>10419</sys:Int32>
      </ObjectDataProvider.MethodParameters>
    </ObjectDataProvider>
    <Style x:Key="HotListAliasCellStyle" TargetType="{x:Type CellValuePresenter}"
           BasedOn="{StaticResource MyCellValuePresenter}">
      <Setter Property="ContentControl.ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <AcpUINS:AcpTableTextBox TextBox.Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type CellValuePresenter}}, Path='Record.DataItem.MDCCallHotList .UclMDCCnvHotList_HotListAlias_A00045Value', Mode=TwoWay}"
                                     MyExpander="{Binding ElementName=ExpMDCCallHotList}"
                                     MyBLObject="{Binding RelativeSource={RelativeSource AncestorType={x:Type CellValuePresenter}}, Path='Record.DataItem.MDCCallHotList .UclMDCCnvHotList_HotListAlias_A00045Object', Mode=OneWay}"
                                     IsAcpValid="{Binding RelativeSource={RelativeSource AncestorType={x:Type CellValuePresenter}}, Path='Record.DataItem.MDCCallHotList .UclMDCCnvHotList_HotListAlias_A00045_Valid', Mode=TwoWay}"
                                     IsAcpApplicable="{Binding RelativeSource={RelativeSource AncestorType={x:Type CellValuePresenter}}, Path='Record.DataItem.MDCCallHotList .UclMDCCnvHotList_HotListAlias_A00045_Applicable', Mode=TwoWay}"
                                     IsAcpVisible="{Binding RelativeSource={RelativeSource AncestorType={x:Type CellValuePresenter}}, Path='Record.DataItem.MDCCallHotList .UclMDCCnvHotList_HotListAlias_A00045_Visible', Mode=TwoWay}">
              <AcpUINS:AcpTextBox.IsAcpEditable>
                <MultiBinding Converter="{StaticResource editabilityConverter}" Mode="OneWay">
                  <Binding Source="{x:Static AcpCommonLibNS:AppInfoManager.AppInfoHelper}" Path="AppMode"/>
                  <Binding Path="Record.DataItem.MDCCallHotList .UclMDCCnvHotList_HotListAlias_A00045_Editable"
                           RelativeSource="{RelativeSource AncestorType={x:Type CellValuePresenter}}"/>
                  <Binding Path="Record.DataItem.MDCCallHotList .UclMDCCnvHotList_HotListAlias_A00045Object"
                           RelativeSource="{RelativeSource AncestorType={x:Type CellValuePresenter}}"/>
                </MultiBinding>
              </AcpUINS:AcpTextBox.IsAcpEditable>
            </AcpUINS:AcpTableTextBox>
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition/>
    </Grid.RowDefinitions>
    <AcpUINS:AcpXamDataPresenter x:Name="UclMDCHotList" KeyboardNavigation.AcceptsReturn="True" Grid.Row="1">
      <AcpUINS:AcpXamDataPresenter.IsAcpVisible>
        <MultiBinding Converter="{StaticResource acpXamDataPresenterVisibityConverter}" Mode="OneWay">
          <Binding Source="{x:Static AcpCommonLibNS:AppInfoManager.AppInfoHelper}" Path="AppMode"/>
          <Binding Source="{x:Static AcpCommonLibNS:AppInfoManager.AppInfoHelper}" Path="AppHideMatches"/>
          <Binding Source="{StaticResource GetParentRecset}" Path="_HasDiffs"/>
          <Binding Path="IsAcpVisible" RelativeSource="{RelativeSource Self}"/>
          <Binding Path="FieldLayouts[0].Fields[0].Visibility" RelativeSource="{RelativeSource Self}"/>
        </MultiBinding>
      </AcpUINS:AcpXamDataPresenter.IsAcpVisible>
      <DataPresenterBase.FieldLayouts>
        <FieldLayout>
          <FieldLayout.Fields>
            <UnboundField Name="{x:Static CommonResxNS:AppResources.Hot_List_Alias}"
                          BindingPath="MDCCallHotList.UclMDCCnvHotList_HotListAlias_A00045Object" BindingMode="OneWay"
                          Visibility="{Binding Source={StaticResource GetParentRecset}, Path=MDCCallHotList.UclMDCCnvHotList_HotListAlias_A00045_Visible, Converter={StaticResource BooleanToVisibility}}">
              <Field.Settings>
                <FieldSettings CellValuePresenterStyle="{StaticResource HotListAliasCellStyle}"/>
              </Field.Settings>
            </UnboundField>
          </FieldLayout.Fields>
        </FieldLayout>
      </DataPresenterBase.FieldLayouts>
    </AcpUINS:AcpXamDataPresenter>
  </Grid>
</UclMDCCallHotListTblView>