<UserControl x:Class="AcpUI.AcpTextBoxSpinner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:AcpUINS="clr-namespace:AcpUI"
             xmlns:AcpCommonResources="clr-namespace:AcpCommonResources;assembly=AcpCommonResources"
             xmlns:igEditors="http://infragistics.com/Editors"
             xmlns:AcpUICommonNS="clr-namespace:AcpUI.Common">
  <FrameworkElement.Resources>
    <AcpUICommonNS:EditabilityToOpacityConverter x:Key="editabilityToOpacity"/>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition/>
      <RowDefinition/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="5*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <AcpUINS:AcpTextBox x:Name="AcpTextBoxMember" LostFocus="OnLostFocus" PreviewKeyDown="OnKeyPressUpDownEvent"
                        Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                        MaskType="{Binding Path=MaskTypeSpinner, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type AcpUINS:AcpTextBoxSpinner}}}"
                        Text="{Binding Path=Text, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type AcpUINS:AcpTextBoxSpinner}}}"
                        IsAcpValid="{Binding Path=IsAcpValid, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type AcpUINS:AcpTextBoxSpinner}}}"
                        IsAcpApplicable="{Binding Path=IsAcpApplicable, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type AcpUINS:AcpTextBoxSpinner}}}"
                        IsAcpEditable="{Binding Path=IsAcpEditable, Mode=TwoWay, RelativeSource={RelativeSource AncestorType={x:Type AcpUINS:AcpTextBoxSpinner}}}">
    </AcpUINS:AcpTextBox>
    <RepeatButton Click="OnClick" x:Name="UpClick" Grid.Column="1" Height="11.63833333333335" Width="20" Delay="500"
                  Interval="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                  ToolTip="{x:Static AcpCommonResources:AcpResources.Increment_Id}">
      <Image Source="icons/SpinnerArrowUp.png"
             Opacity="{Binding ElementName=UpClick, Path=IsEnabled, Converter={StaticResource editabilityToOpacity}, Mode=Oneway}"/>
    </RepeatButton>
    <RepeatButton Click="OnClick" x:Name="DownClick" Grid.Row="1" Grid.Column="1" Height="11.63833333333335"
                  Width="20" Delay="500" Interval="10" HorizontalAlignment="Right"
                  ToolTip="{x:Static AcpCommonResources:AcpResources.Decrement_Id}">
      <Image Source="icons/SpinnerArrowDown.png"
             Opacity="{Binding ElementName=DownClick, Path=IsEnabled, Converter={StaticResource editabilityToOpacity}, Mode=Oneway}"/>
    </RepeatButton>
  </Grid>
</UserControl>