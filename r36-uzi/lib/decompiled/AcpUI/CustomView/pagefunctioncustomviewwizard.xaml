<AcpUICustomViewNS:PageFunctionCustomViewWizardBase x:Class="AcpUI.CustomView.PageFunctionCustomViewWizard"
                                                    xmlns:z="clr-namespace:AcpUI.CustomView"
                                                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                                                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                                                    xmlns:AcpUINS="clr-namespace:AcpUI"
                                                    xmlns:AcpCommonResources="clr-namespace:AcpCommonResources;assembly=AcpCommonResources"
                                                    xmlns:AcpUICustomViewNS="clr-namespace:AcpUI.CustomView"
                                                    Title="{x:Static AcpCommonResources:AcpResources.Create_Custom_View_File_Wizard}" Height="160"
                                                    Width="600">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="25*"/>
        <ColumnDefinition Width="25*"/>
        <ColumnDefinition Width="10*"/>
      </Grid.ColumnDefinitions>
    </Grid>
    <GroupBox Grid.Row="1" Margin="10,10,10,10">
      <HeaderedContentControl.Header>
        <Label Content="{x:Static AcpCommonResources:AcpResources.Choose_Baseline_View}"/>
      </HeaderedContentControl.Header>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition/>
          <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="25*"/>
          <ColumnDefinition Width="25*"/>
          <ColumnDefinition Width="15*"/>
        </Grid.ColumnDefinitions>
        <RadioButton Checked="OnRadBtnCheck" Name="RadBtnPreDefinedView" Grid.Row="0" Grid.Column="0" Margin="0,7,0,0"
                     Height="30">
          <TextBlock TextWrapping="Wrap" Text="{x:Static AcpCommonResources:AcpResources.Use_Predefined_View}"/>
        </RadioButton>
        <AcpUINS:AcpComboBox x:Name="CmbBoxPreDefinedView" Grid.Row="0" Grid.Column="1" Height="24" SelectedIndex="0">
          <ComboBoxItem Content="{x:Static AcpCommonResources:AcpResources.Basic_View}"/>
          <ComboBoxItem Content="{x:Static AcpCommonResources:AcpResources.Intermediate_View}"/>
          <ComboBoxItem Content="{x:Static AcpCommonResources:AcpResources.Full_View}"/>
          <ComboBoxItem Content="{x:Static AcpCommonResources:AcpResources.Expert_View}"/>
        </AcpUINS:AcpComboBox>
        <RadioButton Checked="OnRadBtnCheck" Name="RadBtnCustomView" Grid.Row="1" Grid.Column="0" Margin="0,7,0,0"
                     Height="30">
          <TextBlock TextWrapping="Wrap" Text="{x:Static AcpCommonResources:AcpResources.Use_Existing_Custom_View}"/>
        </RadioButton>
        <AcpUINS:AcpTextBox x:Name="TxtBoxCustomView" Grid.Row="1" Grid.Column="1" Height="24">
        </AcpUINS:AcpTextBox>
        <AcpUINS:AcpButton x:Name="BtnCustomView" Click="OnBrowse" Grid.Row="1" Grid.Column="2" Height="24" Width="125 "
                           Content="{x:Static AcpCommonResources:AcpResources.Browse_Id}"/>
      </Grid>
    </GroupBox>
    <Grid Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="25*"/>
        <ColumnDefinition Width="25*"/>
      </Grid.ColumnDefinitions>
      <AcpUINS:AcpButton Click="OnOK" Grid.Column="1" IsDefault="True" HorizontalAlignment="Left" Margin="20,0,0,2"
                         Width="125" Height="24" Content="{x:Static AcpCommonResources:AcpResources.OK_Id}"/>
      <AcpUINS:AcpButton Grid.Column="1" IsCancel="True" HorizontalAlignment="Right" Margin="0,0,19,2" Width="125"
                         Height="24" Content="{x:Static AcpCommonResources:AcpResources.Cancel_Id}"/>
    </Grid>
  </Grid>
</AcpUICustomViewNS:PageFunctionCustomViewWizardBase>