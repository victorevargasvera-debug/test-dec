<Page x:Class="AcpUI.Common.PageFieldsReport"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:AcpCommonResources="clr-namespace:AcpCommonResources;assembly=AcpCommonResources"
      xmlns:AcpUICommonNS="clr-namespace:AcpUI.Common"
      xmlns:AcpUIStylesNS="clr-namespace:AcpUI.Styles"
      Height="Auto" Width="Auto">
  <FrameworkElement.Resources>
    <AcpUIStylesNS:ListViewItemStyleSelector x:Key="ListViewItemStyleSelector"/>
    <AcpUICommonNS:FieldValueBase64ToStringConverter x:Key="FieldValueBase64ToStringConverter"/>
  </FrameworkElement.Resources>
  <DockPanel>
    <ListView Name="myListView" DockPanel.Dock="Top" ScrollViewer.CanContentScroll="True"
              ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
              Grid.Row="1" IsSynchronizedWithCurrentItem="true" Width="Auto" Background="Transparent"
              ItemsSource="{Binding}">
      <ListView.View>
        <GridView x:Name="FieldsReportGV">
          <GridView.Columns>
            <GridViewColumn x:Name="FieldsReportGVC1" Header="{x:Static AcpCommonResources:AcpResources.Location_Id}"
                            Width="Auto" DisplayMemberBinding="{Binding Path}"/>
            <GridViewColumn x:Name="FieldsReportGVC2" Header="{x:Static AcpCommonResources:AcpResources.Field_Id}" Width="Auto"
                            DisplayMemberBinding="{Binding Name}"/>
            <GridViewColumn x:Name="FieldsReportGVC3" Header="{x:Static AcpCommonResources:AcpResources.Field_Value}"
                            Width="Auto">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock>
                    <TextBlock.Text>
                      <MultiBinding Converter="{StaticResource FieldValueBase64ToStringConverter}">
                        <Binding Path="FieldValue"/>
                        <Binding Path="Name"/>
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn x:Name="FieldsReportGVC4"
                            Header="{x:Static AcpCommonResources:AcpResources.Comparison_Field_Value}" Width="Auto">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock>
                    <TextBlock.Text>
                      <MultiBinding Converter="{StaticResource FieldValueBase64ToStringConverter}">
                        <Binding Path="Message"/>
                        <Binding Path="Name"/>
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
          </GridView.Columns>
        </GridView>
      </ListView.View>
    </ListView>
  </DockPanel>
</Page>