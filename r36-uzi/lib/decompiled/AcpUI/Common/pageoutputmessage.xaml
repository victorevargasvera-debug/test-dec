<Page x:Class="AcpUI.Common.PageOutputMessage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:AcpUIStylesNS="clr-namespace:AcpUI.Styles"
      xmlns:AcpCommonResources="clr-namespace:AcpCommonResources;assembly=AcpCommonResources"
      Title="PageStatusMessage">
  <FrameworkElement.Resources>
    <AcpUIStylesNS:ListViewItemStyleSelector x:Key="ListViewItemStyleSelector"/>
    <DataTemplate x:Key="CellTemplateIcon">
      <DockPanel>
        <Image Width="16" Height="16" Source="{Binding Path=ImageLink}"/>
      </DockPanel>
    </DataTemplate>
  </FrameworkElement.Resources>
  <DockPanel>
    <ListView Name="myListView" DockPanel.Dock="Top" ScrollViewer.CanContentScroll="True"
              ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
              Grid.Row="1" IsSynchronizedWithCurrentItem="true" Width="Auto" Background="Transparent"
              ItemsSource="{Binding}">
      <ListView.View>
        <GridView x:Name="StatusMessageGrid">
          <GridView.Columns>
            <GridViewColumn x:Name="MsgIcon" Header="{x:Static AcpCommonResources:AcpResources.Icon_Id}" Width="Auto"
                            CellTemplate="{StaticResource CellTemplateIcon}"/>
            <GridViewColumn x:Name="MsgType" Header="{x:Static AcpCommonResources:AcpResources.Type_Id}" Width="Auto"
                            DisplayMemberBinding="{Binding Type}"/>
            <GridViewColumn x:Name="Message" Header="{x:Static AcpCommonResources:AcpResources.Message_Description}"
                            Width="Auto" DisplayMemberBinding="{Binding Message}"/>
          </GridView.Columns>
        </GridView>
      </ListView.View>
    </ListView>
  </DockPanel>
</Page>