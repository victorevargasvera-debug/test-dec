<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dc="clr-namespace:DevComponents.WpfDock">
  <Style TargetType="{x:Type dc:DockSplitter}">
    <Style.Triggers>
      <Trigger Property="dc:DockSplitter.Orientation" Value="Horizontal">
        <Setter Property="FrameworkElement.MinWidth" Value="0"/>
        <Setter Property="FrameworkElement.MinHeight" Value="4"/>
        <Setter Property="FrameworkElement.Cursor" Value="SizeNS"/>
      </Trigger>
    </Style.Triggers>
    <Setter Property="Control.Background"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockSplitterNormalBackground}}}"/>
    <Setter Property="FrameworkElement.MinWidth" Value="4"/>
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True"/>
    <Setter Property="FrameworkElement.Cursor" Value="SizeWE"/>
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type dc:DockSplitter}">
          <Border Name="PART_SplitterBorder" Margin="{TemplateBinding Control.Padding}"
                  Background="{TemplateBinding Control.Background}"
                  BorderBrush="{TemplateBinding Control.BorderBrush}"
                  BorderThickness="{TemplateBinding Control.BorderThickness}" SnapsToDevicePixels="True"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>