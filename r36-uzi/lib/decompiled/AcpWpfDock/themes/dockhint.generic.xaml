<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dc="clr-namespace:DevComponents.WpfDock"
                    xmlns:dcp="clr-namespace:DevComponents.WpfDock.Primitives">
  <Style TargetType="{x:Type dc:DockHint}">
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True"/>
    <Setter Property="UIElement.Focusable" Value="False"/>
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Name="HintBorder" Background="Transparent" BorderThickness="0"
                  SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"
                  BorderBrush="{DynamicResource {ComponentResourceKey ResourceId=DockHintBorder, TypeInTargetAssembly=dc:DockSite}}">
            <Image Name="HintImage" Source="SysImages/DockHintTop.png" Width="29" Height="31"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="dc:DockHint.DockHintSide" Value="Bottom">
              <Setter TargetName="HintImage" Property="Image.Source" Value="SysImages/DockHintBottom.png"/>
            </Trigger>
            <Trigger Property="dc:DockHint.DockHintSide" Value="Left">
              <Setter TargetName="HintImage" Property="Image.Source" Value="SysImages/DockHintLeft.png"/>
              <Setter TargetName="HintImage" Property="FrameworkElement.Width" Value="31"/>
              <Setter TargetName="HintImage" Property="FrameworkElement.Height" Value="29"/>
            </Trigger>
            <Trigger Property="dc:DockHint.DockHintSide" Value="Right">
              <Setter TargetName="HintImage" Property="Image.Source" Value="SysImages/DockHintRight.png"/>
              <Setter TargetName="HintImage" Property="FrameworkElement.Width" Value="31"/>
              <Setter TargetName="HintImage" Property="FrameworkElement.Height" Value="29"/>
            </Trigger>
            <Trigger Property="dc:DockHint.DockHintSide" Value="AllSides">
              <Setter TargetName="HintImage" Property="Image.Source" Value="SysImages/DockHintAllSides.png"/>
              <Setter TargetName="HintImage" Property="FrameworkElement.Width" Value="88"/>
              <Setter TargetName="HintImage" Property="FrameworkElement.Height" Value="88"/>
            </Trigger>
            <Trigger Property="dc:DockHint.DockHintSide" Value="AllSidesAndCenter">
              <Setter TargetName="HintImage" Property="Image.Source" Value="SysImages/DockHintTab.png"/>
              <Setter TargetName="HintImage" Property="FrameworkElement.Width" Value="88"/>
              <Setter TargetName="HintImage" Property="FrameworkElement.Height" Value="88"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>