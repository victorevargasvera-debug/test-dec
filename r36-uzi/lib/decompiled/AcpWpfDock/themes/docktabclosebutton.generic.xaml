<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:dc="clr-namespace:DevComponents.WpfDock"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style TargetType="{x:Type dc:DockTabCloseButton}">
    <Setter Property="Control.Background"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockTabCloseButtonInactiveBackground}}}"/>
    <Setter Property="Control.BorderBrush"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockTabCloseButtonInactiveBorder}}}"/>
    <Setter Property="Control.Foreground"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockTabCloseButtonInactiveForeground}}}"/>
    <Setter Property="Control.BorderThickness" Value="1"/>
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True"/>
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type dc:DockTabCloseButton}">
          <Border Background="{TemplateBinding Control.Background}"
                  BorderBrush="{TemplateBinding Control.BorderBrush}" CornerRadius="2"
                  BorderThickness="{TemplateBinding Control.BorderThickness}">
            <Border Name="BH" BorderThickness="1" CornerRadius="2" Padding="2"
                    BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockTabCloseButtonInactiveBorderInner}}}">
              <Canvas Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Line X1="0" Y1="0" X2="6" Y2="6" Stroke="{TemplateBinding Control.Foreground}" StrokeThickness="1.2"/>
                <Line X1="0" Y1="6" X2="6" Y2="0" Stroke="{TemplateBinding Control.Foreground}" StrokeThickness="1.2"/>
              </Canvas>
            </Border>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="dc:DockTabCloseButton.IsActive" Value="True">
              <Setter Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockTabCloseButtonActiveBackground}}}"
                      Property="Control.Background"/>
              <Setter Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockTabCloseButtonActiveBorder}}}"
                      Property="Control.BorderBrush"/>
              <Setter TargetName="BH"
                      Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockTabCloseButtonActiveBorderInner}}}"
                      Property="Border.BorderBrush"/>
              <Setter Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockTabCloseButtonActiveForeground}}}"
                      Property="Control.Foreground"/>
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockTabCloseButtonHoverBackground}}}"
                      Property="Control.Background"/>
              <Setter Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockTabCloseButtonHoverBorder}}}"
                      Property="Control.BorderBrush"/>
              <Setter TargetName="BH"
                      Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockTabCloseButtonHoverBorderInner}}}"
                      Property="Border.BorderBrush"/>
              <Setter Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockTabCloseButtonHoverForeground}}}"
                      Property="Control.Foreground"/>
            </Trigger>
            <Trigger Property="ButtonBase.IsPressed" Value="True">
              <Setter Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockTabCloseButtonPressedBackground}}}"
                      Property="Control.Background"/>
              <Setter Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockTabCloseButtonPressedBorder}}}"
                      Property="Control.BorderBrush"/>
              <Setter TargetName="BH"
                      Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockTabCloseButtonPressedBorderInner}}}"
                      Property="Border.BorderBrush"/>
              <Setter Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockTabCloseButtonPressedForeground}}}"
                      Property="Control.Foreground"/>
            </Trigger>
            <Trigger Property="UIElement.IsEnabled" Value="False">
              <Setter Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockTabCloseButtonDisabledBackground}}}"
                      Property="Control.Background"/>
              <Setter Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockTabCloseButtonDisabledBorder}}}"
                      Property="Control.BorderBrush"/>
              <Setter TargetName="BH"
                      Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockTabCloseButtonDisabledBorderInner}}}"
                      Property="Border.BorderBrush"/>
              <Setter Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockTabCloseButtonDisabledForeground}}}"
                      Property="Control.Foreground"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>