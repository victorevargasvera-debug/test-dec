<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dcc="clr-namespace:DevComponents.WpfDock.Converters"
                    xmlns:dc="clr-namespace:DevComponents.WpfDock"
                    xmlns:AcpCommonResources="clr-namespace:AcpCommonResources;assembly=AcpCommonResources"
                    xmlns:dcp="clr-namespace:DevComponents.WpfDock.Primitives">
  <dcc:IsStringTypeConverter x:Key="IsStringTypeConverter"/>
  <ControlTemplate x:Key="{ComponentResourceKey {x:Type dc:DockWindowGroup}, ToolDock}">
    <Border Name="InnerContent">
      <DockPanel LastChildFill="True" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}">
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockTabPanelBackground}}}">
          <dcp:DockTabPanel Name="PART_TabPanel" IsItemsHost="True"
                            Visibility="{TemplateBinding dc:DockWindowGroup.TabVisibility}" KeyboardNavigation.TabIndex="1"
                            Margin="0,0,0,2" KeyboardNavigation.DirectionalNavigation="Cycle"
                            BackgroundInner="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockTabPanelInnerBackground}}}"
                            BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockTabSelectedBorder}}}"
                            BorderInnerBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockTabSelectedBorderInner}}}"
                            ContextMenu="{Binding ElementName=OptionsMenu}"/>
        </Border>
        <Border Background="{TemplateBinding Control.Background}"
                BorderBrush="{TemplateBinding Control.BorderBrush}"
                BorderThickness="{TemplateBinding Control.BorderThickness}"
                SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" Padding="1">
          <DockPanel LastChildFill="True" ClipToBounds="True" KeyboardNavigation.TabNavigation="None"
                     SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}">
            <Border Name="PART_GroupCaption" DockPanel.Dock="Top"
                    Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockCaptionInactiveBackground}}}"
                    TextBlock.Foreground="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockCaptionInactiveForeground}}}">
              <DockPanel Name="CaptionDockPanel" LastChildFill="True">
                <FrameworkElement.ContextMenu>
                  <ContextMenu Name="OptionsMenu">
                    <MenuItem Name="MenuOptionFloating" Header="{x:Static AcpCommonResources:AcpResources.Floating_Id}"
                              Command="dc:DockWindow.FloatWindow"
                              CommandTarget="{TemplateBinding dc:DockWindowGroup.SelectedDockWindow}"/>
                    <MenuItem Name="MenuOptionDockable" Header="{x:Static AcpCommonResources:AcpResources.Dockable_Id}"
                              Command="dc:DockWindow.ReDockWindow"
                              CommandTarget="{TemplateBinding dc:DockWindowGroup.SelectedDockWindow}"/>
                    <MenuItem Name="MenuOptionTabbedDoc" Header="{x:Static AcpCommonResources:AcpResources.Tabbed_Document}"
                              Command="dc:DockWindow.DockAsDocumentWindow"
                              CommandTarget="{TemplateBinding dc:DockWindowGroup.SelectedDockWindow}"/>
                    <MenuItem Name="MenuOptionAutoHide" Header="{x:Static AcpCommonResources:AcpResources.Auto_Hide}"
                              Command="dc:DockWindow.ToggleAutoHide"
                              CommandTarget="{TemplateBinding dc:DockWindowGroup.SelectedDockWindow}"/>
                    <MenuItem Name="MenuOptionHide" Header="{x:Static AcpCommonResources:AcpResources.Hide_Id}"
                              Command="dc:DockWindow.CloseWindow"
                              CommandTarget="{TemplateBinding dc:DockWindowGroup.SelectedDockWindow}"/>
                  </ContextMenu>
                </FrameworkElement.ContextMenu>
                <Button Name="CloseButton" Command="dc:DockWindow.CloseWindow"
                        CommandTarget="{TemplateBinding dc:DockWindowGroup.SelectedDockWindow}" DockPanel.Dock="Right"
                        VerticalAlignment="Center"
                        Style="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId=DockButton}}">
                  <Canvas Width="8" Height="7">
                    <Line X1="0" Y1="0" X2="8" Y2="7" StrokeThickness="1.2"
                          Stroke="{Binding Path=Foreground, ElementName=CloseButton}"/>
                    <Line X1="0" Y1="7" X2="8" Y2="0" StrokeThickness="1.2"
                          Stroke="{Binding Path=Foreground, ElementName=CloseButton}"/>
                  </Canvas>
                </Button>
                <Button Name="AutoHideButton" Command="dc:DockWindow.ToggleAutoHide"
                        CommandTarget="{TemplateBinding dc:DockWindowGroup.SelectedDockWindow}" DockPanel.Dock="Right"
                        VerticalAlignment="Center"
                        Style="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId=DockButton}}">
                  <Grid>
                    <Canvas Name="AutoHideStateIn" Width="7" Height="10" VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                      <Rectangle Canvas.Left="1" Canvas.Top="0" Width="5" Height="7" StrokeThickness="1"
                                 Stroke="{Binding Path=Foreground, ElementName=AutoHideButton}"/>
                      <Line X1="5" Y1="1" X2="5" Y2="6" StrokeThickness="1" Opacity=".7"
                            Stroke="{Binding Path=Foreground, ElementName=AutoHideButton}"/>
                      <Line X1="0" Y1="7" X2="7" Y2="7" StrokeThickness="1"
                            Stroke="{Binding Path=Foreground, ElementName=AutoHideButton}"/>
                      <Line X1="4" Y1="7" X2="4" Y2="10" StrokeThickness="1"
                            Stroke="{Binding Path=Foreground, ElementName=AutoHideButton}"/>
                    </Canvas>
                    <Canvas Name="AutoHideStateOut" Width="10" Height="7" VerticalAlignment="Center"
                            HorizontalAlignment="Center" Visibility="Collapsed">
                      <Rectangle Canvas.Left="4" Canvas.Top="1" Width="7" Height="5" StrokeThickness="1"
                                 Stroke="{Binding Path=Foreground, ElementName=AutoHideButton}"/>
                      <Line X1="5" Y1="4" X2="10" Y2="4" StrokeThickness="1" Opacity=".7"
                            Stroke="{Binding Path=Foreground, ElementName=AutoHideButton}"/>
                      <Line X1="4" Y1="0" X2="4" Y2="7" StrokeThickness="1"
                            Stroke="{Binding Path=Foreground, ElementName=AutoHideButton}"/>
                      <Line X1="0" Y1="3" X2="4" Y2="3" StrokeThickness="1"
                            Stroke="{Binding Path=Foreground, ElementName=AutoHideButton}"/>
                    </Canvas>
                  </Grid>
                </Button>
                <Button Name="OptionsButton" DockPanel.Dock="Right" VerticalAlignment="Center"
                        Visibility="{TemplateBinding dc:DockWindowGroup.OptionsMenu}"
                        Style="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId=DockButton}}">
                  <Path Margin="2,4,2,4" Data="M 0,0 L 8,0 4,3.5 Z" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Fill="{Binding Path=Foreground, ElementName=OptionsButton}"/>
                </Button>
                <ContentPresenter Name="PART_HeaderContentHost" ContentSource="SelectedContentHeader"
                                  SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center" Margin="2,0,0,0"
                                  Content="{TemplateBinding dc:DockWindowGroup.SelectedContentHeader}"/>
              </DockPanel>
            </Border>
            <ContentPresenter Name="PART_TabContentHost" ContentSource="SelectedContent" Focusable="True"
                              KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle"
                              SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"
                              ContentTemplate="{TemplateBinding dc:DockWindowGroup.SelectedContentTemplate}"
                              Content="{TemplateBinding dc:DockWindowGroup.SelectedContent}"/>
          </DockPanel>
        </Border>
      </DockPanel>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="UIElement.IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="PART_GroupCaption"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockCaptionActiveBackground}}}"
                Property="Border.Background"/>
        <Setter TargetName="PART_GroupCaption"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockCaptionActiveForeground}}}"
                Property="TextBlock.Foreground"/>
      </Trigger>
      <Trigger Property="dc:DockWindowGroup.IsFloating" Value="True">
        <Setter TargetName="PART_GroupCaption" Property="UIElement.Visibility" Value="Collapsed"/>
      </Trigger>
      <Trigger Property="dc:DockSite.IsDocument" Value="True">
        <Setter TargetName="PART_TabPanel" Property="DockPanel.Dock" Value="Top"/>
      </Trigger>
      <Trigger Property="dc:DockWindowGroup.CanClose" Value="False">
        <Setter TargetName="CloseButton" Property="UIElement.Visibility" Value="Collapsed"/>
      </Trigger>
      <Trigger Property="dc:DockWindowGroup.CanAutoHide" Value="False">
        <Setter TargetName="AutoHideButton" Property="UIElement.Visibility" Value="Collapsed"/>
      </Trigger>
      <Trigger Property="dc:DockWindowGroup.TabVisibility" Value="Collapsed">
        <Setter Property="Control.BorderThickness" Value="1"/>
      </Trigger>
      <Trigger Property="dc:DockWindowGroup.IsAutoHide" Value="True">
        <Setter TargetName="AutoHideStateIn" Property="UIElement.Visibility" Value="Collapsed"/>
        <Setter TargetName="AutoHideStateOut" Property="UIElement.Visibility" Value="Visible"/>
      </Trigger>
      <Trigger Property="dc:DockWindowGroup.OptionsMenu" Value="Collapsed">
        <Setter TargetName="PART_TabPanel" Property="ContextMenuService.IsEnabled" Value="False"/>
        <Setter TargetName="CaptionDockPanel" Property="ContextMenuService.IsEnabled" Value="False"/>
      </Trigger>
      <DataTrigger Value="true"
                   Binding="{Binding RelativeSource={RelativeSource self}, Path=(dc:DockWindowGroup.SelectedContentHeader), Converter={StaticResource IsStringTypeConverter}}">
        <Setter TargetName="PART_HeaderContentHost" Property="ContentPresenter.ContentTemplate">
          <Setter.Value>
            <DataTemplate>
              <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding}"/>
            </DataTemplate>
          </Setter.Value>
        </Setter>
      </DataTrigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <ControlTemplate x:Key="{ComponentResourceKey {x:Type dc:DockWindowGroup}, DocumentDock}">
    <DockPanel Name="PART_DockBackground" LastChildFill="True"
               SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"
               Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DocumentTabPanelBackground}}}">
      <DockPanel LastChildFill="True" Dock="Top" ClipToBounds="True" KeyboardNavigation.TabNavigation="None"
                 SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}">
        <Border DockPanel.Dock="Bottom" Height="4" BorderThickness="0,1,0,0" Margin="0,-1,0,0"
                Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DocumentTabPanelInnerBackground}}}"
                BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DocumentTabSelectedBorder}}}"/>
        <Button Name="CloseButton" Command="dc:DockWindow.CloseWindow"
                CommandTarget="{TemplateBinding dc:DockWindowGroup.SelectedDockWindow}" DockPanel.Dock="Right"
                VerticalAlignment="Center"
                Style="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId=DockButton}}">
          <Canvas Width="8" Height="7">
            <Line X1="0" Y1="0" X2="8" Y2="7" StrokeThickness="1.2"
                  Stroke="{Binding Foreground, ElementName=CloseButton}"/>
            <Line X1="0" Y1="7" X2="8" Y2="0" StrokeThickness="1.2"
                  Stroke="{Binding Foreground, ElementName=CloseButton}"/>
          </Canvas>
        </Button>
        <Button Name="OptionsButton" DockPanel.Dock="Right" VerticalAlignment="Center"
                Visibility="{TemplateBinding dc:DockWindowGroup.OptionsMenu}"
                Style="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId=DockButton}}">
          <FrameworkElement.ContextMenu>
            <ContextMenu Name="WindowList"/>
          </FrameworkElement.ContextMenu>
          <Path Margin="2,4,2,4" Data="M 0,0 L 8,0 4,3.5 Z" VerticalAlignment="Center" HorizontalAlignment="Center"
                Fill="{Binding Path=Foreground, ElementName=OptionsButton}"/>
        </Button>
        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" CanContentScroll="True"
                      Focusable="False">
          <StackPanel Name="PART_TabPanel" Margin="2,2,0,0" Orientation="Horizontal" IsItemsHost="True"
                      ClipToBounds="True" KeyboardNavigation.TabIndex="1"
                      KeyboardNavigation.DirectionalNavigation="Cycle">
            <FrameworkElement.ContextMenu>
              <ContextMenu Name="OptionsMenu">
                <MenuItem Name="MenuOptionFloating" Header="{x:Static AcpCommonResources:AcpResources.Floating_Id}"
                          Command="dc:DockWindow.FloatWindow"
                          CommandTarget="{TemplateBinding dc:DockWindowGroup.SelectedDockWindow}"/>
                <MenuItem Name="MenuOptionDockable" Header="{x:Static AcpCommonResources:AcpResources.Dockable_Id}"
                          Command="dc:DockWindow.ReDockWindow"
                          CommandTarget="{TemplateBinding dc:DockWindowGroup.SelectedDockWindow}"/>
                <MenuItem Name="MenuOptionTabbedDoc" Header="{x:Static AcpCommonResources:AcpResources.Tabbed_Document}"
                          Command="dc:DockWindow.DockAsDocumentWindow"
                          CommandTarget="{TemplateBinding dc:DockWindowGroup.SelectedDockWindow}"/>
                <MenuItem Name="MenuOptionHide" Header="{x:Static AcpCommonResources:AcpResources.Hide_Id}"
                          Command="dc:DockWindow.CloseWindow"
                          CommandTarget="{TemplateBinding dc:DockWindowGroup.SelectedDockWindow}"/>
              </ContextMenu>
            </FrameworkElement.ContextMenu>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
      <ContentPresenter Name="PART_TabContentHost" ContentSource="SelectedContent"
                        SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"
                        ContentTemplate="{TemplateBinding dc:DockWindowGroup.SelectedContentTemplate}"
                        Content="{TemplateBinding dc:DockWindowGroup.SelectedContent}"/>
    </DockPanel>
    <ControlTemplate.Triggers>
      <Trigger Property="dc:DockWindowGroup.CanClose" Value="False">
        <Setter TargetName="CloseButton" Property="UIElement.Visibility" Value="Hidden"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style TargetType="{x:Type dc:DockWindowGroup}">
    <Style.Triggers>
      <Trigger Property="dc:DockSite.IsDocument" Value="False">
        <Setter Property="Control.Template"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockWindowGroup, ResourceId=ToolDock}}"/>
      </Trigger>
      <Trigger Property="dc:DockSite.IsDocument" Value="True">
        <Setter Property="Control.Template"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockWindowGroup, ResourceId=DocumentDock}}"/>
      </Trigger>
    </Style.Triggers>
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True"/>
    <Setter Property="UIElement.Focusable" Value="False"/>
    <Setter Property="Control.Background"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockGroupBackground}}}"/>
    <Setter Property="Control.BorderBrush"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockGroupBorder}}}"/>
    <Setter Property="Control.BorderThickness" Value="1,1,1,0"/>
  </Style>
</ResourceDictionary>