<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dc="clr-namespace:DevComponents.WpfDock">
  <Style TargetType="{x:Type dc:DockWindowInfo}">
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True"/>
    <Setter Property="Control.BorderThickness" Value="1"/>
    <Setter Property="Control.BorderBrush" Value="Transparent"/>
    <Setter Property="Control.Padding" Value="1"/>
    <Setter Property="FrameworkElement.Cursor" Value="Hand"/>
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type dc:DockWindowInfo}">
          <Border Background="{TemplateBinding Control.Background}"
                  BorderBrush="{TemplateBinding Control.BorderBrush}"
                  BorderThickness="{TemplateBinding Control.BorderThickness}" SnapsToDevicePixels="True">
            <DockPanel LastChildFill="True" Margin="{TemplateBinding Control.Padding}">
              <ContentPresenter Name="TabImage" ContentSource="Image" Margin="1" DockPanel.Dock="Left" VerticalAlignment="Center"
                                SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"
                                Content="{TemplateBinding dc:DockWindowInfo.Image}"/>
              <ContentPresenter Name="PART_HeaderContentHost" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"
                                VerticalAlignment="Center" Content="{TemplateBinding dc:DockWindowInfo.Header}">
                <ContentPresenter.ContentTemplate>
                  <DataTemplate>
                    <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding}"/>
                  </DataTemplate>
                </ContentPresenter.ContentTemplate>
              </ContentPresenter>
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="dc:DockWindowInfo.IsSelected" Value="True">
              <Setter Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockWindowInfoBackground}}}"
                      Property="Control.Background"/>
              <Setter Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockWindowInfoBorder}}}"
                      Property="Control.BorderBrush"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>