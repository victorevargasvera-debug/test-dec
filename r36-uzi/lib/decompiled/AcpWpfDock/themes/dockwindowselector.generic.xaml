<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dc="clr-namespace:DevComponents.WpfDock">
  <Style TargetType="{x:Type dc:DockWindowSelector}">
    <Setter Property="Control.Background"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockSelectorBackground}}}"/>
    <Setter Property="Control.BorderBrush"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:DockSite, ResourceId={x:Static dc:DockColors.DockSelectorBorder}}}"/>
    <Setter Property="Control.BorderThickness" Value="1"/>
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True"/>
    <Setter Property="FrameworkElement.HorizontalAlignment" Value="Center"/>
    <Setter Property="FrameworkElement.VerticalAlignment" Value="Center"/>
    <Setter Property="Control.Padding" Value="9,12,9,12"/>
    <Setter Property="Selector.IsSynchronizedWithCurrentItem" Value="True"/>
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type dc:DockWindowSelector}">
          <Border Margin="0" Background="{TemplateBinding Control.Background}"
                  BorderBrush="{TemplateBinding Control.BorderBrush}"
                  BorderThickness="{TemplateBinding Control.BorderThickness}" SnapsToDevicePixels="True">
            <Grid Margin="{TemplateBinding Control.Padding}" SnapsToDevicePixels="True">
              <Grid.ColumnDefinitions>
                <ColumnDefinition MinWidth="180"/>
                <ColumnDefinition MinWidth="180"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
              </Grid.RowDefinitions>
              <TextBlock Grid.Column="0" Grid.Row="0" TextWrapping="NoWrap"
                         Text="{TemplateBinding dc:DockWindowSelector.ActiveToolWindowsLabel}" Margin="0,0,0,4"
                         FontWeight="Bold"/>
              <TextBlock Grid.Column="1" Grid.Row="0" TextWrapping="NoWrap"
                         Text="{TemplateBinding dc:DockWindowSelector.ActiveFilesLabel}" Margin="10,0,0,4" FontWeight="Bold"/>
              <ItemsControl x:Name="PART_ToolWindowsList" Grid.Column="0" Grid.Row="1"
                            ItemsSource="{Binding Path=ToolWindows, RelativeSource={RelativeSource TemplatedParent}}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Vertical" ItemWidth="180" MaxHeight="320"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
              <WrapPanel Grid.Column="1" Grid.Row="1" Orientation="Vertical" IsItemsHost="True" ItemWidth="180"
                         Margin="10,0,0,0" MaxHeight="320"/>
              <Border Margin="0,10,0,0" Grid.ColumnSpan="2" Grid.Column="0" Grid.Row="2"
                      BorderBrush="{TemplateBinding Control.BorderBrush}"
                      BorderThickness="{TemplateBinding Control.BorderThickness}" SnapsToDevicePixels="True">
                <StackPanel Orientation="Vertical" Margin="12">
                  <ContentPresenter SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" VerticalAlignment="Center"
                                    Content="{TemplateBinding dc:DockWindowSelector.SelectedHeader}">
                    <ContentPresenter.ContentTemplate>
                      <DataTemplate>
                        <Grid>
                          <TextBlock FontWeight="Bold" TextTrimming="CharacterEllipsis" Text="{Binding}"/>
                        </Grid>
                      </DataTemplate>
                    </ContentPresenter.ContentTemplate>
                  </ContentPresenter>
                  <TextBlock TextWrapping="Wrap" Text="{TemplateBinding dc:DockWindowSelector.SelectedDescription}"/>
                </StackPanel>
              </Border>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>