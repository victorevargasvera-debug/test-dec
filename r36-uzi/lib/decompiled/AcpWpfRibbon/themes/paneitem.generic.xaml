<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dcc="clr-namespace:DevComponents.WpfRibbon.Converters"
                    xmlns:dc="clr-namespace:DevComponents.WpfRibbon">
  <dcc:IsStringTypeConverter x:Key="IsStringTypeConverter"/>
  <Style TargetType="{x:Type dc:PaneItem}">
    <Style.Triggers>
      <Trigger Property="dc:PaneItem.SmallState" Value="True">
        <Setter Property="Control.Template">
          <Setter.Value>
            <ControlTemplate>
              <Border Name="ItemBorder" Padding="{TemplateBinding Control.Padding}" Cursor="Hand"
                      Background="Transparent">
                <Grid>
                  <ContentPresenter Name="PaneImageSmallPresenter" ContentSource="ImageSmall" Margin="1" VerticalAlignment="Center"
                                    SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"
                                    Content="{TemplateBinding dc:PaneItem.ImageSmall}"/>
                  <ContentPresenter Name="PaneImagePresenter" ContentSource="Image" Margin="1" VerticalAlignment="Center"
                                    SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" Visibility="Collapsed"
                                    Width="16" Height="16" Content="{TemplateBinding dc:PaneItem.Image}"/>
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Value="{x:Null}" Property="dc:PaneItem.ImageSmall">
                  <Setter TargetName="PaneImageSmallPresenter" Property="UIElement.Visibility" Value="Collapsed"/>
                  <Setter TargetName="PaneImagePresenter" Property="UIElement.Visibility" Value="Visible"/>
                </Trigger>
                <Trigger SourceName="ItemBorder" Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="ItemBorder"
                          Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemMouseOverBackground}}}"
                          Property="Border.Background"/>
                </Trigger>
                <MultiTrigger>
                  <MultiTrigger.Conditions>
                    <Condition Property="UIElement.IsMouseCaptured" Value="True"/>
                    <Condition Property="UIElement.IsMouseOver" Value="True"/>
                  </MultiTrigger.Conditions>
                  <Setter TargetName="ItemBorder"
                          Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemMouseDownBackground}}}"
                          Property="Border.Background"/>
                </MultiTrigger>
                <Trigger Property="dc:PaneItem.IsSelected" Value="True">
                  <Setter TargetName="ItemBorder"
                          Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemSelectedBackground}}}"
                          Property="Border.Background"/>
                </Trigger>
                <MultiTrigger>
                  <MultiTrigger.Conditions>
                    <Condition Property="dc:PaneItem.IsSelected" Value="True"/>
                    <Condition SourceName="ItemBorder" Property="UIElement.IsMouseOver" Value="True"/>
                  </MultiTrigger.Conditions>
                  <Setter TargetName="ItemBorder"
                          Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemSelectedMouseOverBackground}}}"
                          Property="Border.Background"/>
                </MultiTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True"/>
    <Setter Property="UIElement.Focusable" Value="False"/>
    <Setter Property="Control.Padding" Value="3"/>
    <Setter Property="Control.Foreground"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemNormalForeground}}}"/>
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type dc:PaneItem}">
          <Border Name="ItemBorder" Cursor="Hand" BorderThickness="0,0,0,1"
                  Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemNormalBackground}}}"
                  BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemNormalBorder}}}">
            <Border Name="ItemBorderInner" BorderThickness="1" Padding="{TemplateBinding Control.Padding}"
                    BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemNormalBorderInner}}}">
              <DockPanel LastChildFill="True">
                <ContentPresenter Name="PaneImage" ContentSource="Image" Margin="1" DockPanel.Dock="Left" VerticalAlignment="Center"
                                  SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"
                                  Content="{TemplateBinding dc:PaneItem.Image}"/>
                <ContentPresenter Name="PART_HeaderContentHost" Margin="2,0,0,0"
                                  SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" VerticalAlignment="Center"
                                  ContentSource="Header"/>
              </DockPanel>
            </Border>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger SourceName="ItemBorder" Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="ItemBorder"
                      Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemMouseOverBackground}}}"
                      Property="Border.Background"/>
              <Setter TargetName="ItemBorder"
                      Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemMouseOverBorder}}}"
                      Property="Border.BorderBrush"/>
              <Setter TargetName="ItemBorderInner"
                      Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemMouseOverBorderInner}}}"
                      Property="Border.BorderBrush"/>
              <Setter Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemMouseOverForeground}}}"
                      Property="Control.Foreground"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="UIElement.IsMouseCaptured" Value="True"/>
                <Condition Property="UIElement.IsMouseOver" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="ItemBorder"
                      Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemMouseDownBackground}}}"
                      Property="Border.Background"/>
              <Setter TargetName="ItemBorder"
                      Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemMouseDownBorder}}}"
                      Property="Border.BorderBrush"/>
              <Setter TargetName="ItemBorderInner"
                      Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemMouseDownBorderInner}}}"
                      Property="Border.BorderBrush"/>
              <Setter Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemMouseDownForeground}}}"
                      Property="Control.Foreground"/>
            </MultiTrigger>
            <Trigger Property="dc:PaneItem.IsSelected" Value="True">
              <Setter TargetName="ItemBorder"
                      Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemSelectedBackground}}}"
                      Property="Border.Background"/>
              <Setter TargetName="ItemBorder"
                      Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemSelectedBorder}}}"
                      Property="Border.BorderBrush"/>
              <Setter TargetName="ItemBorderInner"
                      Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemSelectedBorderInner}}}"
                      Property="Border.BorderBrush"/>
              <Setter Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemSelectedForeground}}}"
                      Property="Control.Foreground"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="dc:PaneItem.IsSelected" Value="True"/>
                <Condition SourceName="ItemBorder" Property="UIElement.IsMouseOver" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="ItemBorder"
                      Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemSelectedMouseOverBackground}}}"
                      Property="Border.Background"/>
              <Setter TargetName="ItemBorder"
                      Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemSelectedMouseOverBorder}}}"
                      Property="Border.BorderBrush"/>
              <Setter TargetName="ItemBorderInner"
                      Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemSelectedMouseOverBorderInner}}}"
                      Property="Border.BorderBrush"/>
              <Setter Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemSelectedMouseOverForeground}}}"
                      Property="Control.Foreground"/>
            </MultiTrigger>
            <DataTrigger Value="true"
                         Binding="{Binding RelativeSource={RelativeSource self}, Path=(HeaderedContentControl.Header), Converter={StaticResource IsStringTypeConverter}}">
              <Setter TargetName="PART_HeaderContentHost" Property="ContentPresenter.ContentTemplate">
                <Setter.Value>
                  <DataTemplate>
                    <FrameworkTemplate.Resources>
                      <Style TargetType="{x:Type TextBlock}">
                        <Style.Triggers>
                          <Trigger Property="UIElement.IsEnabled" Value="False">
                            <Setter Property="TextBlock.Foreground"
                                    Value="{DynamicResource ResourceKey={x:Static JetSystemColors.GrayTextBrushKey}}"/>
                          </Trigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkTemplate.Resources>
                    <TextBlock TextTrimming="CharacterEllipsis" FontWeight="Bold" Text="{Binding}"/>
                  </DataTemplate>
                </Setter.Value>
              </Setter>
            </DataTrigger>
            <Trigger Property="dc:PaneItem.PaneExpanded" Value="false">
              <Setter TargetName="PART_HeaderContentHost" Property="UIElement.Visibility" Value="Collapsed"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>