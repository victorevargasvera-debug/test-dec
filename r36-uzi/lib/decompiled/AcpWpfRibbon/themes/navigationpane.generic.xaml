<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dcc="clr-namespace:DevComponents.WpfRibbon.Converters"
                    xmlns:WinTheme="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Luna"
                    xmlns:dc="clr-namespace:DevComponents.WpfRibbon">
  <dcc:IsStringTypeConverter x:Key="IsStringTypeConverter"/>
  <Style TargetType="{x:Type dc:NavigationPane}">
    <Style.Triggers>
      <Trigger Property="dc:NavigationPane.IsExpanded" Value="false">
        <Setter Property="Control.Template">
          <Setter.Value>
            <ControlTemplate>
              <Border Background="{TemplateBinding Control.Background}"
                      BorderBrush="{TemplateBinding Control.BorderBrush}"
                      BorderThickness="{TemplateBinding Control.BorderThickness}">
                <DockPanel Name="PART_DockPanel" LastChildFill="true">
                  <Border BorderThickness="0,0,0,1" BorderBrush="{TemplateBinding Control.BorderBrush}" DockPanel.Dock="Top">
                    <Border BorderThickness="1,1,0,0" Padding="4"
                            BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPaneTitleBorder}}}"
                            Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPaneTitleBackground}}}">
                      <Button Name="ExpandButton" DockPanel.Dock="Right" Command="dc:NavigationPane.Expand"
                              Style="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId=NavPaneExpandButton}}">
                        <Canvas Width="8" Height="7">
                          <Path Data="M 0,0 L 4,3.5 0,7 "
                                Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPaneTitleForeground}}}"/>
                          <Path Data="M 4,0 L 8,3.5 4,7 "
                                Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPaneTitleForeground}}}"/>
                          <UIElement.Effect>
                            <DropShadowEffect Color="White" ShadowDepth="0" BlurRadius="5" Opacity=".7"/>
                          </UIElement.Effect>
                        </Canvas>
                      </Button>
                    </Border>
                  </Border>
                  <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0"
                          BorderBrush="{TemplateBinding Control.BorderBrush}">
                    <dc:NavigationPanePanel Name="PART_ItemPanel" IsItemsHost="True"
                                            LargeItemsCount="{TemplateBinding dc:NavigationPane.LargeItemsCount}"
                                            PaneExpanded="{TemplateBinding dc:NavigationPane.IsExpanded}" ClipToBounds="True"
                                            SmallItemsBackground="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemNormalBackground}}}"/>
                  </Border>
                  <dc:NavigationPaneSplitter Name="npsplitter" DockPanel.Dock="Bottom" PanePanel="{Binding ElementName=PART_ItemPanel}"/>
                  <Popup Name="PART_Popup" Placement="Bottom" Focusable="False"
                         AllowsTransparency="{x:Static dc:Ribbon.PopupAllowsTransparency}"
                         PopupAnimation="{DynamicResource {x:Static SystemParameters.MenuPopupAnimationKey}}">
                    <WinTheme:SystemDropShadowChrome FrameworkElement.Name="PopupShadow">
                      <Border Name="PopupBorder" BorderThickness="1" Padding="4"
                              BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPanePopupBorder}}}"
                              Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPanePopupBackground}}}">
                        <ContentPresenter Name="PART_NavPaneContentPresenter" VerticalAlignment="Stretch" ContentSource="SelectedContent"
                                          SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"
                                          ContentTemplate="{TemplateBinding dc:NavigationPane.SelectedContentTemplate}"
                                          Content="{TemplateBinding dc:NavigationPane.SelectedContent}"/>
                      </Border>
                    </WinTheme:SystemDropShadowChrome>
                  </Popup>
                  <ToggleButton Name="PART_PopupToggle"
                                Style="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId=NavPanePopupButton}}">
                    <TextBlock FontWeight="Bold" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center"
                               SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPaneTitleForeground}}}"
                               Text="{Binding Path=SystemText.CollapsedPaneText, RelativeSource={RelativeSource TemplatedParent}}">
                      <FrameworkElement.LayoutTransform>
                        <RotateTransform Angle="-90"/>
                      </FrameworkElement.LayoutTransform>
                    </TextBlock>
                  </ToggleButton>
                </DockPanel>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger SourceName="PART_Popup" Property="Popup.HasDropShadow" Value="True">
                  <Setter TargetName="PopupShadow" Property="FrameworkElement.Margin" Value="0,0,5,5"/>
                  <Setter TargetName="PopupShadow" Property="WinTheme:SystemDropShadowChrome.Color" Value="#71000000"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True"/>
    <Setter Property="UIElement.Focusable" Value="False"/>
    <Setter Property="Control.Background"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPaneBackground}}}"/>
    <Setter Property="Control.BorderBrush"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPaneBorder}}}"/>
    <Setter Property="Control.BorderThickness" Value="1"/>
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Background="{TemplateBinding Control.Background}"
                  BorderBrush="{TemplateBinding Control.BorderBrush}"
                  BorderThickness="{TemplateBinding Control.BorderThickness}">
            <DockPanel Name="PART_DockPanel" LastChildFill="true">
              <Border BorderThickness="0,0,0,1" BorderBrush="{TemplateBinding Control.BorderBrush}" DockPanel.Dock="Top">
                <Border BorderThickness="1,1,0,0" Padding="4"
                        BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPaneTitleBorder}}}"
                        Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPaneTitleBackground}}}">
                  <DockPanel LastChildFill="True">
                    <ContentPresenter Name="PART_NavPaneTitlePresenter" VerticalAlignment="Center"
                                      SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"
                                      ContentTemplate="{TemplateBinding dc:NavigationPane.SelectedContentHeaderTemplate}"
                                      Content="{TemplateBinding dc:NavigationPane.SelectedContentHeader}"
                                      TextElement.Foreground="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPaneTitleForeground}}}"/>
                  </DockPanel>
                </Border>
              </Border>
              <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0"
                      BorderBrush="{TemplateBinding Control.BorderBrush}">
                <dc:NavigationPanePanel Name="PART_ItemPanel" IsItemsHost="True"
                                        LargeItemsCount="{TemplateBinding dc:NavigationPane.LargeItemsCount}" ClipToBounds="True"
                                        SmallItemsBackground="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemNormalBackground}}}"/>
              </Border>
              <dc:NavigationPaneSplitter Name="npsplitter" DockPanel.Dock="Bottom" PanePanel="{Binding ElementName=PART_ItemPanel}"/>
              <ContentPresenter Name="PART_NavPaneContentPresenter" ContentSource="SelectedContent"
                                SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"
                                ContentTemplate="{TemplateBinding dc:NavigationPane.SelectedContentTemplate}"
                                Content="{TemplateBinding dc:NavigationPane.SelectedContent}"/>
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <DataTrigger Value="true"
                         Binding="{Binding RelativeSource={RelativeSource self}, Path=(dc:NavigationPane.SelectedContentHeader), Converter={StaticResource IsStringTypeConverter}}">
              <Setter TargetName="PART_NavPaneTitlePresenter" Property="ContentPresenter.ContentTemplate">
                <Setter.Value>
                  <DataTemplate>
                    <TextBlock TextTrimming="CharacterEllipsis" FontWeight="Bold" FontSize="14" Text="{Binding}"/>
                  </DataTemplate>
                </Setter.Value>
              </Setter>
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{ComponentResourceKey {x:Type dc:NavigationPane}, NavPaneExpandButton}"
         TargetType="{x:Type Button}">
    <Setter Property="Control.Padding" Value="6"/>
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Name="ItemBorder" Background="Transparent" Cursor="Hand"
                  Padding="{TemplateBinding Control.Padding}">
            <ContentPresenter ContentSource="Content" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}"
                              Content="{TemplateBinding ContentControl.Content}"
                              SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="ItemBorder"
                      Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemMouseOverBackground}}}"
                      Property="Border.Background"/>
            </Trigger>
            <Trigger Property="ButtonBase.IsPressed" Value="True">
              <Setter TargetName="ItemBorder"
                      Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemMouseDownBackground}}}"
                      Property="Border.Background"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{ComponentResourceKey {x:Type dc:NavigationPane}, NavPanePopupButton}"
         TargetType="{x:Type ToggleButton}">
    <Setter Property="Control.Background"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPaneCollapsedBackground}}}"/>
    <Setter Property="Control.BorderBrush"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPaneCollapsedBorder}}}"/>
    <Setter Property="Control.BorderThickness" Value="1,1,0,0"/>
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Name="ItemBorder" BorderThickness="{TemplateBinding Control.BorderThickness}"
                  BorderBrush="{TemplateBinding Control.BorderBrush}"
                  Background="{TemplateBinding Control.Background}" Padding="{TemplateBinding Control.Padding}">
            <ContentPresenter ContentSource="Content" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}"
                              Content="{TemplateBinding ContentControl.Content}"
                              SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPaneCollapsedMouseOverBackground}}}"
                      Property="Control.Background"/>
              <Setter Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPaneCollapsedMouseOverBorder}}}"
                      Property="Control.BorderBrush"/>
            </Trigger>
            <Trigger Property="ButtonBase.IsPressed" Value="True">
              <Setter Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPaneCollapsedMouseDownBackground}}}"
                      Property="Control.Background"/>
              <Setter Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPaneCollapsedMouseDownBorder}}}"
                      Property="Control.BorderBrush"/>
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPaneCollapsedPopupOpenBackground}}}"
                      Property="Control.Background"/>
              <Setter Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPaneCollapsedPopupOpenBorder}}}"
                      Property="Control.BorderBrush"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>