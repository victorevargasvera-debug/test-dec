<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:DevCo="clr-namespace:DevComponents.WpfRibbon"
                    xmlns:WinTheme="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Luna"
                    xmlns:dcc="clr-namespace:DevComponents.WpfRibbon.Converters">
  <dcc:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
  <Style TargetType="{x:Type DevCo:SuperToolTip}">
    <Setter Property="Control.Background"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.ToolTipBackground}}}"/>
    <Setter Property="Control.BorderBrush"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.ToolTipBorder}}}"/>
    <Setter Property="Control.Foreground"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.ToolTipForeground}}}"/>
    <Setter Property="Control.BorderThickness" Value="1"/>
    <Setter Property="UIElement.SnapsToDevicePixels" Value="true"/>
    <Setter Property="ToolTip.HasDropShadow" Value="true"/>
    <Setter Property="Control.Padding" Value="4,1,4,4"/>
    <Setter Property="Control.FontSize" Value="11"/>
    <Setter Property="Control.HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Control.VerticalContentAlignment" Value="Center"/>
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type DevCo:SuperToolTip}">
          <WinTheme:SystemDropShadowChrome FrameworkElement.Name="Shdw" Color="Transparent" UIElement.SnapsToDevicePixels="true"
                                           CornerRadius="2">
            <Border Name="PART_TooltipBorder" Background="{TemplateBinding Control.Background}"
                    BorderThickness="{TemplateBinding Control.BorderThickness}"
                    BorderBrush="{TemplateBinding Control.BorderBrush}" Padding="{TemplateBinding Control.Padding}"
                    CornerRadius="2">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition/>
                  <RowDefinition Height="*"/>
                  <RowDefinition/>
                </Grid.RowDefinitions>
                <ContentPresenter Name="ContentHeader" Grid.Row="0" Grid.Column="0" Margin="0.5,0,0,8" HorizontalAlignment="Left"
                                  VerticalAlignment="Top" Content="{TemplateBinding DevCo:SuperToolTip.Header}"
                                  TextBlock.FontWeight="Bold" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"
                                  Visibility="{TemplateBinding DevCo:SuperToolTip.HasHeader, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <ContentPresenter Name="ContentBody" Grid.Row="1" Grid.Column="0" Margin="0,0,0,0"
                                  HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}"
                                  SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"/>
                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,4,0,0"
                            Visibility="{TemplateBinding DevCo:SuperToolTip.HasFooter, Converter={StaticResource BoolToVisibilityConverter}}">
                  <Separator Padding="0"
                             Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.ToolTipSeparatorBackground}}}"
                             BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.ToolTipSeparatorBorder}}}"/>
                  <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <ContentPresenter Name="ContentFooterImage" Margin="0,0,3,0" VerticalAlignment="Center"
                                      SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"
                                      Content="{TemplateBinding DevCo:SuperToolTip.FooterImage}"/>
                    <ContentPresenter Name="ContentFooter" HorizontalAlignment="Left" VerticalAlignment="Top"
                                      Content="{TemplateBinding DevCo:SuperToolTip.Footer}"
                                      SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"/>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>
          </WinTheme:SystemDropShadowChrome>
          <ControlTemplate.Triggers>
            <Trigger Property="ToolTip.HasDropShadow" Value="true">
              <Setter TargetName="Shdw" Property="FrameworkElement.Margin" Value="0,0,5,5"/>
              <Setter TargetName="Shdw" Property="WinTheme:SystemDropShadowChrome.Color">
                <Setter.Value>
                  <Color>#71000000</Color>
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="DevCo:SuperToolTip.HasHeader" Value="True">
              <Setter TargetName="ContentBody" Property="FrameworkElement.Margin" Value="10,0,0,0"/>
            </Trigger>
            <Trigger Value="{x:Null}" Property="DevCo:SuperToolTip.FooterImage">
              <Setter TargetName="ContentFooterImage" Property="UIElement.Visibility" Value="Hidden"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>