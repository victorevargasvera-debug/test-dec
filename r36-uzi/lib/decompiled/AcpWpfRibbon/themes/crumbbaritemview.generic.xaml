<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dcc="clr-namespace:DevComponents.WpfRibbon.Converters"
                    xmlns:WinTheme="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Luna"
                    xmlns:dc="clr-namespace:DevComponents.WpfRibbon">
  <dcc:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
  <Style TargetType="{x:Type dc:CrumbBarItemView}">
    <Setter Property="Control.Background" Value="Transparent"/>
    <Setter Property="Control.VerticalContentAlignment" Value="Center"/>
    <Setter Property="Control.Padding" Value="4"/>
    <Setter Property="UIElement.SnapsToDevicePixels" Value="true"/>
    <Setter Property="Control.Template"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:CrumbBarItemView, ResourceId=Default}}"/>
    <Style.Triggers>
      <Trigger Property="dc:CrumbBarItemView.IsOverflowItem" Value="True">
        <Setter Property="Control.Padding" Value="1"/>
        <Setter Property="Control.Template"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:CrumbBarItemView, ResourceId=Overflow}}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <ControlTemplate x:Key="{ComponentResourceKey {x:Type dc:CrumbBarItemView}, Default}"
                   TargetType="{x:Type dc:CrumbBarItemView}">
    <dc:PixelSnap>
      <Border Background="{TemplateBinding Control.Background}"
              BorderBrush="{TemplateBinding Control.BorderBrush}"
              BorderThickness="{TemplateBinding Control.BorderThickness}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Name="MouseOverContent" Margin="1,0,0,0" Opacity="0" Grid.Column="0"
                  Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:CrumbBar, ResourceId={x:Static dc:CrumbBarColors.ButtonHoverBackground}}}">
            <Border Name="MouseOverContentBorder" BorderThickness="1"
                    BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:CrumbBar, ResourceId={x:Static dc:CrumbBarColors.ButtonHoverBorderLight}}}">
              <Border Name="MouseOverContentBorder2" BorderThickness="1,1,0,0"/>
            </Border>
          </Border>
          <Border Name="ContentContainer" Padding="{TemplateBinding Control.Padding}" Grid.Column="0"
                  Background="Transparent">
            <ContentPresenter Name="PART_ItemContent" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}"
                              SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" RecognizesAccessKey="True"
                              Content="{TemplateBinding dc:CrumbBarItemView.Header}"/>
          </Border>
          <Border Name="MouseOverExpand" Opacity="0" Grid.Column="1" BorderThickness="1,0,1,0"
                  Visibility="{Binding Path=CrumbBarItem.HasItems, Converter={StaticResource BoolToVisibilityConverter}, RelativeSource={RelativeSource TemplatedParent}}"
                  Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:CrumbBar, ResourceId={x:Static dc:CrumbBarColors.ButtonHoverBackground}}}"
                  BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:CrumbBar, ResourceId={x:Static dc:CrumbBarColors.ButtonHoverBorder}}}">
            <Border Name="MouseOverExpandBorder" BorderThickness="1"
                    BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:CrumbBar, ResourceId={x:Static dc:CrumbBarColors.ButtonHoverBorderLight}}}">
              <Border Name="MouseOverExpandBorder2" BorderThickness="1,1,0,0"/>
            </Border>
          </Border>
          <ToggleButton Name="PART_ButtonExpand" ClickMode="Press" VerticalAlignment="Stretch" Grid.Column="1"
                        ContextMenuService.IsEnabled="False"
                        IsChecked="{Binding Path=IsPopupOpen, RelativeSource={RelativeSource TemplatedParent}}"
                        Style="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:CrumbBarItemView, ResourceId=ItemExpandButton}}"
                        Visibility="{Binding Path=CrumbBarItem.HasItems, Converter={StaticResource BoolToVisibilityConverter}, RelativeSource={RelativeSource TemplatedParent}}"/>
          <Popup Name="PART_Popup" Placement="Bottom" VerticalOffset="-1" HorizontalOffset="-16" Focusable="false"
                 AllowsTransparency="{x:Static dc:Ribbon.PopupAllowsTransparency}"
                 PopupAnimation="{DynamicResource {x:Static SystemParameters.MenuPopupAnimationKey}}"
                 PlacementTarget="{Binding ElementName=PART_ButtonExpand}"
                 IsOpen="{Binding Path=IsPopupOpen, RelativeSource={RelativeSource TemplatedParent}}">
            <WinTheme:SystemDropShadowChrome FrameworkElement.Name="Shdw" Color="#00FFFFFF">
              <ContentControl Name="PART_PopupContent" IsTabStop="False"
                              Template="{DynamicResource {ComponentResourceKey ResourceId=PopupMenuContent, TypeInTargetAssembly=dc:CrumbBarItemView}}">
                <ScrollViewer Name="PART_ItemsScrollViewer" CanContentScroll="True" Grid.ColumnSpan="2"
                              Style="{DynamicResource {ComponentResourceKey ResourceId=MenuScrollViewer, TypeInTargetAssembly=FrameworkElement}}"/>
              </ContentControl>
            </WinTheme:SystemDropShadowChrome>
          </Popup>
          <Border Name="MouseOverItem" Opacity="0" Grid.ColumnSpan="2" BorderThickness="1,0,1,0"
                  BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:CrumbBar, ResourceId={x:Static dc:CrumbBarColors.ButtonHoverBorder}}}"/>
        </Grid>
      </Border>
    </dc:PixelSnap>
    <ControlTemplate.Triggers>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition SourceName="ContentContainer" Property="UIElement.IsMouseOver" Value="False"/>
          <Condition Property="dc:CrumbBarItemView.IsPopupOpen" Value="False"/>
        </MultiTrigger.Conditions>
        <Setter TargetName="MouseOverContent"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:CrumbBar, ResourceId={x:Static dc:CrumbBarColors.ButtonHoverInactiveBackground}}}"
                Property="Border.Background"/>
        <Setter TargetName="MouseOverItem"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:CrumbBar, ResourceId={x:Static dc:CrumbBarColors.ButtonHoverInactiveBorder}}}"
                Property="Border.BorderBrush"/>
        <Setter TargetName="MouseOverItem" Property="Border.BorderThickness" Value="1,0,0,0"/>
      </MultiTrigger>
      <Trigger Property="dc:CrumbBarItemView.IsMouseOverState" Value="True">
        <TriggerBase.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="MouseOverContent" Storyboard.TargetProperty="Opacity" From="0.0" To="1.0"
                               Duration="0:0:0.3"/>
              <DoubleAnimation Storyboard.TargetName="MouseOverExpand" Storyboard.TargetProperty="Opacity" From="0.0" To="1.0"
                               Duration="0:0:0.3"/>
              <DoubleAnimation Storyboard.TargetName="MouseOverItem" Storyboard.TargetProperty="Opacity" From="0.0" To="1.0"
                               Duration="0:0:0.3"/>
            </Storyboard>
          </BeginStoryboard>
        </TriggerBase.EnterActions>
        <TriggerBase.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="MouseOverContent" Storyboard.TargetProperty="Opacity" From="1.0" To="0.0"
                               Duration="0:0:0.3"/>
              <DoubleAnimation Storyboard.TargetName="MouseOverExpand" Storyboard.TargetProperty="Opacity" From="1.0" To="0.0"
                               Duration="0:0:0.3"/>
              <DoubleAnimation Storyboard.TargetName="MouseOverItem" Storyboard.TargetProperty="Opacity" From="1.0" To="0.0"
                               Duration="0:0:0.3"/>
            </Storyboard>
          </BeginStoryboard>
        </TriggerBase.ExitActions>
      </Trigger>
      <Trigger Property="dc:CrumbBarItemView.IsPressed" Value="True">
        <Setter TargetName="MouseOverContent"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:CrumbBar, ResourceId={x:Static dc:CrumbBarColors.ButtonPressedBackground}}}"
                Property="Border.Background"/>
        <Setter TargetName="MouseOverExpand"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:CrumbBar, ResourceId={x:Static dc:CrumbBarColors.ButtonPressedBackground}}}"
                Property="Border.Background"/>
        <Setter TargetName="MouseOverContentBorder"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:CrumbBar, ResourceId={x:Static dc:CrumbBarColors.ButtonPressedBorder}}}"
                Property="Border.BorderBrush"/>
        <Setter TargetName="MouseOverContentBorder" Property="Border.BorderThickness" Value="1,1,0,0"/>
        <Setter TargetName="MouseOverContentBorder2"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:CrumbBar, ResourceId={x:Static dc:CrumbBarColors.ButtonPressedBorderLight}}}"
                Property="Border.BorderBrush"/>
        <Setter TargetName="MouseOverExpandBorder"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:CrumbBar, ResourceId={x:Static dc:CrumbBarColors.ButtonPressedBorder}}}"
                Property="Border.BorderBrush"/>
        <Setter TargetName="MouseOverExpandBorder" Property="Border.BorderThickness" Value="1,1,0,0"/>
        <Setter TargetName="MouseOverExpandBorder2"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:CrumbBar, ResourceId={x:Static dc:CrumbBarColors.ButtonPressedBorderLight}}}"
                Property="Border.BorderBrush"/>
        <Setter TargetName="PART_ItemContent" Property="UIElement.RenderTransform">
          <Setter.Value>
            <TranslateTransform X="1" Y="1"/>
          </Setter.Value>
        </Setter>
        <Setter TargetName="PART_ButtonExpand" Property="UIElement.RenderTransform">
          <Setter.Value>
            <TranslateTransform X="1" Y="1"/>
          </Setter.Value>
        </Setter>
      </Trigger>
      <Trigger SourceName="PART_Popup" Property="Popup.HasDropShadow" Value="True">
        <Setter TargetName="Shdw" Property="FrameworkElement.Margin" Value="0,0,5,5"/>
        <Setter TargetName="Shdw" Property="WinTheme:SystemDropShadowChrome.Color" Value="#71000000"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <ControlTemplate x:Key="{ComponentResourceKey {x:Type dc:CrumbBarItemView}, Overflow}"
                   TargetType="{x:Type dc:CrumbBarItemView}">
    <dc:PixelSnap>
      <dc:ButtonBorder Name="PART_ItemBorder" BorderThickness="1,1,1,1"
                       SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" CornerRadius="2"
                       Padding="{TemplateBinding Control.Padding}" ColorClass="{x:Static dc:CrumbBarColors.MenuItemClass}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition SharedSizeGroup="MenuIconColumnGroup" Width="Auto" MinWidth="24"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <dc:PixelSnap Grid.Column="0">
            <ContentPresenter Name="PART_ItemImage" Grid.Column="0" ContentSource="Image" VerticalAlignment="Center"
                              SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"
                              Content="{Binding Path=CrumbBarItem.Image, RelativeSource={RelativeSource TemplatedParent}}"/>
          </dc:PixelSnap>
          <dc:PixelSnap Grid.Column="2">
            <ContentPresenter Name="PART_ItemContent" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}"
                              SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"
                              ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" RecognizesAccessKey="True"
                              Content="{TemplateBinding dc:CrumbBarItemView.Header}" Margin="3,1,3,0" Grid.Column="2"/>
          </dc:PixelSnap>
        </Grid>
      </dc:ButtonBorder>
    </dc:PixelSnap>
    <ControlTemplate.Triggers>
      <Trigger Property="UIElement.IsMouseOver" Value="true">
        <Setter TargetName="PART_ItemBorder" Property="dc:ButtonBorder.ButtonState" Value="Hover"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style x:Key="{ComponentResourceKey {x:Type dc:CrumbBarItemView}, ItemExpandButton}"
         TargetType="{x:Type ToggleButton}">
    <Setter Property="Control.Background" Value="Transparent"/>
    <Setter Property="UIElement.SnapsToDevicePixels" Value="true"/>
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <dc:PixelSnap>
            <Border Padding="5,4,4,4" Background="{TemplateBinding Control.Background}">
              <Grid>
                <Path Name="ExpandSign" Data="M 0,0 L 4,3.5 0,7 Z" Margin="2,0,1,0"
                      Fill="{TemplateBinding TextElement.Foreground}" VerticalAlignment="Center"/>
                <Path Name="CollapseSign" Data="M 0,0 L 3.5,4 7,0 Z" Margin="-1,1,0,0"
                      Fill="{TemplateBinding TextElement.Foreground}" VerticalAlignment="Center" Visibility="Hidden"/>
              </Grid>
            </Border>
          </dc:PixelSnap>
          <ControlTemplate.Triggers>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="ExpandSign" Property="UIElement.Visibility" Value="Collapsed"/>
              <Setter TargetName="CollapseSign" Property="UIElement.Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <ControlTemplate x:Key="{ComponentResourceKey {x:Type dc:CrumbBarItemView}, PopupMenuContent}"
                   TargetType="{x:Type ContentControl}">
    <Border BorderThickness="1,1,1,1"
            BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:CrumbBar, ResourceId={x:Static dc:RibbonColors.MenuBorder}}}"
            Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:CrumbBar, ResourceId={x:Static dc:RibbonColors.MenuBackground}}}">
      <Grid>
        <Rectangle Margin="1" Width="28" RadiusY="2" HorizontalAlignment="Left" RadiusX="2"
                   Fill="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:CrumbBar, ResourceId={x:Static dc:RibbonColors.MenuSideBackground}}}"/>
        <Rectangle Margin="29,2,0,2" Width="1" HorizontalAlignment="Left"
                   Fill="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:CrumbBar, ResourceId={x:Static dc:RibbonColors.MenuSideLineDark}}}"/>
        <Rectangle Margin="30,2,0,2" Width="1" HorizontalAlignment="Left"
                   Fill="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:CrumbBar, ResourceId={x:Static dc:RibbonColors.MenuSideLineLight}}}"/>
        <ContentPresenter Margin="0,0,0,0" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}"
                          Content="{TemplateBinding ContentControl.Content}" Grid.ColumnSpan="2"/>
      </Grid>
    </Border>
  </ControlTemplate>
</ResourceDictionary>