<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dcc="clr-namespace:DevComponents.WpfRibbon.Converters"
                    xmlns:dc="clr-namespace:DevComponents.WpfRibbon">
  <Style TargetType="{x:Type dc:NavigationPaneSplitter}">
    <Setter Property="FrameworkElement.Height" Value="8"/>
    <Setter Property="Control.Foreground"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemNormalForeground}}}"/>
    <Setter Property="Control.BorderBrush"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPaneBorder}}}"/>
    <Setter Property="Control.Background"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPaneTitleBackground}}}"/>
    <Setter Property="Control.BorderThickness" Value="0,1,0,0"/>
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True"/>
    <Setter Property="UIElement.Focusable" Value="False"/>
    <Setter Property="Control.Padding" Value="7"/>
    <Setter Property="FrameworkElement.Cursor" Value="SizeNS"/>
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border BorderBrush="{TemplateBinding Control.BorderBrush}"
                  BorderThickness="{TemplateBinding Control.BorderThickness}"
                  Background="{TemplateBinding Control.Background}">
            <Border BorderThickness="1,1,0,0"
                    BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPaneTitleBorder}}}">
              <Canvas Width="19" Height="3">
                <Rectangle Width="2" Height="2" Canvas.Left="1" Canvas.Top="0"
                           Fill="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPaneTitleBorder}}}"/>
                <Rectangle Width="2" Height="2" Canvas.Left="5" Canvas.Top="0"
                           Fill="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPaneTitleBorder}}}"/>
                <Rectangle Width="2" Height="2" Canvas.Left="9" Canvas.Top="0"
                           Fill="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPaneTitleBorder}}}"/>
                <Rectangle Width="2" Height="2" Canvas.Left="13" Canvas.Top="0"
                           Fill="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPaneTitleBorder}}}"/>
                <Rectangle Width="2" Height="2" Canvas.Left="17" Canvas.Top="0"
                           Fill="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.NavPaneTitleBorder}}}"/>
                <Rectangle Width="2" Height="2" Canvas.Left="0" Canvas.Top="0" Fill="{TemplateBinding Control.Foreground}"/>
                <Rectangle Width="2" Height="2" Canvas.Left="4" Canvas.Top="0" Fill="{TemplateBinding Control.Foreground}"/>
                <Rectangle Width="2" Height="2" Canvas.Left="8" Canvas.Top="0" Fill="{TemplateBinding Control.Foreground}"/>
                <Rectangle Width="2" Height="2" Canvas.Left="12" Canvas.Top="0" Fill="{TemplateBinding Control.Foreground}"/>
                <Rectangle Width="2" Height="2" Canvas.Left="16" Canvas.Top="0" Fill="{TemplateBinding Control.Foreground}"/>
              </Canvas>
            </Border>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>