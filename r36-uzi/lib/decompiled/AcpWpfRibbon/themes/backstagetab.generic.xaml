<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:dc="clr-namespace:DevComponents.WpfRibbon"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style TargetType="{x:Type dc:BackstageTab}">
    <Setter Property="Control.Padding" Value="22,8,0,8"/>
    <Setter Property="FrameworkElement.Margin" Value="0,1,0,1"/>
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True"/>
    <Setter Property="UIElement.ClipToBounds" Value="True"/>
    <Setter Property="Control.FontSize" Value="14"/>
    <Setter Property="Control.HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="FrameworkElement.HorizontalAlignment" Value="Stretch"/>
    <Setter Property="Control.VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="Control.BorderThickness" Value="0,1,0,1"/>
    <Setter Property="Control.Background"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.BackstageTabNormalBackground}}}"/>
    <Setter Property="Control.BorderBrush"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.BackstageTabNormalBorder}}}"/>
    <Setter Property="dc:BackstageTab.InnerBorderBrush"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.BackstageTabNormalBorderInner}}}"/>
    <Setter Property="dc:BackstageTab.InnerBorderThickness" Value="0,1,0,1"/>
    <Setter Property="Control.Foreground"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.BackstageTabNormalForeground}}}"/>
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type dc:BackstageTab}">
          <Border Name="TabBorder" ContextMenu="{TemplateBinding dc:BackstageTab.TabContextMenu}"
                  BorderBrush="{TemplateBinding Control.BorderBrush}"
                  Background="{TemplateBinding Control.Background}"
                  BorderThickness="{TemplateBinding Control.BorderThickness}"
                  ToolTip="{TemplateBinding dc:BackstageTab.TabToolTip}">
            <Border Name="TabBorderInner" BorderBrush="{TemplateBinding dc:BackstageTab.InnerBorderBrush}"
                    BorderThickness="{TemplateBinding dc:BackstageTab.InnerBorderThickness}"
                    Padding="{TemplateBinding Control.Padding}">
              <DockPanel LastChildFill="True">
                <Path Name="SelectMark" DockPanel.Dock="Right" Fill="White" Data="M 0,0.5 L 1,1 1,0 Z" Margin="0,2,0,-2"
                      VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="Fill" Width="6" Height="11"
                      Visibility="Hidden"/>
                <ContentPresenter Name="PART_HeaderContentHost" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"
                                  VerticalAlignment="Center" Content="{TemplateBinding HeaderedContentControl.Header}"/>
              </DockPanel>
            </Border>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.BackstageTabMouseOverBackground}}}"
                      Property="Control.Background"/>
              <Setter Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.BackstageTabMouseOverBorderInner}}}"
                      Property="dc:BackstageTab.InnerBorderBrush"/>
              <Setter Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.BackstageTabMouseOverBorder}}}"
                      Property="Control.BorderBrush"/>
              <Setter Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.BackstageTabMouseOverForeground}}}"
                      Property="Control.Foreground"/>
            </Trigger>
            <Trigger Property="TabItem.IsSelected" Value="True">
              <Setter TargetName="SelectMark" Property="UIElement.Visibility" Value="Visible"/>
              <Setter Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.BackstageTabSelectedBackground}}}"
                      Property="Control.Background"/>
              <Setter Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.BackstageTabSelectedBorder}}}"
                      Property="Control.BorderBrush"/>
              <Setter Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.BackstageTabSelectedBorderInner}}}"
                      Property="dc:BackstageTab.InnerBorderBrush"/>
              <Setter Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.BackstageTabSelectedForeground}}}"
                      Property="Control.Foreground"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>