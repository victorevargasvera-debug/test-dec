<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dc="clr-namespace:DevComponents.WpfRibbon">
  <GeometryGroup x:Key="DL_Geometry">
    <LineGeometry StartPoint="0.5,6" EndPoint="0.5,0.5"/>
    <LineGeometry StartPoint="0.5,0.5" EndPoint="6,0.5"/>
    <RectangleGeometry Rect="4.5,4.5,2,2"/>
    <LineGeometry StartPoint="3,6.5" EndPoint="6.5,6.5"/>
    <LineGeometry StartPoint="6.5,6.5" EndPoint="6.5,3"/>
    <LineGeometry StartPoint="3,3" EndPoint="4,4"/>
  </GeometryGroup>
  <GeometryGroup x:Key="DL_Geometry2">
    <LineGeometry StartPoint="0.5,5" EndPoint="0.5,0.5"/>
    <LineGeometry StartPoint="0.5,0.5" EndPoint="5,0.5"/>
    <RectangleGeometry Rect="4.5,4.5,2,2"/>
    <LineGeometry StartPoint="3,6.5" EndPoint="6.5,6.5"/>
    <LineGeometry StartPoint="6.5,6.5" EndPoint="6.5,3"/>
    <LineGeometry StartPoint="3,3" EndPoint="4,4"/>
  </GeometryGroup>
  <Style TargetType="{x:Type dc:RibbonBar}">
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="dc:Ribbon.IsCustomizable" Value="True"/>
    <Setter Property="KeyboardNavigation.TabNavigation" Value="Continue"/>
    <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Continue"/>
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <dc:RibbonBorder Name="PART_RibbonBarBorder" BorderThickness="1" LightBorderThickness="1"
                           SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" CornerRadius="3"
                           BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.RibbonBarNormalBorder}}}"
                           LightBorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.RibbonBarNormalBorderLight}}}"
                           Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.RibbonBarNormalBackground}}}"
                           TopHighlight="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.RibbonBarNormalTopHighlight}}}">
            <DockPanel LastChildFill="True">
              <Grid DockPanel.Dock="Bottom">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition x:Name="DL_Column" Width="16"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition MinHeight="15"/>
                </Grid.RowDefinitions>
                <dc:RibbonBorder x:Name="PART_RibbonBarTitle" ColorClass="{x:Static dc:RibbonColors.RibbonBarTitleClass}"
                                 Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2"
                                 Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.RibbonBarTitleNormalBackground}}}"/>
                <ContentPresenter x:Name="RibbonTitleContent" Grid.Column="0" Grid.Row="0"
                                  Content="{TemplateBinding HeaderedItemsControl.Header}" HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  TextBlock.Foreground="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.RibbonBarTitleNormalForeground}}}">
                  <ContentPresenter.ContentTemplate>
                    <DataTemplate>
                      <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding}"/>
                    </DataTemplate>
                  </ContentPresenter.ContentTemplate>
                </ContentPresenter>
                <dc:ButtonDropDown x:Name="PART_DialogLauncher" Grid.Column="1" Grid.Row="0"
                                   Visibility="{TemplateBinding dc:RibbonBar.DialogLauncherVisible}" VerticalAlignment="Center"
                                   SnapsToDevicePixels="True" CornerRadius="0">
                  <HeaderedItemsControl.Header>
                    <Canvas Height="8" MaxWidth="8">
                      <Path Canvas.Left="1" Canvas.Top="1" StrokeThickness="1" Data="{StaticResource DL_Geometry2}"
                            Fill="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.RibbonBarDialogLauncherForegroundLight}}}"
                            Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.RibbonBarDialogLauncherForegroundLight}}}"/>
                      <Path Canvas.Left="0" Canvas.Top="0" StrokeThickness="1" Data="{StaticResource DL_Geometry}"
                            Fill="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.RibbonBarDialogLauncherForeground}}}"
                            Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.RibbonBarDialogLauncherForeground}}}"/>
                    </Canvas>
                  </HeaderedItemsControl.Header>
                </dc:ButtonDropDown>
              </Grid>
              <dc:ButtonPanel Name="PART_RibbonBarPanel" IsItemsHost="True" KeyboardNavigation.TabNavigation="Continue"
                              KeyboardNavigation.DirectionalNavigation="Continue"
                              VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}"
                              HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}"/>
            </DockPanel>
          </dc:RibbonBorder>
          <ControlTemplate.Triggers>
            <Trigger Property="dc:RibbonBar.DialogLauncherVisible" Value="Collapsed">
              <Setter TargetName="DL_Column" Property="ColumnDefinition.Width" Value="0"/>
            </Trigger>
            <Trigger Property="dc:RibbonTab.TabColor" Value="Green">
              <Setter TargetName="PART_RibbonBarBorder" Property="dc:RibbonBorder.ColorClass" Value="RibbonBarGreen"/>
              <Setter TargetName="PART_RibbonBarTitle" Property="dc:RibbonBorder.ColorClass" Value="RibbonBarGreenTitle"/>
            </Trigger>
            <Trigger Property="dc:RibbonTab.TabColor" Value="Orange">
              <Setter TargetName="PART_RibbonBarBorder" Property="dc:RibbonBorder.ColorClass" Value="RibbonBarOrange"/>
              <Setter TargetName="PART_RibbonBarTitle" Property="dc:RibbonBorder.ColorClass" Value="RibbonBarOrangeTitle"/>
            </Trigger>
            <Trigger Property="dc:RibbonTab.TabColor" Value="Red">
              <Setter TargetName="PART_RibbonBarBorder" Property="dc:RibbonBorder.ColorClass" Value="RibbonBarRed"/>
              <Setter TargetName="PART_RibbonBarTitle" Property="dc:RibbonBorder.ColorClass" Value="RibbonBarRedTitle"/>
            </Trigger>
            <Trigger Property="dc:RibbonBar.EffectiveStyle" Value="Office2010">
              <Setter TargetName="PART_RibbonBarBorder" Property="dc:RibbonBorder.BorderThickness" Value="0,0,1,0"/>
              <Setter TargetName="PART_RibbonBarBorder" Property="dc:RibbonBorder.LightBorderThickness" Value="0,0,2,0"/>
              <Setter TargetName="PART_RibbonBarBorder" Property="dc:RibbonBorder.CornerRadius" Value="0"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>