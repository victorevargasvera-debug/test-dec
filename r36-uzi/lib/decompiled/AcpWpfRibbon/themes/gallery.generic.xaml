<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mwt="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero"
                    xmlns:s="clr-namespace:System;assembly=mscorlib"
                    xmlns:WinTheme="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Luna"
                    xmlns:dcc="clr-namespace:DevComponents.WpfRibbon.Converters"
                    xmlns:DevCo="clr-namespace:DevComponents.WpfRibbon">
  <dcc:ImagePositionToDockConverter x:Key="ImagePositionToDockConverter"/>
  <dcc:ExpandPositionToDockConverter x:Key="ExpandPositionToDockConverter"/>
  <dcc:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
  <Style TargetType="{x:Type DevCo:Gallery}">
    <Style.Triggers>
      <Trigger Property="DevCo:Gallery.IsCollapsed" Value="True">
        <Setter Property="Control.Template"
                Value="{DynamicResource {ComponentResourceKey ResourceId=GalleryButton, TypeInTargetAssembly=DevCo:Gallery}}"/>
        <Setter Property="DevCo:ButtonDropDown.ExpandPosition" Value="Bottom"/>
        <Setter Property="FrameworkElement.Margin" Value="0"/>
      </Trigger>
    </Style.Triggers>
    <Setter Property="Control.Background"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryNormalBackground}}}"/>
    <Setter Property="Control.BorderBrush"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryNormalBorder}}}"/>
    <Setter Property="Control.BorderThickness" Value="1"/>
    <Setter Property="FrameworkElement.Margin" Value="3"/>
    <Setter Property="DevCo:ButtonDropDown.Role" Value="DropDown"/>
    <Setter Property="UIElement.Focusable" Value="False"/>
    <Setter Property="DevCo:ButtonDropDown.ImagePosition" Value="Top"/>
    <Setter Property="DevCo:ButtonDropDown.CommandParameter">
      <Setter.Value>
        <DevCo:ButtonCommandParameter/>
      </Setter.Value>
    </Setter>
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type DevCo:Gallery}">
          <Border Name="PART_GalleryBorder" Background="{TemplateBinding Control.Background}" CornerRadius="3"
                  BorderBrush="{TemplateBinding Control.BorderBrush}"
                  BorderThickness="{TemplateBinding Control.BorderThickness}"
                  Padding="{TemplateBinding Control.Padding}">
            <Grid SnapsToDevicePixels="True">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Popup Name="PART_Popup" Placement="Bottom" Focusable="False"
                     AllowsTransparency="{x:Static DevCo:Ribbon.PopupAllowsTransparency}" PopupAnimation="None"
                     MinWidth="{Binding Path=ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                     IsOpen="{Binding Path=IsPopupOpen, RelativeSource={RelativeSource TemplatedParent}}">
                <WinTheme:SystemDropShadowChrome FrameworkElement.Name="Shdw" Color="#00FFFFFF">
                  <Border BorderThickness="1,1,1,1" CornerRadius="3"
                          BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.MenuBorder}}}"
                          Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.MenuBackground}}}">
                    <StackPanel Orientation="Vertical">
                      <ScrollViewer Name="PopupScrollViewer" CanContentScroll="False"
                                    Style="{DynamicResource {ComponentResourceKey ResourceId=GalleryMenuScrollViewer, TypeInTargetAssembly=DevCo:Gallery}}">
                        <StackPanel Name="PopupContainerPanel" Orientation="Vertical"/>
                      </ScrollViewer>
                      <Separator Padding="0" Margin="0"
                                 Visibility="{Binding Path=MenuItemsVisibility, RelativeSource={RelativeSource TemplatedParent}}"/>
                      <Grid Visibility="{Binding Path=MenuItemsVisibility, RelativeSource={RelativeSource TemplatedParent}}">
                        <Rectangle Margin="1,0,1,1" Width="28" RadiusY="2" HorizontalAlignment="Left" RadiusX="2"
                                   Fill="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.MenuSideBackground}}}"/>
                        <Rectangle Margin="29,0,0,2" Width="1" HorizontalAlignment="Left"
                                   Fill="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.MenuSideLineDark}}}"/>
                        <Rectangle Margin="30,0,0,2" Width="1" HorizontalAlignment="Left"
                                   Fill="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.MenuSideLineLight}}}"/>
                        <StackPanel Name="PART_MenuItemsPanel" Orientation="Vertical" Grid.ColumnSpan="2"/>
                      </Grid>
                      <Border BorderThickness="0,1,0,0" MinHeight="11"
                              Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryResizeBackground}}}"
                              BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryResizeBorder}}}"
                              Visibility="{TemplateBinding DevCo:Gallery.IsResizeEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Thumb Name="GalleryPopupResizeThumb"
                               Style="{DynamicResource {ComponentResourceKey ResourceId=GalleryThumb, TypeInTargetAssembly=DevCo:Gallery}}"/>
                      </Border>
                    </StackPanel>
                  </Border>
                </WinTheme:SystemDropShadowChrome>
              </Popup>
              <Border Grid.Column="0" Grid.Row="0">
                <DevCo:GalleryScrollViewer Name="GalleryView" ClipToBounds="True">
                  <WrapPanel Name="PART_ItemsPanel" Orientation="Horizontal" IsItemsHost="True" Canvas.Left="0" Canvas.Top="0"
                             KeyboardNavigation.DirectionalNavigation="Continue"/>
                </DevCo:GalleryScrollViewer>
              </Border>
              <Border Grid.Column="1" Grid.Row="0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <RepeatButton Visibility="Visible" Focusable="False" Command="DevCo:GalleryScrollViewer.LineUpCommand"
                                Margin="0,-1,-1,0" Grid.Column="0" Grid.Row="0" CommandTarget="{Binding ElementName=GalleryView}">
                    <FrameworkElement.Style>
                      <Style TargetType="{x:Type RepeatButton}">
                        <Setter Property="Control.Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                              <Border Name="RepeatBorder" BorderThickness="1" CornerRadius="0,2,0,0"
                                      BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonNormalBorder}}}"
                                      Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonNormalBackground}}}">
                                <Border Name="RepeatBorderInner" BorderThickness="1" CornerRadius="0,1,0,0" Padding="2,4,2,4"
                                        BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonNormalBorderInner}}}">
                                  <Path Name="RepeatSign" VerticalAlignment="Center" Data="M 3.5,0 L 0,4 7,4 Z"
                                        Fill="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonNormalForeground}}}"/>
                                </Border>
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="UIElement.IsMouseOver" Value="True">
                                  <Setter TargetName="RepeatBorder"
                                          Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonHoverBorder}}}"
                                          Property="Border.BorderBrush"/>
                                  <Setter TargetName="RepeatBorder"
                                          Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonHoverBackground}}}"
                                          Property="Border.Background"/>
                                  <Setter TargetName="RepeatBorderInner"
                                          Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonHoverBorderInner}}}"
                                          Property="Border.BorderBrush"/>
                                  <Setter TargetName="RepeatSign"
                                          Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonHoverForeground}}}"
                                          Property="Shape.Fill"/>
                                </Trigger>
                                <Trigger Property="ButtonBase.IsPressed" Value="True">
                                  <Setter TargetName="RepeatBorder"
                                          Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonPressedBorder}}}"
                                          Property="Border.BorderBrush"/>
                                  <Setter TargetName="RepeatBorder"
                                          Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonPressedBackground}}}"
                                          Property="Border.Background"/>
                                  <Setter TargetName="RepeatBorderInner"
                                          Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonPressedBorderInner}}}"
                                          Property="Border.BorderBrush"/>
                                  <Setter TargetName="RepeatSign"
                                          Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonPressedForeground}}}"
                                          Property="Shape.Fill"/>
                                </Trigger>
                                <Trigger Property="UIElement.IsEnabled" Value="False">
                                  <Setter TargetName="RepeatBorder"
                                          Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonDisabledBorder}}}"
                                          Property="Border.BorderBrush"/>
                                  <Setter TargetName="RepeatBorder"
                                          Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonDisabledBackground}}}"
                                          Property="Border.Background"/>
                                  <Setter TargetName="RepeatBorderInner"
                                          Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonDisabledBorderInner}}}"
                                          Property="Border.BorderBrush"/>
                                  <Setter TargetName="RepeatSign"
                                          Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonDisabledForeground}}}"
                                          Property="Shape.Fill"/>
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </FrameworkElement.Style>
                  </RepeatButton>
                  <RepeatButton Name="PART_ScrollDownButton" Visibility="Visible" Focusable="False"
                                Command="{x:Static DevCo:GalleryScrollViewer.LineDownCommand}" Margin="0,0,-1,0" Grid.Column="0"
                                Grid.Row="1" CommandTarget="{Binding ElementName=GalleryView}">
                    <FrameworkElement.Style>
                      <Style TargetType="{x:Type RepeatButton}">
                        <Setter Property="Control.Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                              <Border Name="RepeatBorder" BorderThickness="1" CornerRadius="0,2,0,0"
                                      BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonNormalBorder}}}"
                                      Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonNormalBackground}}}">
                                <Border Name="RepeatBorderInner" BorderThickness="1" CornerRadius="0,1,0,0" Padding="2,4,2,4"
                                        BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonNormalBorderInner}}}">
                                  <Path Name="RepeatSign" VerticalAlignment="Center" Data="M 0,0 L 3.5,4 7,0 Z"
                                        Fill="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonNormalForeground}}}"/>
                                </Border>
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="UIElement.IsMouseOver" Value="True">
                                  <Setter TargetName="RepeatBorder"
                                          Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonHoverBorder}}}"
                                          Property="Border.BorderBrush"/>
                                  <Setter TargetName="RepeatBorder"
                                          Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonHoverBackground}}}"
                                          Property="Border.Background"/>
                                  <Setter TargetName="RepeatBorderInner"
                                          Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonHoverBorderInner}}}"
                                          Property="Border.BorderBrush"/>
                                  <Setter TargetName="RepeatSign"
                                          Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonHoverForeground}}}"
                                          Property="Shape.Fill"/>
                                </Trigger>
                                <Trigger Property="ButtonBase.IsPressed" Value="True">
                                  <Setter TargetName="RepeatBorder"
                                          Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonPressedBorder}}}"
                                          Property="Border.BorderBrush"/>
                                  <Setter TargetName="RepeatBorder"
                                          Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonPressedBackground}}}"
                                          Property="Border.Background"/>
                                  <Setter TargetName="RepeatBorderInner"
                                          Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonPressedBorderInner}}}"
                                          Property="Border.BorderBrush"/>
                                  <Setter TargetName="RepeatSign"
                                          Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonPressedForeground}}}"
                                          Property="Shape.Fill"/>
                                </Trigger>
                                <Trigger Property="UIElement.IsEnabled" Value="False">
                                  <Setter TargetName="RepeatBorder"
                                          Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonDisabledBorder}}}"
                                          Property="Border.BorderBrush"/>
                                  <Setter TargetName="RepeatBorder"
                                          Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonDisabledBackground}}}"
                                          Property="Border.Background"/>
                                  <Setter TargetName="RepeatBorderInner"
                                          Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonDisabledBorderInner}}}"
                                          Property="Border.BorderBrush"/>
                                  <Setter TargetName="RepeatSign"
                                          Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonDisabledForeground}}}"
                                          Property="Shape.Fill"/>
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </FrameworkElement.Style>
                  </RepeatButton>
                  <RepeatButton Visibility="Visible" Focusable="False" Margin="0,0,-1,-1"
                                Command="{x:Static DevCo:Gallery.DropDownGalleryCommand}" Grid.Column="0" Grid.Row="2"
                                CommandTarget="{Binding Source={RelativeSource TemplatedParent}}">
                    <FrameworkElement.Style>
                      <Style TargetType="{x:Type RepeatButton}">
                        <Setter Property="Control.Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                              <Border Name="RepeatBorder" BorderThickness="1" CornerRadius="0,0,0,2"
                                      BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonNormalBorder}}}"
                                      Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonNormalBackground}}}">
                                <Border Name="RepeatBorderInner" BorderThickness="1" CornerRadius="0,1,0,0" Padding="2,4,2,4"
                                        BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonNormalBorderInner}}}">
                                  <StackPanel VerticalAlignment="Center">
                                    <Path Name="RepeatSignLine" Data="M 0,0.5 L 7,0.5 " Margin="0,0,0,2"
                                          Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonNormalForeground}}}"/>
                                    <Path Name="RepeatSign" Data="M 0,0 L 3.5,4 7,0 Z"
                                          Fill="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonNormalForeground}}}"/>
                                  </StackPanel>
                                </Border>
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="UIElement.IsMouseOver" Value="True">
                                  <Setter TargetName="RepeatBorder"
                                          Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonHoverBorder}}}"
                                          Property="Border.BorderBrush"/>
                                  <Setter TargetName="RepeatBorder"
                                          Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonHoverBackground}}}"
                                          Property="Border.Background"/>
                                  <Setter TargetName="RepeatBorderInner"
                                          Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonHoverBorderInner}}}"
                                          Property="Border.BorderBrush"/>
                                  <Setter TargetName="RepeatSign"
                                          Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonHoverForeground}}}"
                                          Property="Shape.Fill"/>
                                </Trigger>
                                <Trigger Property="ButtonBase.IsPressed" Value="True">
                                  <Setter TargetName="RepeatBorder"
                                          Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonPressedBorder}}}"
                                          Property="Border.BorderBrush"/>
                                  <Setter TargetName="RepeatBorder"
                                          Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonPressedBackground}}}"
                                          Property="Border.Background"/>
                                  <Setter TargetName="RepeatBorderInner"
                                          Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonPressedBorderInner}}}"
                                          Property="Border.BorderBrush"/>
                                  <Setter TargetName="RepeatSign"
                                          Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonPressedForeground}}}"
                                          Property="Shape.Fill"/>
                                </Trigger>
                                <Trigger Property="UIElement.IsEnabled" Value="False">
                                  <Setter TargetName="RepeatBorder"
                                          Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonDisabledBorder}}}"
                                          Property="Border.BorderBrush"/>
                                  <Setter TargetName="RepeatBorder"
                                          Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonDisabledBackground}}}"
                                          Property="Border.Background"/>
                                  <Setter TargetName="RepeatBorderInner"
                                          Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonDisabledBorderInner}}}"
                                          Property="Border.BorderBrush"/>
                                  <Setter TargetName="RepeatSign"
                                          Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryScrollButtonDisabledForeground}}}"
                                          Property="Shape.Fill"/>
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </FrameworkElement.Style>
                  </RepeatButton>
                </Grid>
              </Border>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger SourceName="PART_Popup" Property="Popup.HasDropShadow" Value="True">
              <Setter TargetName="Shdw" Property="FrameworkElement.Margin" Value="0,0,5,5"/>
              <Setter TargetName="Shdw" Property="WinTheme:SystemDropShadowChrome.Color" Value="#71000000"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <ControlTemplate x:Key="{ComponentResourceKey {x:Type DevCo:Gallery}, GalleryButton}"
                   TargetType="{x:Type DevCo:Gallery}">
    <DevCo:ButtonBorder Name="PART_ButtonDropDownBorder" BorderThickness="1,1,1,1"
                        SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" CornerRadius="2"
                        Padding="{TemplateBinding Control.Padding}"
                        ColorClass="{TemplateBinding DevCo:ButtonDropDown.ColorClass}">
      <DockPanel LastChildFill="True">
        <Popup Name="PART_Popup" Placement="Bottom" Focusable="False"
               AllowsTransparency="{x:Static DevCo:Ribbon.PopupAllowsTransparency}" PopupAnimation="None"
               MinWidth="{Binding Path=ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
               IsOpen="{Binding Path=IsPopupOpen, RelativeSource={RelativeSource TemplatedParent}}">
          <WinTheme:SystemDropShadowChrome FrameworkElement.Name="Shdw" Color="#00FFFFFF">
            <Border BorderThickness="1,1,1,1" CornerRadius="3"
                    BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.MenuBorder}}}"
                    Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.MenuBackground}}}">
              <StackPanel Orientation="Vertical">
                <ScrollViewer Name="PopupScrollViewer" CanContentScroll="False"
                              Style="{DynamicResource {ComponentResourceKey ResourceId=GalleryMenuScrollViewer, TypeInTargetAssembly=DevCo:Gallery}}">
                  <StackPanel Name="PopupContainerPanel" Orientation="Vertical"/>
                </ScrollViewer>
                <Separator Padding="0" Margin="0"
                           Visibility="{Binding Path=MenuItemsVisibility, RelativeSource={RelativeSource TemplatedParent}}"/>
                <Grid Visibility="{Binding Path=MenuItemsVisibility, RelativeSource={RelativeSource TemplatedParent}}">
                  <Rectangle Margin="1,0,1,1" Width="28" RadiusY="2" HorizontalAlignment="Left" RadiusX="2"
                             Fill="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.MenuSideBackground}}}"/>
                  <Rectangle Margin="29,0,0,2" Width="1" HorizontalAlignment="Left"
                             Fill="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.MenuSideLineDark}}}"/>
                  <Rectangle Margin="30,0,0,2" Width="1" HorizontalAlignment="Left"
                             Fill="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.MenuSideLineLight}}}"/>
                  <StackPanel Name="PART_MenuItemsPanel" Orientation="Vertical" Grid.ColumnSpan="2"/>
                </Grid>
                <Border BorderThickness="0,1,0,0" MinHeight="11"
                        Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryResizeBackground}}}"
                        BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryResizeBorder}}}"
                        Visibility="{TemplateBinding DevCo:Gallery.IsResizeEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                  <Thumb Name="GalleryPopupResizeThumb"
                         Style="{DynamicResource {ComponentResourceKey ResourceId=GalleryThumb, TypeInTargetAssembly=DevCo:Gallery}}"/>
                </Border>
              </StackPanel>
            </Border>
          </WinTheme:SystemDropShadowChrome>
        </Popup>
        <ContentPresenter Name="PART_ButtonImage" ContentSource="RenderImage" Margin="1,1,1,1" VerticalAlignment="Center"
                          SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"
                          Content="{TemplateBinding DevCo:ButtonDropDown.RenderImage}"
                          DockPanel.Dock="{TemplateBinding DevCo:ButtonDropDown.ImagePosition, Converter={StaticResource ImagePositionToDockConverter}}"/>
        <Path Name="PART_ButtonExpand" Margin="2,2,2,2" Data="M 0,0 L 3,2.5 0,5 Z"
              Fill="{TemplateBinding TextElement.Foreground}" VerticalAlignment="Center"
              HorizontalAlignment="Center" Visibility="{TemplateBinding DevCo:ButtonDropDown.IsExpandVisible}"
              DockPanel.Dock="{TemplateBinding DevCo:ButtonDropDown.ExpandPosition, Converter={StaticResource ExpandPositionToDockConverter}}"/>
        <TextBlock Name="PART_ButtonContent" TextWrapping="Wrap" Margin="0"
                   HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}"
                   VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" TextAlignment="Center"
                   SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}">
          <AccessText TextWrapping="Wrap" Text="{TemplateBinding HeaderedItemsControl.Header}"
                      SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"/>
          <Path Name="PART_ButtonExpandInline" Margin="0,0,0,4" Data="M 0,0 L 2.5,3 5,0 Z"
                Fill="{TemplateBinding TextElement.Foreground}" VerticalAlignment="Center" Visibility="Collapsed"/>
        </TextBlock>
      </DockPanel>
    </DevCo:ButtonBorder>
    <ControlTemplate.Triggers>
      <Trigger Property="DevCo:ButtonDropDown.ImagePosition" Value="Right">
        <Setter Property="Control.HorizontalContentAlignment" Value="Right"/>
        <Setter Property="Control.VerticalContentAlignment" Value="Center"/>
      </Trigger>
      <Trigger Property="DevCo:ButtonDropDown.ImagePosition" Value="Top">
        <Setter Property="Control.HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Control.VerticalContentAlignment" Value="Top"/>
      </Trigger>
      <Trigger Property="DevCo:ButtonDropDown.ImagePosition" Value="Bottom">
        <Setter Property="Control.HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Control.VerticalContentAlignment" Value="Bottom"/>
      </Trigger>
      <Trigger Property="DevCo:ButtonDropDown.PartVisibility" Value="ImageOnly">
        <Setter TargetName="PART_ButtonImage" Value="{x:Static Visibility.Visible}" Property="UIElement.Visibility"/>
        <Setter TargetName="PART_ButtonContent" Value="{x:Static Visibility.Collapsed}"
                Property="UIElement.Visibility"/>
      </Trigger>
      <Trigger Property="DevCo:ButtonDropDown.PartVisibility" Value="HeaderOnly">
        <Setter TargetName="PART_ButtonImage" Value="{x:Static Visibility.Collapsed}"
                Property="UIElement.Visibility"/>
        <Setter TargetName="PART_ButtonContent" Value="{x:Static Visibility.Visible}"
                Property="UIElement.Visibility"/>
      </Trigger>
      <Trigger Property="DevCo:ButtonDropDown.Image" Value="{x:Null}">
        <Setter TargetName="PART_ButtonImage" Value="{x:Static Visibility.Collapsed}"
                Property="UIElement.Visibility"/>
      </Trigger>
      <Trigger SourceName="PART_Popup" Property="Popup.HasDropShadow" Value="True">
        <Setter TargetName="Shdw" Property="FrameworkElement.Margin" Value="0,0,5,5"/>
        <Setter TargetName="Shdw" Property="WinTheme:SystemDropShadowChrome.Color" Value="#71000000"/>
      </Trigger>
      <Trigger Property="UIElement.IsEnabled" Value="False">
        <Setter Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.ButtonDisabledForeground}}}"
                Property="TextElement.Foreground"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style x:Key="{ComponentResourceKey {x:Type DevCo:Gallery}, GalleryMenuScrollViewer}"
         TargetType="{x:Type ScrollViewer}">
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible"/>
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ScrollViewer}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ScrollContentPresenter Grid.Row="0" Grid.Column="0" CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                    Content="{TemplateBinding ContentControl.Content}"/>
            <ScrollBar Name="PART_VerticalScrollBar" Orientation="Vertical" Grid.Row="0" Grid.Column="1" Minimum="0"
                       Maximum="{TemplateBinding ScrollViewer.ScrollableHeight}"
                       Value="{TemplateBinding ScrollViewer.VerticalOffset}"
                       ViewportSize="{TemplateBinding ScrollViewer.ViewportHeight}"
                       Visibility="{TemplateBinding ScrollViewer.ComputedVerticalScrollBarVisibility}"
                       Style="{DynamicResource {ComponentResourceKey ResourceId=GalleryScrollBar, TypeInTargetAssembly=DevCo:Gallery}}"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{ComponentResourceKey {x:Type DevCo:Gallery}, GalleryThumb}" TargetType="{x:Type Thumb}">
    <Setter Property="FrameworkElement.MinWidth" Value="7"/>
    <Setter Property="FrameworkElement.MinHeight" Value="7"/>
    <Setter Property="Control.Background" Value="Transparent"/>
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Grid SnapsToDevicePixels="true" Background="{TemplateBinding Control.Background}">
            <Path HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"
                  Data="M 7,0 L 7,7 0,7 0,4 4,4 4,0 Z">
              <Shape.Fill>
                <DrawingBrush Viewbox="0,0,4,4" Viewport="0,0,4,4" TileMode="Tile" ViewportUnits="Absolute"
                              ViewboxUnits="Absolute">
                  <DrawingBrush.Drawing>
                    <DrawingGroup>
                      <DrawingGroup.Children>
                        <GeometryDrawing Brush="Transparent">
                          <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,1,1"/>
                          </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Geometry="M 1,1 L 3,1 3,3 1,3 Z"
                                         Brush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryResizeThumbLight}}}"/>
                        <GeometryDrawing Geometry="M 0,0 L 2,0 2,2 0,2 Z"
                                         Brush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.GalleryResizeThumbDark}}}"/>
                      </DrawingGroup.Children>
                    </DrawingGroup>
                  </DrawingBrush.Drawing>
                </DrawingBrush>
              </Shape.Fill>
            </Path>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
