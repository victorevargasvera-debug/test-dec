<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dc="clr-namespace:DevComponents.WpfRibbon">
  <Style TargetType="{x:Type dc:AdvWindow}">
    <Setter Property="Window.SizeToContent" Value="Manual"/>
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Name="PART_WindowBorder" CornerRadius="5, 5, 0, 0" BorderThickness="1,1,1,1" ClipToBounds="True"
                  SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"
                  BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveBorder}}}"
                  Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.AdvWindowBackground}}}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition x:Name="TitleRow" Height="26"/>
                <RowDefinition Height="2"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Border Name="WindowTitle" CornerRadius="5,5,0,0" Grid.Row="0"
                      Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveTitleBackground}}}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition/>
                  </Grid.RowDefinitions>
                  <Image Name="WinIcon" Margin="3,0,0,0" Width="16" Height="16" Grid.Column="0" Grid.Row="0"
                         Source="{TemplateBinding Window.Icon}" VerticalAlignment="Center"/>
                  <TextBlock Name="WindowTitleText" Text="{TemplateBinding Window.Title}" TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" Margin="5,0,5,0" Grid.Column="1" Grid.Row="0"
                             Foreground="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveTitleText}}}"/>
                  <StackPanel Orientation="Horizontal" Grid.Column="2" Grid.Row="0" Margin="0,2,0,0">
                    <Button Name="PART_SysMinimizeButton" VerticalAlignment="Top" Visibility="Visible" Focusable="False"
                            Command="dc:AdvWindow.MinimizeWindow"
                            Style="{DynamicResource {ComponentResourceKey ResourceId=TitleButton, TypeInTargetAssembly=dc:RibbonBackgroundChrome}}">
                      <Canvas Width="9" Height="9">
                        <Line X1="0" Y1="6" X2="8" Y2="6" StrokeThickness="1"
                              Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground1}}}"/>
                        <Line X1="0" Y1="7" X2="8" Y2="7" StrokeThickness="1"
                              Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground2}}}"/>
                        <Line X1="0" Y1="8" X2="8" Y2="8" StrokeThickness="1"
                              Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground3}}}"/>
                      </Canvas>
                    </Button>
                    <Button Name="PART_SysMaximizeButton" VerticalAlignment="Top" Visibility="Visible" Focusable="False"
                            Command="dc:AdvWindow.MaximizeWindow"
                            Style="{DynamicResource {ComponentResourceKey ResourceId=TitleButton, TypeInTargetAssembly=dc:RibbonBackgroundChrome}}">
                      <Canvas Width="9" Height="9">
                        <Line X1="0" Y1="1.5" X2="9" Y2="1.5" StrokeThickness="1"
                              Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground1}}}"/>
                        <Rectangle Canvas.Top="2" Canvas.Left="0" StrokeThickness="1" Width="9" Height="6"
                                   Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground2}}}"/>
                        <Line X1="1" Y1="3" X2="8" Y2="3" StrokeThickness="1"
                              Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground2}}}"/>
                        <Line X1="1" Y1="4" X2="8" Y2="4" StrokeThickness="1"
                              Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground3}}}"/>
                        <Line X1="0" Y1="8" X2="9" Y2="8" StrokeThickness="1"
                              Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground3}}}"/>
                      </Canvas>
                    </Button>
                    <Button Name="PART_SysRestoreButton" VerticalAlignment="Top" Visibility="Collapsed" Focusable="False"
                            Command="dc:AdvWindow.RestoreWindow"
                            Style="{DynamicResource {ComponentResourceKey ResourceId=TitleButton, TypeInTargetAssembly=dc:RibbonBackgroundChrome}}">
                      <Canvas Width="9" Height="8">
                        <Line X1="2" Y1="1.5" X2="9" Y2="1.5" StrokeThickness="1"
                              Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground1}}}"/>
                        <Rectangle Canvas.Top="2" Canvas.Left="6" StrokeThickness="1" Width="3" Height="5"
                                   Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground2}}}"/>
                        <Line X1="3" Y1="3" X2="8" Y2="3" StrokeThickness="1"
                              Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground3}}}"/>
                        <Line X1="2" Y1="7" X2="8" Y2="7" StrokeThickness="1"
                              Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground3}}}"/>
                        <Line X1="0" Y1="2.5" X2="7" Y2="2.5" StrokeThickness="1"
                              Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground1}}}"/>
                        <Rectangle Canvas.Top="3" Canvas.Left="0" StrokeThickness="1" Width="7" Height="5"
                                   Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground2}}}"/>
                        <Line X1="1" Y1="4" X2="6" Y2="4" StrokeThickness="1"
                              Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground3}}}"/>
                        <Line X1="0" Y1="8" X2="6" Y2="8" StrokeThickness="1"
                              Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground3}}}"/>
                      </Canvas>
                    </Button>
                    <Button Name="PART_SysCloseButton" VerticalAlignment="Top" Visibility="Visible" Focusable="False"
                            Command="dc:AdvWindow.CloseWindow"
                            Style="{DynamicResource {ComponentResourceKey ResourceId=TitleButton, TypeInTargetAssembly=dc:RibbonBackgroundChrome}}">
                      <Canvas Width="11" Height="9" SnapsToDevicePixels="True">
                        <Path StrokeThickness="1" Data="M 0,8 L 4,8 5,6 7,8 11,8 "
                              Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground3}}}"/>
                        <Path Data="M 1,0 L 4,0 5,2 7,0 10,0 7,4 7,5 10,8 7,8 5,6 4,8 1,8 4,5 4,4 Z"
                              Fill="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground2}}}"/>
                        <Path StrokeThickness="1" Data="M 1,0.5 L 4,0.5 5,2.5 7,0.5 10,0.5 "
                              Stroke="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground1}}}"/>
                      </Canvas>
                    </Button>
                  </StackPanel>
                </Grid>
              </Border>
              <Border BorderThickness="0,1,0,0" Grid.Row="1"
                      BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveTitleDiv1}}}"
                      Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveTitleDiv2}}}"/>
              <Border Name="WindowInnerBorder" BorderThickness="6,0,6,6" Grid.Row="2"
                      BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveInnerBorder}}}">
                <Grid>
                  <AdornerDecorator>
                    <ContentPresenter ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}"
                                      Content="{TemplateBinding ContentControl.Content}"/>
                  </AdornerDecorator>
                  <ResizeGrip Name="WindowResizeGrip" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                              Visibility="Collapsed" IsTabStop="false"/>
                </Grid>
              </Border>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Window.IsActive" Value="False">
              <Setter TargetName="PART_WindowBorder"
                      Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowInactiveBorder}}}"
                      Property="Border.BorderBrush"/>
              <Setter TargetName="WindowTitleText"
                      Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowInactiveTitleText}}}"
                      Property="TextBlock.Foreground"/>
              <Setter TargetName="WindowTitle"
                      Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowInactiveTitleBackground}}}"
                      Property="Border.Background"/>
              <Setter TargetName="WindowInnerBorder"
                      Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowInactiveInnerBorder}}}"
                      Property="Border.BorderBrush"/>
            </Trigger>
            <Trigger Value="{x:Null}" Property="Window.Icon">
              <Setter TargetName="WinIcon" Property="UIElement.Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="Window.WindowState" Value="Maximized">
              <Setter TargetName="PART_SysMaximizeButton" Property="UIElement.Visibility" Value="Collapsed"/>
              <Setter TargetName="PART_SysRestoreButton" Property="UIElement.Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="Window.ResizeMode" Value="NoResize">
              <Setter TargetName="PART_SysMinimizeButton" Property="UIElement.Visibility" Value="Collapsed"/>
              <Setter TargetName="PART_SysMaximizeButton" Property="UIElement.Visibility" Value="Collapsed"/>
              <Setter TargetName="PART_SysRestoreButton" Property="UIElement.Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="Window.ResizeMode" Value="CanMinimize">
              <Setter TargetName="PART_SysMaximizeButton" Property="UIElement.Visibility" Value="Collapsed"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Window.ResizeMode" Value="CanResizeWithGrip"/>
                <Condition Property="Window.WindowState" Value="Normal"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="WindowResizeGrip" Property="UIElement.Visibility" Value="Visible"/>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="dc:AdvWindow.EffectiveStyle" Value="Office2010">
        <Setter Property="Control.Template"
                Value="{DynamicResource {ComponentResourceKey ResourceId=Office2010AdvWindow, TypeInTargetAssembly=dc:AdvWindow}}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <ControlTemplate x:Key="{ComponentResourceKey {x:Type dc:AdvWindow}, Office2010AdvWindow}"
                   TargetType="{x:Type dc:AdvWindow}">
    <Border Name="PART_WindowBorder" CornerRadius="5, 5, 0, 0" BorderThickness="1,1,1,1" ClipToBounds="True"
            SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"
            BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveBorder}}}"
            Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.AdvWindowBackground}}}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition x:Name="TitleRow" Height="26"/>
          <RowDefinition Height="2"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Name="WindowTitle" CornerRadius="5,5,0,0" Grid.Row="0"
                Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveTitleBackground}}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition/>
            </Grid.RowDefinitions>
            <Image Name="WinIcon" Margin="3,0,0,0" Width="16" Height="16" Grid.Column="0" Grid.Row="0"
                   Source="{TemplateBinding Window.Icon}" VerticalAlignment="Center"/>
            <TextBlock Name="WindowTitleText" Text="{TemplateBinding Window.Title}" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" Margin="5,0,5,0" Grid.Column="1" Grid.Row="0"
                       Foreground="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveTitleText}}}"/>
            <StackPanel Orientation="Horizontal" Grid.Column="2" Grid.Row="0" Margin="0,2,0,0">
              <Button Name="PART_SysMinimizeButton" VerticalAlignment="Top" Focusable="False"
                      ToolTipService.ShowOnDisabled="True" Command="dc:AdvWindow.MinimizeWindow"
                      Style="{DynamicResource {ComponentResourceKey ResourceId=TitleButton, TypeInTargetAssembly=dc:RibbonBackgroundChrome}}">
                <FrameworkElement.ToolTip>
                  <ToolTip Content="{DynamicResource {ComponentResourceKey ResourceId=MinimizeButtonTooltip, TypeInTargetAssembly=dc:Ribbon}}"/>
                </FrameworkElement.ToolTip>
                <Border Margin="0,4,0,0" BorderThickness="1" CornerRadius="1" Width="11" Height="5"
                        BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground1}}}"
                        Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground2}}}"/>
              </Button>
              <Button Name="PART_SysMaximizeButton" VerticalAlignment="Top" Focusable="False"
                      ToolTipService.ShowOnDisabled="True" Command="dc:AdvWindow.MaximizeWindow"
                      Style="{DynamicResource {ComponentResourceKey ResourceId=TitleButton, TypeInTargetAssembly=dc:RibbonBackgroundChrome}}">
                <FrameworkElement.ToolTip>
                  <ToolTip Content="{DynamicResource {ComponentResourceKey ResourceId=MaximizeButtonTooltip, TypeInTargetAssembly=dc:Ribbon}}"/>
                </FrameworkElement.ToolTip>
                <Border BorderThickness="1" CornerRadius="1" Width="11" Height="9"
                        BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground1}}}"
                        Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground2}}}">
                  <Border Width="5" Height="3" Margin="2" BorderThickness="1"
                          Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveTitleBackground}}}"
                          BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground1}}}"/>
                </Border>
              </Button>
              <Button Name="PART_SysRestoreButton" VerticalAlignment="Top" Visibility="Collapsed" Focusable="False"
                      ToolTipService.ShowOnDisabled="True" Command="dc:AdvWindow.RestoreWindow"
                      Style="{DynamicResource {ComponentResourceKey ResourceId=TitleButton, TypeInTargetAssembly=dc:RibbonBackgroundChrome}}">
                <FrameworkElement.ToolTip>
                  <ToolTip Content="{DynamicResource {ComponentResourceKey ResourceId=RestoreButtonTooltip, TypeInTargetAssembly=dc:Ribbon}}"/>
                </FrameworkElement.ToolTip>
                <Grid Width="12" Height="11">
                  <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="4,0,0,0" BorderThickness="1"
                          CornerRadius="1" Width="8" Height="8"
                          BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground1}}}"
                          Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground2}}}">
                    <Border Width="4" Height="3" Margin="1,2,1,1" BorderThickness="1"
                            Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveTitleBackground}}}"
                            BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground1}}}"/>
                  </Border>
                  <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,3,0,0" BorderThickness="1"
                          CornerRadius="1" Width="8" Height="8"
                          BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground1}}}"
                          Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground2}}}">
                    <Border Width="4" Height="3" Margin="1,2,1,1" BorderThickness="1"
                            Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveTitleBackground}}}"
                            BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveSystemButtonForeground1}}}"/>
                  </Border>
                </Grid>
              </Button>
              <Button Name="PART_SysCloseButton" VerticalAlignment="Top" Focusable="False"
                      ToolTipService.ShowOnDisabled="True" Command="dc:AdvWindow.CloseWindow"
                      Style="{DynamicResource {ComponentResourceKey ResourceId=TitleButton2010Close, TypeInTargetAssembly=dc:RibbonBackgroundChrome}}">
                <FrameworkElement.ToolTip>
                  <ToolTip Content="{DynamicResource {ComponentResourceKey ResourceId=CloseButtonTooltip, TypeInTargetAssembly=dc:Ribbon}}"/>
                </FrameworkElement.ToolTip>
                <Canvas Width="11" Height="9" SnapsToDevicePixels="True">
                  <Path SnapsToDevicePixels="True" Width="11" Height="9" StrokeThickness="1"
                        Data="M 0.5,0.5 L 3,0.5 5,2 7,0.5 9,0.5 10,1 7,4 10,7 9,8.5 7,8.5 5,6 3,8.5 1,8.5 0,7.5 3,4 0,1 0.5,0.5 Z"
                        Stroke="{Binding Path=BorderBrush, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Button}}}"
                        Fill="{Binding Path=Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Button}}}"/>
                </Canvas>
              </Button>
            </StackPanel>
          </Grid>
        </Border>
        <Border BorderThickness="0,1,0,0" Grid.Row="1"
                BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveTitleDiv1}}}"
                Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveTitleDiv2}}}"/>
        <Border Name="WindowInnerBorder" BorderThickness="6,0,6,6" Grid.Row="2"
                BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowActiveInnerBorder}}}">
          <Grid>
            <AdornerDecorator>
              <ContentPresenter ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}"
                                Content="{TemplateBinding ContentControl.Content}"/>
            </AdornerDecorator>
            <ResizeGrip Name="WindowResizeGrip" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Visibility="Collapsed" IsTabStop="false"/>
          </Grid>
        </Border>
      </Grid>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="Window.IsActive" Value="False">
        <Setter TargetName="PART_WindowBorder"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowInactiveBorder}}}"
                Property="Border.BorderBrush"/>
        <Setter TargetName="WindowTitleText"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowInactiveTitleText}}}"
                Property="TextBlock.Foreground"/>
        <Setter TargetName="WindowTitle"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowInactiveTitleBackground}}}"
                Property="Border.Background"/>
        <Setter TargetName="WindowInnerBorder"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.WindowInactiveInnerBorder}}}"
                Property="Border.BorderBrush"/>
      </Trigger>
      <Trigger Value="{x:Null}" Property="Window.Icon">
        <Setter TargetName="WinIcon" Property="UIElement.Visibility" Value="Collapsed"/>
      </Trigger>
      <Trigger Property="Window.WindowState" Value="Maximized">
        <Setter TargetName="PART_SysMaximizeButton" Property="UIElement.Visibility" Value="Collapsed"/>
        <Setter TargetName="PART_SysRestoreButton" Property="UIElement.Visibility" Value="Visible"/>
      </Trigger>
      <Trigger Property="Window.ResizeMode" Value="NoResize">
        <Setter TargetName="PART_SysMinimizeButton" Property="UIElement.Visibility" Value="Collapsed"/>
        <Setter TargetName="PART_SysMaximizeButton" Property="UIElement.Visibility" Value="Collapsed"/>
        <Setter TargetName="PART_SysRestoreButton" Property="UIElement.Visibility" Value="Collapsed"/>
      </Trigger>
      <Trigger Property="Window.ResizeMode" Value="CanMinimize">
        <Setter TargetName="PART_SysMaximizeButton" Property="UIElement.Visibility" Value="Collapsed"/>
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="Window.ResizeMode" Value="CanResizeWithGrip"/>
          <Condition Property="Window.WindowState" Value="Normal"/>
        </MultiTrigger.Conditions>
        <Setter TargetName="WindowResizeGrip" Property="UIElement.Visibility" Value="Visible"/>
      </MultiTrigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
</ResourceDictionary>