<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:DevCo="clr-namespace:DevComponents.WpfRibbon">
  <Style TargetType="{x:Type DevCo:ContextGroup}">
    <Style.Triggers>
      <Trigger Property="DevCo:ContextGroup.IsSimpleContent" Value="True">
        <Setter Property="Control.Template"
                Value="{DynamicResource {ComponentResourceKey ResourceId=ContextGroupContentLabel, TypeInTargetAssembly=DevCo:ContextGroup}}"/>
      </Trigger>
    </Style.Triggers>
    <Setter Property="Control.Background"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.ContextGroupOrangeBackground}}}"/>
    <Setter Property="Control.BorderBrush"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.ContextGroupOrangeBorder}}}"/>
    <Setter Property="UIElement.Focusable" Value="False"/>
    <Setter Property="Control.Foreground"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.ContextGroupOrangeForeground}}}"/>
    <Setter Property="Control.Template"
            Value="{DynamicResource {ComponentResourceKey ResourceId=ContextGroupContentObject, TypeInTargetAssembly=DevCo:ContextGroup}}"/>
  </Style>
  <ControlTemplate x:Key="{ComponentResourceKey {x:Type DevCo:ContextGroup}, ContextGroupContentObject}"
                   TargetType="{x:Type DevCo:ContextGroup}">
    <Border BorderThickness="1,0,1,0" BorderBrush="{TemplateBinding Control.BorderBrush}">
      <DockPanel LastChildFill="True">
        <Border Height="20" DockPanel.Dock="Bottom"/>
        <Border Background="{TemplateBinding Control.Background}">
          <ContentPresenter SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"
                            Content="{TemplateBinding ContentControl.Content}" Margin="3,5,3,0"
                            TextElement.Foreground="{TemplateBinding Control.Foreground}" VerticalAlignment="Center"/>
        </Border>
      </DockPanel>
    </Border>
  </ControlTemplate>
  <ControlTemplate x:Key="{ComponentResourceKey {x:Type DevCo:ContextGroup}, ContextGroupContentLabel}"
                   TargetType="{x:Type DevCo:ContextGroup}">
    <Border BorderThickness="1,0,1,0" BorderBrush="{TemplateBinding Control.BorderBrush}">
      <DockPanel LastChildFill="True">
        <Border Height="20" DockPanel.Dock="Bottom"/>
        <Border Background="{TemplateBinding Control.Background}">
          <Label Name="PART_LabelContent" Foreground="{TemplateBinding Control.Foreground}"
                 SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" Margin="3,5,3,0"
                 VerticalAlignment="Center" Content="{TemplateBinding ContentControl.Content}"/>
        </Border>
      </DockPanel>
    </Border>
  </ControlTemplate>
</ResourceDictionary>