<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dc="clr-namespace:DevComponents.WpfRibbon">
  <Style TargetType="{x:Type dc:NavigationPaneCustomizeButton}">
    <Setter Property="Control.Foreground"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemNormalForeground}}}"/>
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True"/>
    <Setter Property="UIElement.Focusable" Value="False"/>
    <Setter Property="Control.Padding" Value="7"/>
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Name="ItemBorder" Background="Transparent" Cursor="Hand"
                  Padding="{TemplateBinding Control.Padding}">
            <Canvas Width="5" Height="5">
              <Path Data="M 0,1 L 5,1 2.5,4 Z"
                    Fill="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemCustomizeForegroundHighlight}}}"/>
              <Path Data="M 0,0 L 5,0 2.5,3 Z" Fill="{TemplateBinding TextElement.Foreground}"/>
            </Canvas>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="ItemBorder"
                      Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemMouseOverBackground}}}"
                      Property="Border.Background"/>
            </Trigger>
            <Trigger Property="ButtonBase.IsPressed" Value="True">
              <Setter TargetName="ItemBorder"
                      Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemMouseDownBackground}}}"
                      Property="Border.Background"/>
            </Trigger>
            <Trigger Property="dc:NavigationPaneCustomizeButton.IsCustomizeMenuOpen" Value="True">
              <Setter TargetName="ItemBorder"
                      Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:NavigationPane, ResourceId={x:Static dc:NavigationPaneColors.PaneItemSelectedBackground}}}"
                      Property="Border.Background"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <ContextMenu x:Key="{ComponentResourceKey {x:Type dc:NavigationPane}, NavPaneCustomizeContextMenu}"
               x:Shared="false"
               Style="{DynamicResource {ComponentResourceKey ResourceId=FlatContextMenu, TypeInTargetAssembly=dc:Ribbon}}">
    <MenuItem Header="{x:Static dc:NavigationPane.SystemShowMoreButtonsMenuItem}"
              Style="{DynamicResource {ComponentResourceKey ResourceId=FlatMenuItem, TypeInTargetAssembly=dc:Ribbon}}">
      <MenuItem.Icon>
        <Image Source="images/NavPaneShowMore.png" Stretch="None"/>
      </MenuItem.Icon>
    </MenuItem>
    <MenuItem Header="{x:Static dc:NavigationPane.SystemShowFewerButtonsMenuItem}"
              Style="{DynamicResource {ComponentResourceKey ResourceId=FlatMenuItem, TypeInTargetAssembly=dc:Ribbon}}">
      <MenuItem.Icon>
        <Image Source="images/NavPaneShowLess.png" Stretch="None"/>
      </MenuItem.Icon>
    </MenuItem>
  </ContextMenu>
</ResourceDictionary>