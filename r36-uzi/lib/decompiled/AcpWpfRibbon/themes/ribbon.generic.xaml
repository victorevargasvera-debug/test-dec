                 Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.RibbonSeparatorBackground}}}"
                 BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.RibbonSeparatorBorder}}}"/>
      <Popup Name="PART_Popup" Placement="Bottom" VerticalOffset="-3" HorizontalOffset="2" Focusable="False"
