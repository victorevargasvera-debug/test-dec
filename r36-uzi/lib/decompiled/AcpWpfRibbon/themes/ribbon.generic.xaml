<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dc="clr-namespace:DevComponents.WpfRibbon"
                    xmlns:WinTheme="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Luna">
  <Style TargetType="{x:Type dc:Ribbon}">
    <Setter Property="Control.Foreground"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.RibbonTabForeground}}}"/>
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True"/>
    <Setter Property="UIElement.Focusable" Value="False"/>
    <Setter Property="Control.FontSize" Value="8.25pt"/>
    <Setter Property="dc:Ribbon.IsCustomizable" Value="True"/>
    <Setter Property="Control.Template"
            Value="{DynamicResource {ComponentResourceKey ResourceId=Office2007, TypeInTargetAssembly=dc:Ribbon}}"/>
    <Style.Triggers>
      <Trigger Property="dc:Ribbon.EffectiveStyle" Value="Office2010">
        <Setter Property="Control.Template"
                Value="{DynamicResource {ComponentResourceKey ResourceId=Office2010, TypeInTargetAssembly=dc:Ribbon}}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <ControlTemplate x:Key="{ComponentResourceKey {x:Type dc:Ribbon}, Office2010}" TargetType="{x:Type dc:Ribbon}">
    <StackPanel Orientation="Vertical" ClipToBounds="True" KeyboardNavigation.TabNavigation="None"
                FocusManager.IsFocusScope="False"
                SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}">
      <dc:RibbonContentPanel Name="PART_RCP" WindowBorderThickness="{TemplateBinding dc:Ribbon.WindowBorderThickness}"
                             IsGlassEnabled="{Binding Path=IsUsingGlass, RelativeSource={RelativeSource TemplatedParent}}">
        <ContentPresenter Name="PART_ApplicationMenu" ContentSource="ApplicationMenu" Margin="1,1,1,1"
                          VerticalAlignment="Top" Content="{TemplateBinding dc:Ribbon.ApplicationMenu}"
                          dc:RibbonContentPanel.ContentPart="ApplicationMenu"/>
        <ContentPresenter Name="PART_QAT" ContentSource="QuickAccessToolbar" Margin="1,1,1,1" VerticalAlignment="Top"
                          SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"
                          Content="{TemplateBinding dc:Ribbon.QuickAccessToolbar}"
                          dc:RibbonContentPanel.ContentPart="QuickAccessToolbar"/>
        <dc:RibbonTabPanel Name="PART_RibbonTabPanel" dc:RibbonContentPanel.ContentPart="Tabs" IsItemsHost="True"
                           KeyboardNavigation.TabIndex="1" KeyboardNavigation.DirectionalNavigation="Cycle"/>
      </dc:RibbonContentPanel>
      <dc:RibbonBorder Name="PART_RibbonPanelBorder" BorderThickness="0,1,0,1" LightBorderThickness="0"
                       AutoAnimation="False" InnerBorder="True" IsRibbonPanel="True" SnapsToDevicePixels="True"
                       CornerRadius="0" Padding="1,1,1,1" Margin="0"
                       BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.RibbonPanelBorder}}}"
                       LightBorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.RibbonPanelBorderLight}}}"
                       Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.RibbonPanelBackground}}}"
                       TopHighlight="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.RibbonPanelTopHighlight}}}">
        <ContentPresenter Name="PART_TabContentHost" ContentSource="SelectedContent"
                          SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"
                          ContentTemplate="{TemplateBinding dc:Ribbon.SelectedContentTemplate}"
                          Content="{TemplateBinding dc:Ribbon.SelectedContent}"/>
      </dc:RibbonBorder>
