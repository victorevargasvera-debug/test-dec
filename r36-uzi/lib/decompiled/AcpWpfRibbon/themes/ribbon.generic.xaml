        </WinTheme:SystemDropShadowChrome>
      </Popup>
      <dc:RibbonBorder Name="PART_RibbonQatBelowBorder" BorderThickness="1" LightBorderThickness="1" AutoAnimation="False"
                       SnapsToDevicePixels="True" CornerRadius="2" Visibility="Collapsed"
                       Margin="{TemplateBinding dc:Ribbon.HorizontalWindowBorderThickness}"
                       BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.QatBelowBorder}}}"
                       LightBorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.QatBelowBorderLight}}}"
                       Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.QatBelowBackground}}}"/>
    </StackPanel>
    <ControlTemplate.Triggers>
      <Trigger SourceName="PART_Popup" Property="Popup.HasDropShadow" Value="True">
        <Setter TargetName="Shdw" Property="FrameworkElement.Margin" Value="0,0,5,5"/>
        <Setter TargetName="Shdw" Property="WinTheme:SystemDropShadowChrome.Color">
          <Setter.Value>
            <Color>#71000000</Color>
          </Setter.Value>
        </Setter>
      </Trigger>
      <Trigger Value="{x:Null}" Property="dc:Ribbon.ApplicationMenu">
        <Setter TargetName="PART_ApplicationMenu" Property="UIElement.Visibility" Value="Collapsed"/>
      </Trigger>
      <Trigger Value="{x:Null}" Property="dc:Ribbon.QuickAccessToolbar">
        <Setter TargetName="PART_QAT" Property="UIElement.Visibility" Value="Collapsed"/>
      </Trigger>
      <Trigger Property="dc:RibbonTab.TabColor" Value="Green">
        <Setter TargetName="PART_RibbonPanelBorder"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.RibbonPanelGreenBackground}}}"
                Property="dc:RibbonBorder.Background"/>
        <Setter TargetName="PART_RibbonPanelBorder"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.RibbonPanelGreenBorder}}}"
