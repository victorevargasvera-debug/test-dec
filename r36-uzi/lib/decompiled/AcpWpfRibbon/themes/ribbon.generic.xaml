                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.RibbonPanelOrangeTopHighlight}}}"
                Property="dc:RibbonBorder.TopHighlight"/>
      </Trigger>
      <Trigger Property="dc:RibbonTab.TabColor" Value="Red">
