                Property="dc:RibbonBorder.LightBorderBrush"/>
        <Setter TargetName="PART_RibbonPanelBorder"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.RibbonPanelGreenTopHighlight}}}"
