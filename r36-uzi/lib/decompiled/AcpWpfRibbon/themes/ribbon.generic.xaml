        <Setter TargetName="PART_RibbonPopupBorder"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.RibbonPanelOrangeBackground}}}"
                Property="dc:RibbonBorder.Background"/>
