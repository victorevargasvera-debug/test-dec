                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.RibbonPanelRedBackground}}}"
                Property="dc:RibbonBorder.Background"/>
        <Setter TargetName="PART_RibbonPanelBorder"
