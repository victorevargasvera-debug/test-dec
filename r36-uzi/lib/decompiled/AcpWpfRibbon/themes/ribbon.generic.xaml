         TargetType="{x:Type RepeatButton}">
    <Setter Property="Control.Foreground"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.ScrollButtonNormalForeground}}}"/>
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <dc:ButtonBorder Name="PART_ScrollButtonBorder" BorderThickness="1,1,1,1" SnapsToDevicePixels="True"
                           CornerRadius="0,2,2,0" Padding="{TemplateBinding Control.Padding}"
                           ColorClass="{x:Static dc:RibbonColors.ScrollButtonClass}"
                           BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.ScrollButtonNormalBorder}}}"
                           LightBorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.ScrollButtonNormalBorderLight}}}"
                           Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.ScrollButtonNormalBackground}}}"
                           TopHighlight="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.ScrollButtonNormalTopHighlight}}}"
                           BottomHighlight="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.ScrollButtonNormalBottomHighlight}}}">
            <Path Name="PART_ScrollButtonSign" Data="M 0,0 L 4,3.5 0,7 Z"
                  Fill="{TemplateBinding TextElement.Foreground}" VerticalAlignment="Center"
                  HorizontalAlignment="Center"/>
          </dc:ButtonBorder>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="PART_ScrollButtonBorder" Property="dc:ButtonBorder.ButtonState" Value="Hover"/>
            </Trigger>
            <Trigger Property="FrameworkElement.Tag" Value="LeftScroll">
              <Setter TargetName="PART_ScrollButtonBorder" Property="dc:ButtonBorder.CornerRadius" Value="2,0,0,2"/>
              <Setter TargetName="PART_ScrollButtonSign" Property="FrameworkElement.LayoutTransform">
                <Setter.Value>
                  <RotateTransform Angle="180"/>
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>