<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mwt="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero"
                    xmlns:s="clr-namespace:System;assembly=mscorlib"
                    xmlns:DevCo="clr-namespace:DevComponents.WpfRibbon">
  <Style TargetType="{x:Type Separator}">
    <Setter Property="Control.Background"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.SeparatorBackground}}}"/>
    <Setter Property="Control.BorderBrush"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.SeparatorBorder}}}"/>
    <Setter Property="Control.BorderThickness" Value="0,1,0,0"/>
    <Setter Property="FrameworkElement.MinHeight" Value="2"/>
    <Setter Property="UIElement.SnapsToDevicePixels" Value="true"/>
    <Setter Property="Control.Padding" Value="30,0,1,0"/>
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Separator}">
          <Border Margin="{TemplateBinding Control.Padding}" Background="{TemplateBinding Control.Background}"
                  BorderBrush="{TemplateBinding Control.BorderBrush}"
                  BorderThickness="{TemplateBinding Control.BorderThickness}" SnapsToDevicePixels="True"/>
          <ControlTemplate.Triggers>
            <Trigger Property="DevCo:Ribbon.ElementRole" Value="AppMenuDocumentCommand">
              <Setter Property="Control.Padding" Value="40,0,0,0"/>
            </Trigger>
            <Trigger Property="DevCo:Ribbon.ElementRole" Value="AppMenuMruItem">
              <Setter Property="FrameworkElement.Margin" Value="0,0,0,0"/>
              <Setter Property="Control.Padding" Value="0"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{ComponentResourceKey {x:Type DevCo:Ribbon}, StatusBarSeparator}"
         TargetType="{x:Type Separator}">
    <Setter Property="Control.Background"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.StatusBarSeparatorBackground}}}"/>
    <Setter Property="Control.BorderBrush"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.StatusBarSeparatorBorder}}}"/>
    <Setter Property="Control.BorderThickness" Value="0,0,1,0"/>
    <Setter Property="FrameworkElement.MinWidth" Value="2"/>
    <Setter Property="FrameworkElement.MinHeight" Value="6"/>
    <Setter Property="FrameworkElement.VerticalAlignment" Value="Stretch"/>
    <Setter Property="UIElement.SnapsToDevicePixels" Value="true"/>
    <Setter Property="Control.Padding" Value="0"/>
    <Setter Property="FrameworkElement.Margin" Value="0,0,0,0"/>
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Separator}">
          <Border Margin="{TemplateBinding Control.Padding}" Background="{TemplateBinding Control.Background}"
                  BorderBrush="{TemplateBinding Control.BorderBrush}"
                  BorderThickness="{TemplateBinding Control.BorderThickness}" SnapsToDevicePixels="True"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{ComponentResourceKey {x:Type DevCo:Ribbon}, VerticalSeparator}"
         TargetType="{x:Type Separator}">
    <Setter Property="Control.Background"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.StatusBarSeparatorBackground}}}"/>
    <Setter Property="Control.BorderBrush"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=DevCo:Ribbon, ResourceId={x:Static DevCo:RibbonColors.StatusBarSeparatorBorder}}}"/>
    <Setter Property="Control.BorderThickness" Value="0,0,1,0"/>
    <Setter Property="FrameworkElement.MinWidth" Value="2"/>
    <Setter Property="FrameworkElement.MinHeight" Value="6"/>
    <Setter Property="FrameworkElement.VerticalAlignment" Value="Stretch"/>
    <Setter Property="UIElement.SnapsToDevicePixels" Value="true"/>
    <Setter Property="Control.Padding" Value="0"/>
    <Setter Property="FrameworkElement.Margin" Value="0,0,0,0"/>
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Separator}">
          <Border Margin="{TemplateBinding Control.Padding}" Background="{TemplateBinding Control.Background}"
                  BorderBrush="{TemplateBinding Control.BorderBrush}"
                  BorderThickness="{TemplateBinding Control.BorderThickness}" SnapsToDevicePixels="True"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>