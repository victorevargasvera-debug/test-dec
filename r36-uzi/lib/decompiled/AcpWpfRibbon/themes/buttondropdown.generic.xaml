<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dc="clr-namespace:DevComponents.WpfRibbon"
                    xmlns:dcc="clr-namespace:DevComponents.WpfRibbon.Converters"
                    xmlns:WinTheme="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Luna">
  <dcc:ImagePositionToDockConverter x:Key="ImagePositionToDockConverter"/>
  <dcc:ExpandPositionToDockConverter x:Key="ExpandPositionToDockConverter"/>
  <dcc:PopupPlacementConverter x:Key="PopupPlacementConverter"/>
  <StreamGeometry x:Key="ButtonCheckBoxGlyph">
    M0,5.1L1.7,5.2 3.4,7.1 8,0.4 9.2,0 3.3,10.8z
  </StreamGeometry>
  <Style TargetType="{x:Type dc:ButtonDropDown}">
    <Style.Triggers>
      <Trigger Property="dc:ButtonDropDown.IsSimpleHeader" Value="True">
        <Setter Property="Control.Template"
                Value="{DynamicResource {ComponentResourceKey ResourceId=ButtonDropDownLabel, TypeInTargetAssembly=dc:ButtonDropDown}}"/>
      </Trigger>
      <Trigger Property="dc:ButtonDropDown.IsSimpleHeader" Value="False">
        <Setter Property="Control.Template"
                Value="{DynamicResource {ComponentResourceKey ResourceId=ButtonDropDownHeader, TypeInTargetAssembly=dc:ButtonDropDown}}"/>
      </Trigger>
      <Trigger Property="dc:Ribbon.ElementRole" Value="AppMenuDocumentCommand">
        <Setter Property="Control.Padding" Value="4,2,4,2"/>
      </Trigger>
    </Style.Triggers>
    <Setter Property="dc:ButtonDropDown.CommandParameter">
      <Setter.Value>
        <dc:ButtonCommandParameter/>
      </Setter.Value>
    </Setter>
    <Setter Property="Control.VerticalContentAlignment" Value="Center"/>
    <Setter Property="Control.HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Control.Foreground"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.ButtonNormalForeground}}}"/>
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="UIElement.Focusable" Value="true"/>
    <Setter Property="dc:Ribbon.IsCustomizable" Value="True"/>
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True"/>
    <Setter Property="ToolTipService.ShowDuration" Value="20000"/>
  </Style>
  <ControlTemplate x:Key="{ComponentResourceKey {x:Type dc:ButtonDropDown}, ButtonDropDownHeader}"
                   TargetType="{x:Type dc:ButtonDropDown}">
    <dc:ButtonBorder Name="PART_ButtonDropDownBorder" BorderThickness="1,1,1,1"
                     SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"
                     CornerRadius="{TemplateBinding dc:ButtonDropDown.CornerRadius}"
                     Padding="{TemplateBinding Control.Padding}"
                     ColorClass="{TemplateBinding dc:ButtonDropDown.ColorClass}">
      <DockPanel LastChildFill="True">
        <Popup Name="PART_Popup" VerticalOffset="-1" Focusable="False"
               AllowsTransparency="{x:Static dc:Ribbon.PopupAllowsTransparency}"
               PopupAnimation="{DynamicResource {x:Static SystemParameters.MenuPopupAnimationKey}}"
               Placement="{Binding Path=PopupPlacement, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource PopupPlacementConverter}}"
               PlacementTarget="{Binding Path=PopupPlacementTarget, RelativeSource={RelativeSource TemplatedParent}}"
               IsOpen="{Binding Path=IsPopupOpen, RelativeSource={RelativeSource TemplatedParent}}">
          <WinTheme:SystemDropShadowChrome FrameworkElement.Name="Shdw" Color="#00FFFFFF">
            <ContentControl Name="PART_PopupContent" IsTabStop="False"
                            Template="{DynamicResource {ComponentResourceKey ResourceId=PopupTypeMenuContent, TypeInTargetAssembly=dc:ButtonDropDown}}">
              <ScrollViewer CanContentScroll="True"
                            Style="{DynamicResource {ComponentResourceKey ResourceId=MenuScrollViewer, TypeInTargetAssembly=FrameworkElement}}">
                <ItemsPresenter Margin="1" KeyboardNavigation.TabNavigation="Cycle"
                                KeyboardNavigation.DirectionalNavigation="Cycle"
                                SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" Grid.IsSharedSizeScope="True"/>
              </ScrollViewer>
            </ContentControl>
          </WinTheme:SystemDropShadowChrome>
        </Popup>
        <ContentPresenter Name="PART_ButtonImage" ContentSource="RenderImage" Margin="1,1,1,1" VerticalAlignment="Center"
                          SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"
                          Content="{TemplateBinding dc:ButtonDropDown.RenderImage}"
                          DockPanel.Dock="{TemplateBinding dc:ButtonDropDown.ImagePosition, Converter={StaticResource ImagePositionToDockConverter}}"/>
        <dc:ExpandDecorator Name="PART_ButtonExpand" Margin="2,4,2,4" VerticalAlignment="Center" HorizontalAlignment="Center"
                            PopupPlacement="{TemplateBinding dc:ButtonDropDown.PopupPlacement}"
                            Visibility="{TemplateBinding dc:ButtonDropDown.IsExpandVisible}"
                            DockPanel.Dock="{TemplateBinding dc:ButtonDropDown.ExpandPosition, Converter={StaticResource ExpandPositionToDockConverter}}"/>
        <ContentPresenter Name="PART_ButtonContent"
                          HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}"
                          VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}"
                          SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"
                          ContentTemplate="{TemplateBinding HeaderedContentControl.HeaderTemplate}"
                          RecognizesAccessKey="True" Content="{TemplateBinding HeaderedItemsControl.Header}" Margin="3,1,3,1"/>
      </DockPanel>
    </dc:ButtonBorder>
    <ControlTemplate.Triggers>
      <Trigger Property="dc:Ribbon.ElementRole" Value="AppMenuDocumentCommand">
        <Setter TargetName="PART_ButtonExpand" Property="FrameworkElement.Margin" Value="9,2,4,2"/>
      </Trigger>
      <Trigger Property="dc:ButtonDropDown.ImagePosition" Value="Right">
        <Setter Property="Control.HorizontalContentAlignment" Value="Right"/>
        <Setter Property="Control.VerticalContentAlignment" Value="Center"/>
      </Trigger>
      <Trigger Property="dc:ButtonDropDown.ImagePosition" Value="Top">
        <Setter Property="Control.HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Control.VerticalContentAlignment" Value="Top"/>
      </Trigger>
      <Trigger Property="dc:ButtonDropDown.ImagePosition" Value="Bottom">
        <Setter Property="Control.HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Control.VerticalContentAlignment" Value="Bottom"/>
      </Trigger>
      <Trigger Property="dc:ButtonDropDown.PartVisibility" Value="ImageOnly">
        <Setter TargetName="PART_ButtonImage" Value="{x:Static Visibility.Visible}" Property="UIElement.Visibility"/>
        <Setter TargetName="PART_ButtonContent" Value="{x:Static Visibility.Collapsed}"
                Property="UIElement.Visibility"/>
      </Trigger>
      <Trigger Property="dc:ButtonDropDown.PartVisibility" Value="HeaderOnly">
        <Setter TargetName="PART_ButtonImage" Value="{x:Static Visibility.Collapsed}"
                Property="UIElement.Visibility"/>
        <Setter TargetName="PART_ButtonContent" Value="{x:Static Visibility.Visible}"
                Property="UIElement.Visibility"/>
      </Trigger>
      <Trigger Property="dc:ButtonDropDown.RenderImage" Value="{x:Null}">
        <Setter TargetName="PART_ButtonImage" Value="{x:Static Visibility.Collapsed}"
                Property="UIElement.Visibility"/>
      </Trigger>
      <Trigger SourceName="PART_Popup" Property="Popup.HasDropShadow" Value="True">
        <Setter TargetName="Shdw" Property="FrameworkElement.Margin" Value="0,0,5,5"/>
        <Setter TargetName="Shdw" Property="WinTheme:SystemDropShadowChrome.Color" Value="#71000000"/>
      </Trigger>
      <Trigger Property="UIElement.IsEnabled" Value="False">
        <Setter Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.ButtonDisabledForeground}}}"
                Property="TextElement.Foreground"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <ControlTemplate x:Key="{ComponentResourceKey {x:Type dc:ButtonDropDown}, ButtonDropDownLabel}"
                   TargetType="{x:Type dc:ButtonDropDown}">
    <dc:ButtonBorder Name="PART_ButtonDropDownBorder" BorderThickness="1,1,1,1"
                     SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" CornerRadius="2"
                     Padding="{TemplateBinding Control.Padding}"
                     ColorClass="{TemplateBinding dc:ButtonDropDown.ColorClass}">
      <DockPanel LastChildFill="True">
        <Popup Name="PART_Popup" VerticalOffset="-1" Focusable="False"
               AllowsTransparency="{x:Static dc:Ribbon.PopupAllowsTransparency}"
               PopupAnimation="{DynamicResource {x:Static SystemParameters.MenuPopupAnimationKey}}"
               Placement="{Binding Path=PopupPlacement, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource PopupPlacementConverter}}"
               PlacementTarget="{Binding Path=PopupPlacementTarget, RelativeSource={RelativeSource TemplatedParent}}"
               IsOpen="{Binding Path=IsPopupOpen, RelativeSource={RelativeSource TemplatedParent}}">
          <WinTheme:SystemDropShadowChrome FrameworkElement.Name="Shdw" Color="#00FFFFFF">
            <ContentControl Name="PART_PopupContent" IsTabStop="False"
                            Template="{DynamicResource {ComponentResourceKey ResourceId=PopupTypeMenuContent, TypeInTargetAssembly=dc:ButtonDropDown}}">
              <ScrollViewer CanContentScroll="True"
                            Style="{DynamicResource {ComponentResourceKey ResourceId=MenuScrollViewer, TypeInTargetAssembly=FrameworkElement}}">
                <ItemsPresenter Margin="1" KeyboardNavigation.TabNavigation="Cycle"
                                KeyboardNavigation.DirectionalNavigation="Cycle"
                                SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" Grid.IsSharedSizeScope="True"/>
              </ScrollViewer>
            </ContentControl>
          </WinTheme:SystemDropShadowChrome>
        </Popup>
        <ContentPresenter Name="PART_ButtonImage" ContentSource="RenderImage" Margin="1,1,1,1" VerticalAlignment="Center"
                          SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"
                          Content="{TemplateBinding dc:ButtonDropDown.RenderImage}"
                          DockPanel.Dock="{TemplateBinding dc:ButtonDropDown.ImagePosition, Converter={StaticResource ImagePositionToDockConverter}}"/>
        <dc:ExpandDecorator Name="PART_ButtonExpand" Margin="2,2,2,2" VerticalAlignment="Center" HorizontalAlignment="Center"
                            PopupPlacement="{TemplateBinding dc:ButtonDropDown.PopupPlacement}"
                            Visibility="{TemplateBinding dc:ButtonDropDown.IsExpandVisible}"
                            DockPanel.Dock="{TemplateBinding dc:ButtonDropDown.ExpandPosition, Converter={StaticResource ExpandPositionToDockConverter}}"/>
        <TextBlock Name="PART_ButtonContent" TextWrapping="Wrap" Padding="0" Margin="0"
                   HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}"
                   VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" TextAlignment="Center"
                   SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}">
          <AccessText Name="HeaderAccessText" TextWrapping="Wrap" Text="{TemplateBinding HeaderedItemsControl.Header}"
                      SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"/>
          <dc:ExpandDecorator Name="PART_ButtonExpandInline" Margin="3,0,0,2.5" HorizontalAlignment="Left"
                              VerticalAlignment="Center" Visibility="Collapsed"/>
        </TextBlock>
      </DockPanel>
    </dc:ButtonBorder>
    <ControlTemplate.Triggers>
      <Trigger Property="dc:Ribbon.ElementRole" Value="AppMenuDocumentCommand">
        <Setter TargetName="PART_ButtonExpand" Property="FrameworkElement.Margin" Value="9,2,4,2"/>
      </Trigger>
      <Trigger Property="dc:ButtonDropDown.ImagePosition" Value="Right">
        <Setter Property="Control.HorizontalContentAlignment" Value="Right"/>
        <Setter Property="Control.VerticalContentAlignment" Value="Center"/>
      </Trigger>
      <Trigger Property="dc:ButtonDropDown.ImagePosition" Value="Top">
        <Setter Property="Control.HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Control.VerticalContentAlignment" Value="Top"/>
      </Trigger>
      <Trigger Property="dc:ButtonDropDown.ImagePosition" Value="Bottom">
        <Setter Property="Control.HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Control.VerticalContentAlignment" Value="Bottom"/>
      </Trigger>
      <Trigger Property="dc:ButtonDropDown.PartVisibility" Value="ImageOnly">
        <Setter TargetName="PART_ButtonImage" Value="{x:Static Visibility.Visible}" Property="UIElement.Visibility"/>
        <Setter TargetName="PART_ButtonContent" Value="{x:Static Visibility.Collapsed}"
                Property="UIElement.Visibility"/>
      </Trigger>
      <Trigger Property="dc:ButtonDropDown.PartVisibility" Value="HeaderOnly">
        <Setter TargetName="PART_ButtonImage" Value="{x:Static Visibility.Collapsed}"
                Property="UIElement.Visibility"/>
        <Setter TargetName="PART_ButtonContent" Value="{x:Static Visibility.Visible}"
                Property="UIElement.Visibility"/>
      </Trigger>
      <Trigger Property="dc:ButtonDropDown.RenderImage" Value="{x:Null}">
        <Setter TargetName="PART_ButtonImage" Value="{x:Static Visibility.Collapsed}"
                Property="UIElement.Visibility"/>
      </Trigger>
      <Trigger SourceName="PART_Popup" Property="Popup.HasDropShadow" Value="True">
        <Setter TargetName="Shdw" Property="FrameworkElement.Margin" Value="0,0,5,5"/>
        <Setter TargetName="Shdw" Property="WinTheme:SystemDropShadowChrome.Color" Value="#71000000"/>
      </Trigger>
      <Trigger Property="UIElement.IsEnabled" Value="False">
        <Setter Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.ButtonDisabledForeground}}}"
                Property="TextElement.Foreground"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <ControlTemplate x:Key="{ComponentResourceKey {x:Type dc:ButtonDropDown}, PopupTypeMenuContent}"
                   TargetType="{x:Type ContentControl}">
    <Border BorderThickness="1,1,1,1" CornerRadius="3"
            BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.MenuBorder}}}"
            Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.MenuBackground}}}">
      <Grid>
        <Rectangle Margin="1" Width="28" RadiusY="2" HorizontalAlignment="Left" RadiusX="2"
                   Fill="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.MenuSideBackground}}}"/>
        <Rectangle Margin="29,2,0,2" Width="1" HorizontalAlignment="Left"
                   Fill="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.MenuSideLineDark}}}"/>
        <Rectangle Margin="30,2,0,2" Width="1" HorizontalAlignment="Left"
                   Fill="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.MenuSideLineLight}}}"/>
        <ContentPresenter Margin="0,0,0,0" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}"
                          Content="{TemplateBinding ContentControl.Content}" Grid.ColumnSpan="2"/>
      </Grid>
    </Border>
  </ControlTemplate>
  <ControlTemplate x:Key="{ComponentResourceKey {x:Type dc:ButtonDropDown}, PopupTypePopupContent}"
                   TargetType="{x:Type ContentControl}">
    <Border BorderThickness="1,1,1,1" CornerRadius="3"
            BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.PopupBorder}}}"
            Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.PopupBackground}}}">
      <ContentPresenter Margin="1,0,1,0" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}"
                        Content="{TemplateBinding ContentControl.Content}"/>
    </Border>
  </ControlTemplate>
  <Style x:Key="{ComponentResourceKey {x:Type dc:ButtonDropDown}, ButtonDropDownMenuItem}"
         TargetType="{x:Type dc:ButtonDropDown}">
    <Setter Property="Control.VerticalContentAlignment" Value="Center"/>
    <Setter Property="dc:ButtonDropDown.CommandParameter">
      <Setter.Value>
        <dc:ButtonCommandParameter/>
      </Setter.Value>
    </Setter>
    <Setter Property="Control.Foreground"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.ButtonNormalForeground}}}"/>
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <dc:ButtonBorder Name="PART_ButtonDropDownBorder" BorderThickness="1,1,1,1"
                           SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" CornerRadius="2"
                           Padding="{TemplateBinding Control.Padding}" ColorClass="{x:Static dc:RibbonColors.MenuItemClass}"
                           BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.ButtonNormalBorder}}}"
                           LightBorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.ButtonNormalBorderLight}}}"
                           Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.ButtonNormalBackground}}}"
                           TopHighlight="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.ButtonNormalTopHighlight}}}"
                           BottomHighlight="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.ButtonNormalBottomHighlight}}}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition SharedSizeGroup="MenuIconColumnGroup" Width="Auto" MinWidth="24"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="37"/>
                <ColumnDefinition SharedSizeGroup="MenuShortcutColumnGroup" Width="Auto"/>
                <ColumnDefinition Width="17"/>
              </Grid.ColumnDefinitions>
              <Border Name="PART_ImageCheckBox" Padding="1,1,1,1" CornerRadius="2,2,2,2" BorderThickness="1,1,1,1"
                      Grid.Column="0" BorderBrush="{x:Null}" Background="{x:Null}">
                <ContentPresenter Name="PART_ButtonImage" ContentSource="RenderImage" VerticalAlignment="Center"
                                  SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"
                                  Content="{TemplateBinding dc:ButtonDropDown.RenderImage}"/>
              </Border>
              <Border Name="PART_CheckBox" Height="18" CornerRadius="3,3,3,3" Width="18" Visibility="Collapsed"
                      BorderThickness="1,1,1,1" Background="Transparent" Grid.Column="0" BorderBrush="{x:Null}">
                <Path Name="PART_CheckBoxGlyph" Height="11" Data="{StaticResource ButtonCheckBoxGlyph}"
                      Fill="{TemplateBinding TextElement.Foreground}" FlowDirection="LeftToRight" Width="9"/>
              </Border>
              <ContentPresenter Name="PART_ButtonContent"
                                HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}"
                                SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" RecognizesAccessKey="True"
                                ContentTemplate="{TemplateBinding HeaderedContentControl.HeaderTemplate}"
                                Content="{TemplateBinding HeaderedItemsControl.Header}" Margin="3,1,3,1" Grid.Column="2"/>
              <TextBlock Name="InputGestureBlock" Text="{TemplateBinding dc:ButtonDropDown.InputGestureText}"
                         Margin="{TemplateBinding Control.Padding}" Visibility="Visible" Grid.Column="4"/>
              <Path Name="PART_ButtonExpand" Margin="4,0,0,0" Data="M 0,0 L 4,3.5 0,7 Z"
                    Fill="{TemplateBinding TextElement.Foreground}" VerticalAlignment="Center"
                    Visibility="{TemplateBinding dc:ButtonDropDown.IsExpandVisible}" Grid.Column="5"/>
              <Popup Name="PART_Popup" VerticalOffset="-1" Focusable="false"
                     AllowsTransparency="{x:Static dc:Ribbon.PopupAllowsTransparency}"
                     PopupAnimation="{DynamicResource {x:Static SystemParameters.MenuPopupAnimationKey}}"
                     Placement="{Binding Path=PopupPlacement, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource PopupPlacementConverter}}"
                     IsOpen="{Binding Path=IsPopupOpen, RelativeSource={RelativeSource TemplatedParent}}">
                <WinTheme:SystemDropShadowChrome FrameworkElement.Name="Shdw" Color="#00FFFFFF">
                  <ContentControl Name="PART_PopupContent" IsTabStop="False"
                                  Template="{DynamicResource {ComponentResourceKey ResourceId=PopupTypeMenuContent, TypeInTargetAssembly=dc:ButtonDropDown}}">
                    <ScrollViewer CanContentScroll="True" Grid.ColumnSpan="2"
                                  Style="{DynamicResource {ComponentResourceKey ResourceId=MenuScrollViewer, TypeInTargetAssembly=FrameworkElement}}">
                      <ItemsPresenter Margin="2,2,2,2" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"
                                      KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle"
                                      Grid.IsSharedSizeScope="True"/>
                    </ScrollViewer>
                  </ContentControl>
                </WinTheme:SystemDropShadowChrome>
              </Popup>
            </Grid>
          </dc:ButtonBorder>
          <ControlTemplate.Triggers>
            <Trigger Value="{x:Null}" Property="dc:ButtonDropDown.Image">
              <Setter TargetName="PART_ImageCheckBox" Value="{x:Static Visibility.Hidden}"
                      Property="UIElement.Visibility"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="dc:ButtonDropDown.IsChecked" Value="true"/>
                <Condition Value="{x:Null}" Property="dc:ButtonDropDown.Image"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="PART_CheckBox" Property="UIElement.Visibility" Value="Visible"/>
            </MultiTrigger>
            <Trigger Property="dc:ButtonDropDown.IsChecked" Value="True">
              <Setter TargetName="PART_CheckBox"
                      Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.MenuCheckedBorder}}}"
                      Property="Border.BorderBrush"/>
              <Setter TargetName="PART_CheckBox"
                      Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.MenuCheckedBackground}}}"
                      Property="Border.Background"/>
              <Setter TargetName="PART_ImageCheckBox"
                      Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.MenuCheckedBorder}}}"
                      Property="Border.BorderBrush"/>
              <Setter TargetName="PART_ImageCheckBox"
                      Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.MenuCheckedBackground}}}"
                      Property="Border.Background"/>
            </Trigger>
            <Trigger Property="UIElement.IsEnabled" Value="False">
              <Setter Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.ButtonDisabledForeground}}}"
                      Property="TextElement.Foreground"/>
            </Trigger>
            <Trigger SourceName="PART_Popup" Property="Popup.HasDropShadow" Value="True">
              <Setter TargetName="Shdw" Property="FrameworkElement.Margin" Value="0,0,5,5"/>
              <Setter TargetName="Shdw" Property="WinTheme:SystemDropShadowChrome.Color">
                <Setter.Value>
                  <Color>#71000000</Color>
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="dc:ButtonDropDown.InputGestureText" Value="">
              <Setter TargetName="InputGestureBlock" Property="UIElement.Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="UIElement.IsEnabled" Value="False">
              <Setter Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.ButtonDisabledForeground}}}"
                      Property="TextElement.Foreground"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type dc:QatCustomizeButton}" BasedOn="{StaticResource {x:Type dc:ButtonDropDown}}">
    <Setter Property="FrameworkElement.Margin" Value="8,0,0,0"/>
    <Setter Property="FrameworkElement.MinHeight" Value="18"/>
    <Setter Property="dc:ButtonDropDown.Role" Value="DropDown"/>
    <Setter Property="dc:ButtonDropDown.ExpandVisibility" Value="Hidden"/>
    <Setter Property="dc:ButtonDropDown.PopupType" Value="Menu"/>
  </Style>
  <Style TargetType="{x:Type dc:ButtonEx}" BasedOn="{StaticResource {x:Type dc:ButtonDropDown}}">
    <Setter Property="dc:ButtonDropDown.ColorClass" Value="ButtonWithBackground"/>
  </Style>
</ResourceDictionary>