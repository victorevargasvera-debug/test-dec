<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:dc="clr-namespace:DevComponents.WpfRibbon"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Geometry x:Key="DownArrow">M0,0 L1,0 0.5,1Z</Geometry>
  <Geometry x:Key="UpArrow">M0,1 L1,1 0.5,0Z</Geometry>
  <Geometry x:Key="RightArrow">M0,0 L1,0.5 0,1Z</Geometry>
  <Geometry x:Key="LeftArrow">M0,0.5 L1,1 1,0Z</Geometry>
  <Style TargetType="{x:Type dc:ExpandDecorator}">
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True"/>
    <Setter Property="Control.Background"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.ExpandBackground}}}"/>
    <Setter Property="Control.BorderBrush" Value="#E0FFFFFF"/>
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type dc:ExpandDecorator}">
          <Grid>
            <Path Name="PART_Shadow" Data="{StaticResource DownArrow}"
                  Width="{TemplateBinding dc:ExpandDecorator.ExpanderWidth}"
                  Height="{TemplateBinding dc:ExpandDecorator.ExpanderHeight}" Stretch="Fill"
                  Fill="{TemplateBinding Control.BorderBrush}" StrokeThickness="0.5"
                  Stroke="{TemplateBinding Control.BorderBrush}" Margin="0,3,0,0"/>
            <Path Name="PART_Arrow" Data="{StaticResource DownArrow}"
                  Width="{TemplateBinding dc:ExpandDecorator.ExpanderWidth}"
                  Height="{TemplateBinding dc:ExpandDecorator.ExpanderHeight}" Stretch="Fill"
                  Fill="{TemplateBinding Control.Background}" StrokeThickness="0.5"
                  Stroke="{TemplateBinding Control.Background}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="dc:ExpandDecorator.PopupPlacement" Value="Left">
              <Setter Value="{StaticResource LeftArrow}" TargetName="PART_Shadow" Property="Path.Data"/>
              <Setter Value="{StaticResource LeftArrow}" TargetName="PART_Arrow" Property="Path.Data"/>
              <Setter TargetName="PART_Shadow"
                      Value="{Binding Path=ExpanderHeight, RelativeSource={RelativeSource TemplatedParent}}"
                      Property="FrameworkElement.Width"/>
              <Setter TargetName="PART_Shadow"
                      Value="{Binding Path=ExpanderWidth, RelativeSource={RelativeSource TemplatedParent}}"
                      Property="FrameworkElement.Height"/>
              <Setter TargetName="PART_Arrow"
                      Value="{Binding Path=ExpanderHeight, RelativeSource={RelativeSource TemplatedParent}}"
                      Property="FrameworkElement.Width"/>
              <Setter TargetName="PART_Arrow"
                      Value="{Binding Path=ExpanderWidth, RelativeSource={RelativeSource TemplatedParent}}"
                      Property="FrameworkElement.Height"/>
            </Trigger>
            <Trigger Property="dc:ExpandDecorator.PopupPlacement" Value="Right">
              <Setter Value="{StaticResource RightArrow}" TargetName="PART_Shadow" Property="Path.Data"/>
              <Setter Value="{StaticResource RightArrow}" TargetName="PART_Arrow" Property="Path.Data"/>
              <Setter TargetName="PART_Shadow"
                      Value="{Binding Path=ExpanderHeight, RelativeSource={RelativeSource TemplatedParent}}"
                      Property="FrameworkElement.Width"/>
              <Setter TargetName="PART_Shadow"
                      Value="{Binding Path=ExpanderWidth, RelativeSource={RelativeSource TemplatedParent}}"
                      Property="FrameworkElement.Height"/>
              <Setter TargetName="PART_Arrow"
                      Value="{Binding Path=ExpanderHeight, RelativeSource={RelativeSource TemplatedParent}}"
                      Property="FrameworkElement.Width"/>
              <Setter TargetName="PART_Arrow"
                      Value="{Binding Path=ExpanderWidth, RelativeSource={RelativeSource TemplatedParent}}"
                      Property="FrameworkElement.Height"/>
            </Trigger>
            <Trigger Property="dc:ExpandDecorator.PopupPlacement" Value="Top">
              <Setter Value="{StaticResource UpArrow}" TargetName="PART_Shadow" Property="Path.Data"/>
              <Setter Value="{StaticResource UpArrow}" TargetName="PART_Arrow" Property="Path.Data"/>
            </Trigger>
            <Trigger Property="UIElement.IsEnabled" Value="False">
              <Setter Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=dc:Ribbon, ResourceId={x:Static dc:RibbonColors.ButtonDisabledForeground}}}"
                      Property="Control.Background"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>