<Window x:Class="AcpASKLib.IBtnAccessPasswordWnd"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:AcpCommonResources="clr-namespace:AcpCommonResources;assembly=AcpCommonResources"
        Width="400" Height="120">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="auto"/>
      <RowDefinition Height="55*"/>
    </Grid.RowDefinitions>
    <Grid Row="0" Margin="10,20,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Label x:Name="lblTitle" Grid.Column="0" Margin="40,0,5,0" HorizontalAlignment="Left"
             Content="{x:Static AcpCommonResources:AcpResources.Password_Id}"/>
      <PasswordBox x:Name="Passwd" Grid.Column="1" HorizontalAlignment="Left" Height="23" Width="180"/>
    </Grid>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
      <Button Click="OnClickOK" Name="OkButton" IsDefault="True" Height="23" Width="80" Margin="10,0,0,0"
              Content="{x:Static AcpCommonResources:AcpResources.OK_Id}"/>
      <Button Click="OnClickCancel" Name="cancelButton" IsEnabled="True" Height="23" Width="80" Margin="10,0,0,0"
              IsCancel="True" Content="{x:Static AcpCommonResources:AcpResources.Cancel_Id}"/>
    </StackPanel>
  </Grid>
</Window>