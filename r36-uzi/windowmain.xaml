<dc:RibbonWindow x:Class="MackinawCPS.WindowMain"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:igEditors="http://infragistics.com/Editors"
                 xmlns:AcpUINS="clr-namespace:AcpUI;assembly=AcpUI"
                 xmlns:AcpUICustVwNS="clr-namespace:AcpUI.CustomView;assembly=AcpUI"
                 xmlns:AcpBLConverterNS="clr-namespace:AcpBusinessLayer.ValueConverters;assembly=AcpBusinessLayer"
                 xmlns:MackinawCPSNS="clr-namespace:MackinawCPS"
                 xmlns:CommonResxNS="clr-namespace:CommonResources;assembly=CommonResources"
                 xmlns:AcpCommonLibNS="clr-namespace:AcpCommonLib;assembly=AcpCommonLib"
                 xmlns:AcpSecurityLibNS="clr-namespace:AcpSecurityLib;assembly=AcpSecurityLib"
                 xmlns:LocalConverterNS="clr-namespace:ConstraintHelper;assembly=AllFeatures"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:dc="clr-namespace:DevComponents.WpfRibbon;assembly=AcpWpfRibbon"
                 xmlns:labtool="LabTool"
                 xmlns:depot="Depot"
                 xmlns:sys="clr-namespace:System;assembly=mscorlib"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2006"
                 xml:lang="en-US" Loaded="OnLoad" Closing="onExitApp" Drop="WindowMain_Drop"
                 MouseEnter="WindowMain_AllowDrop" MouseLeave="WindowMain_AllowDrop"
                 AutomationProperties.AutomationId="WindowMainAutomationId"
                 Title="{x:Static CommonResxNS:AppResources.APX_CPS}" ResizeMode="CanResizeWithGrip" Width="1050"
                 Height="780">
  <FrameworkElement.Resources>
    <MackinawCPSNS:CodeplugCfgMenuVisibilityConverter x:Key="CpCfgMenuVisibilityConverter"/>
    <MackinawCPSNS:DeviceCertificatesEnableConverter x:Key="DeviceCertificatesEnableConverter"/>
    <MackinawCPSNS:CustomViewMenuVisibilityConverter x:Key="CustomVwMenuVisibilityConverter"/>
    <MackinawCPSNS:MainMenuEnabledConverter x:Key="MainMenuEnabledConverter"/>
    <MackinawCPSNS:CloudNativeModeVisibilityInvertedConverter x:Key="CloudNativeModeVisibilityInvertedConverter"/>
    <MackinawCPSNS:CloudNativeModeVisibilityConverter x:Key="CloudNativeModeVisibilityConverter"/>
    <MackinawCPSNS:EditPasswordEnabledConverter x:Key="EditPasswordEnabledConverter"/>
    <MackinawCPSNS:ResetRadioPasswordEnabledConverter x:Key="ResetRadioPasswordEnabledConverter"/>
    <MackinawCPSNS:RTDMenuEnabledConverter x:Key="RTDMenuEnabledConverter"/>
    <MackinawCPSNS:ComparatorMenuItemsEnabledConverter x:Key="ComparatorMenuItemsEnabledConverter"/>
    <MackinawCPSNS:RadioHandOutEnabledConverter x:Key="RadioHandOutEnabledConverter"/>
    <MackinawCPSNS:ReportsMenuItemsEnabledConverter x:Key="ReportsMenuItemsEnabledConverter"/>
    <MackinawCPSNS:RibbonRadioHandOutO9EnabledConverter x:Key="RibbonRadioHandOutO9EnabledConverter"/>
    <MackinawCPSNS:RibbonDVRSXMLVisibilityConverter x:Key="RibbonDVRSXMLVisibilityConverter"/>
    <MackinawCPSNS:RibbonDVRSXMLEnabledConverter x:Key="RibbonDVRSXMLEnabledConverter"/>
    <MackinawCPSNS:RibbonUpdataCallListVisibilityConverter x:Key="RibbonUpdataCallListVisibilityConverter"/>
    <MackinawCPSNS:RibbonUpdataCallListEnabledConverter x:Key="RibbonUpdataCallListEnabledConverter"/>
    <MackinawCPSNS:RibbonRadioUserDefinedEnabledConverter x:Key="RibbonRadioUserDefinedEnabledConverter"/>
    <MackinawCPSNS:ComparatorMenuEnabledConverter x:Key="ComparatorMenuEnabledConverter"/>
    <MackinawCPSNS:BBFCreatorMenuEnabledConverter x:Key="BBFCreatorMenuEnabledConverter"/>
    <AcpBLConverterNS:InvertBoolConverter x:Key="InvertBoolConverter"/>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>
    <LocalConverterNS:InvertBoolToVisibleConverter x:Key="InvertBooleanToVisibility"/>
    <MackinawCPSNS:POP25BatchSchedulerMenuEnabledConverter x:Key="POP25BatchSchedulerMenuEnabledConverter"/>
    <RoutedCommand x:Key="F1Help"/>
    <Style x:Key="ValidateBTPANIPAddressTextBoxStyle" TargetType="{x:Type TextBox}">
      <Style.Triggers>
        <Trigger Property="Validation.HasError" Value="True">
          <Setter Property="Control.Foreground" Value="Red"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <ControlTemplate x:Key="ValidationErrorBlankTemplate">
      <DockPanel Visibility="Collapsed"/>
    </ControlTemplate>
  </FrameworkElement.Resources>
  <UIElement.CommandBindings>
    <CommandBinding Executed="OnClickRibbonBarCPSHelp" CanExecute="F1HelpCommandCanExcute"
                    Command="{StaticResource F1Help}"/>
  </UIElement.CommandBindings>
  <UIElement.InputBindings>
    <KeyBinding Command="{StaticResource F1Help}" Key="F1"/>
  </UIElement.InputBindings>
  <DockPanel Name="WindowMainDockPanel" LastChildFill="True">
    <dc:Ribbon Name="WindowMainRibbonControl" DockPanel.Dock="Top" AutoHideRibbonContent="False"
               IsMinimized="true" LicenseKey="DAD80300DA22">
      <dc:Ribbon.ApplicationMenu>
        <dc:ApplicationMenu IsEnabled="{Binding Path=BlockFlashReadRadio}">
          <dc:ButtonDropDown.Image>
            <Image x:Name="imgRibbonAppMenu" Source="icons/motoBatwings.png" Width="24" Height="24"/>
          </dc:ButtonDropDown.Image>
          <dc:ApplicationMenu.AppItems>
            <dc:ButtonDropDown Name="AppMenuItemExitRibbonPad" Header="{x:Static CommonResxNS:AppResources.Exit_RibbonPad}"
                               ColorClass="ButtonWithBackground" Margin="6,0,0,0">
              <dc:ButtonDropDown.Image>
                <Image Source="images/ExitIcon.png" Width="16" Height="16"/>
              </dc:ButtonDropDown.Image>
            </dc:ButtonDropDown>
          </dc:ApplicationMenu.AppItems>
          <dc:ApplicationMenu.MruItems>
            <TextBlock MinWidth="200" Foreground="Black" FontWeight="Bold"
                       Text="{x:Static CommonResxNS:AppResources.Recent_Codeplugs}"
                       Visibility="{Binding Converter={StaticResource CloudNativeModeVisibilityConverter}, Path=IsCloudNativeMode}"/>
            <TextBlock MinWidth="200" Foreground="Black" FontWeight="Bold"
                       Visibility="{Binding Converter={StaticResource CloudNativeModeVisibilityInvertedConverter}, Path=IsCloudNativeMode}"/>
            <Separator Visibility="{Binding Converter={StaticResource CloudNativeModeVisibilityConverter}, Path=IsCloudNativeMode}"/>
            <AcpUINS:AcpListBoxMruFiles FileClick="OnAppMruFileOpen" Name="AppMruList"
                                        IsEnabled="{Binding ElementName=AppMenuOpen, Path=IsEnabled}"
                                        Visibility="{Binding Converter={StaticResource CloudNativeModeVisibilityConverter}, Path=IsCloudNativeMode}"/>
          </dc:ApplicationMenu.MruItems>
          <dc:ButtonDropDown Click="OnAppMenuOpen" Name="AppMenuOpen" Header="{x:Static CommonResxNS:AppResources.Open_Id}" Visibility="{Binding Converter={StaticResource CloudNativeModeVisibilityConverter}, Path=IsCloudNativeMode}">
            <UIElement.IsEnabled>
              <MultiBinding Converter="{StaticResource MainMenuEnabledConverter}">
                <Binding Path="CurrentAppMode"/>
                <Binding>
                  <Binding.Source>
                    <sys:Boolean>True</sys:Boolean>
                  </Binding.Source>
                </Binding>
              </MultiBinding>
            </UIElement.IsEnabled>
            <dc:ButtonDropDown.Image>
              <Image Source="images/FileOpenIcon.png"/>
            </dc:ButtonDropDown.Image>
          </dc:ButtonDropDown>
          <dc:ButtonDropDown Click="OnAppMenuSave" Name="AppMenuSave" Header="{x:Static CommonResxNS:AppResources.Save_ID_}" Visibility="{Binding Converter={StaticResource CloudNativeModeVisibilityConverter}, Path=IsCloudNativeMode}">
            <UIElement.IsEnabled>
              <MultiBinding Converter="{StaticResource MainMenuEnabledConverter}">
                <Binding Path="CurrentAppMode"/>
                <Binding Path="CpgOpenFlag"/>
              </MultiBinding>
            </UIElement.IsEnabled>
            <dc:ButtonDropDown.Image>
              <Image Source="icons/SaveIcon.png"/>
            </dc:ButtonDropDown.Image>
          </dc:ButtonDropDown>
          <dc:ButtonDropDown Click="OnPublish" Name="AppMenuPublish"
                             Header="{x:Static CommonResxNS:AppResources.Publish_to_RadioCentral}"
                             AutomationProperties.AutomationId="AppMenuPublish"
                             Visibility="{Binding Converter={StaticResource CloudNativeModeVisibilityInvertedConverter}, Path=IsCloudNativeMode}">
            <UIElement.IsEnabled>
              <MultiBinding Converter="{StaticResource MainMenuEnabledConverter}">
                <Binding Path="CurrentAppMode"/>
                <Binding Path="CpgOpenFlag"/>
              </MultiBinding>
            </UIElement.IsEnabled>
            <dc:ButtonDropDown.Image>
              <Image Source="icons/SaveIcon.png"/>
            </dc:ButtonDropDown.Image>
          </dc:ButtonDropDown>
          <dc:ButtonDropDown Click="OnAppMenuSaveAs" Name="AppMenuSaveAs" Header="{x:Static CommonResxNS:AppResources.Save_As_}" Visibility="{Binding Converter={StaticResource CloudNativeModeVisibilityConverter}, Path=IsCloudNativeMode}">
            <UIElement.IsEnabled>
              <MultiBinding Converter="{StaticResource MainMenuEnabledConverter}">
                <Binding Path="CurrentAppMode"/>
                <Binding Path="CpgOpenFlag"/>
              </MultiBinding>
            </UIElement.IsEnabled>
            <dc:ButtonDropDown.Image>
              <Image Source="icons/SaveIcon.png"/>
            </dc:ButtonDropDown.Image>
          </dc:ButtonDropDown>
          <Separator Style="{DynamicResource AppMenuSeparator}"/>
          <dc:ButtonDropDown Click="OnAppMenuImport" Name="AppMenuImport"
                             Header="{x:Static CommonResxNS:AppResources.Import_Id}">
            <UIElement.IsEnabled>
              <MultiBinding Converter="{StaticResource MainMenuEnabledConverter}">
                <Binding Path="CurrentAppMode"/>
                <Binding Path="CpgOpenFlag"/>
              </MultiBinding>
            </UIElement.IsEnabled>
            <dc:ButtonDropDown.Image>
              <Image Source="icons/ImportIcon.png"/>
            </dc:ButtonDropDown.Image>
          </dc:ButtonDropDown>
          <dc:ButtonDropDown Click="OnAppMenuExport" Name="AppMenuExport"
                             Header="{x:Static CommonResxNS:AppResources.Export_Suspension}">
            <UIElement.IsEnabled>
              <MultiBinding Converter="{StaticResource MainMenuEnabledConverter}">
                <Binding Path="CurrentAppMode"/>
                <Binding Path="CpgOpenFlag"/>
              </MultiBinding>
            </UIElement.IsEnabled>
            <dc:ButtonDropDown.Image>
              <Image Source="icons/ExportIcon.png"/>
            </dc:ButtonDropDown.Image>
          </dc:ButtonDropDown>
          <Separator Style="{DynamicResource AppMenuSeparator}"
                     Visibility="{Binding Converter={StaticResource CloudNativeModeVisibilityConverter}, Path=IsCloudNativeMode}"/>
          <dc:ButtonDropDown Click="OnAppMenuRadioManagement" Name="AppMenuRMC"
                             Header="{x:Static CommonResxNS:AppResources.Radio_Management}"
                             Visibility="{Binding Path=IsRmAvailable, Converter={StaticResource BooleanToVisibility}, Mode=OneWay}">
            <dc:ButtonDropDown.Image>
              <Image Source="icons/RM_Large_Shadow.png" Width="40" Height="40"/>
            </dc:ButtonDropDown.Image>
          </dc:ButtonDropDown>
          <Separator Style="{DynamicResource AppMenuSeparator}"/>
          <dc:ButtonDropDown Name="AppMenuPrint" Header="{x:Static CommonResxNS:AppResources.Print_Suspension_Points}"
                             Role="DropDown" IsNestedMenu="True">
            <UIElement.IsEnabled>
              <MultiBinding Converter="{StaticResource MainMenuEnabledConverter}">
                <Binding Path="CurrentAppMode"/>
                <Binding Path="CpgOpenFlag"/>
              </MultiBinding>
            </UIElement.IsEnabled>
            <dc:ButtonDropDown.Image>
              <Image Source="icons/PrintIcon.png"/>
            </dc:ButtonDropDown.Image>
            <dc:ButtonDropDown Click="OnPrtRadioInfoReports" Name="RadioInfo"
                               Header="{x:Static CommonResxNS:AppResources.Radio_Information}" Role="MenuItem"
                               IsEnabled="{Binding ElementName=AppMenuPrint, Path=IsEnabled}"/>
            <dc:ButtonDropDown Click="OnPrtHandOutReports" Name="RadioHandOut"
                               Header="{x:Static CommonResxNS:AppResources.Radio_Handout}" Role="MenuItem"
                               IsEnabled="{Binding ElementName=AppMenuPrint, Path=IsEnabled}"
                               Visibility="{Binding Path=IsMobileModel, Converter={StaticResource InvertBooleanToVisibility}}"/>
            <dc:ButtonDropDown Click="OnPrtHandOutReportsO2" Name="RadioHandOutO2"
                               Header="{x:Static CommonResxNS:AppResources.Radio_Handout_O2}" Role="MenuItem"
                               Visibility="{Binding Path=IsMobileModel, Converter={StaticResource BooleanToVisibility}}">
              <UIElement.IsEnabled>
                <MultiBinding Converter="{StaticResource ReportsMenuItemsEnabledConverter}">
                  <Binding Path="CurrentAppMode"/>
                  <Binding Path="CpgOpenFlag"/>
                  <Binding Path="IsMobileModelAndSupportedO2"/>
                </MultiBinding>
              </UIElement.IsEnabled>
            </dc:ButtonDropDown>
            <dc:ButtonDropDown Click="OnPrtHandOutReportsO3" Name="RadioHandOutO3"
                               Header="{x:Static CommonResxNS:AppResources.Radio_Handout_O3}" Role="MenuItem"
                               Visibility="{Binding Path=IsMobileModel, Converter={StaticResource BooleanToVisibility}}">
              <UIElement.IsEnabled>
                <MultiBinding Converter="{StaticResource ReportsMenuItemsEnabledConverter}">
                  <Binding Path="CurrentAppMode"/>
                  <Binding Path="CpgOpenFlag"/>
                  <Binding Path="IsMobileModelAndSupportedO3"/>
                </MultiBinding>
              </UIElement.IsEnabled>
            </dc:ButtonDropDown>
            <dc:ButtonDropDown Click="OnPrtHandOutReportsE5" Name="RadioHandOutE5"
                               Header="{x:Static CommonResxNS:AppResources.Radio_Handout_E5}" Role="MenuItem"
                               Visibility="{Binding Path=IsMobileModel, Converter={StaticResource BooleanToVisibility}}">
              <UIElement.IsEnabled>
                <MultiBinding Converter="{StaticResource ReportsMenuItemsEnabledConverter}">
                  <Binding Path="CurrentAppMode"/>
                  <Binding Path="CpgOpenFlag"/>
                  <Binding Path="IsMobileModelAndSupportedE5"/>
                </MultiBinding>
              </UIElement.IsEnabled>
            </dc:ButtonDropDown>
            <dc:ButtonDropDown Click="OnPrtHandOutReportsO5" Name="RadioHandOutO5"
                               Header="{x:Static CommonResxNS:AppResources.Radio_Handout_O5}" Role="MenuItem"
                               Visibility="{Binding Path=IsMobileModel, Converter={StaticResource BooleanToVisibility}}">
              <UIElement.IsEnabled>
                <MultiBinding Converter="{StaticResource ReportsMenuItemsEnabledConverter}">
                  <Binding Path="CurrentAppMode"/>
                  <Binding Path="CpgOpenFlag"/>
                  <Binding Path="IsMobileModelAndSupportedO5"/>
                </MultiBinding>
              </UIElement.IsEnabled>
            </dc:ButtonDropDown>
            <dc:ButtonDropDown Click="OnPrtHandOutReportsO7" Name="RadioHandOutO7"
                               Header="{x:Static CommonResxNS:AppResources.Radio_Handout_O7}" Role="MenuItem"
                               Visibility="{Binding Path=IsMobileModel, Converter={StaticResource BooleanToVisibility}}">
              <UIElement.IsEnabled>
                <MultiBinding Converter="{StaticResource ReportsMenuItemsEnabledConverter}">
                  <Binding Path="CurrentAppMode"/>
                  <Binding Path="CpgOpenFlag"/>
                  <Binding Path="IsMobileModelAndSupportedO7"/>
                </MultiBinding>
              </UIElement.IsEnabled>
            </dc:ButtonDropDown>
            <dc:ButtonDropDown Click="OnPrtHandOutReportsO9" Name="RadioHandOutO9"
                               Header="{x:Static CommonResxNS:AppResources.Radio_Handout_O9}" Role="MenuItem"
                               Visibility="{Binding Path=IsMobileModel, Converter={StaticResource BooleanToVisibility}}">
              <UIElement.IsEnabled>
                <MultiBinding Converter="{StaticResource RibbonRadioHandOutO9EnabledConverter}">
                  <Binding Path="CurrentAppMode"/>
                  <Binding Path="CpgOpenFlag"/>
                  <Binding Path="IsMobileModelAndSupportedO9"/>
                </MultiBinding>
              </UIElement.IsEnabled>
            </dc:ButtonDropDown>
            <dc:ButtonDropDown Click="OnPrtChoicesReports" Name="RadioPrintChoices"
                               Header="{x:Static CommonResxNS:AppResources.Print_Choices}" Role="MenuItem"
                               IsEnabled="{Binding ElementName=AppMenuPrint, Path=IsEnabled}"/>
          </dc:ButtonDropDown>
          <Separator Style="{DynamicResource AppMenuSeparator}"
                     Visibility="{Binding Converter={StaticResource CloudNativeModeVisibilityConverter}, Path=IsCloudNativeMode}"/>
          <dc:ButtonDropDown Click="OnAppMenuClose" Name="AppMenuClose" Header="{x:Static CommonResxNS:AppResources.Close_Id}" Visibility="{Binding Converter={StaticResource CloudNativeModeVisibilityConverter}, Path=IsCloudNativeMode}">
            <UIElement.IsEnabled>
              <MultiBinding Converter="{StaticResource MainMenuEnabledConverter}">
                <Binding Path="CurrentAppMode"/>
                <Binding Path="CpgOpenFlag"/>
              </MultiBinding>
            </UIElement.IsEnabled>
            <dc:ButtonDropDown.Image>
              <Image Source="icons/CloseIcon.png"/>
            </dc:ButtonDropDown.Image>
          </dc:ButtonDropDown>
          <Separator Style="{DynamicResource AppMenuSeparator}"/>
          <dc:ButtonDropDown Click="OnAppMenuOptions" Name="AppMenuOptions"
                             Header="{x:Static CommonResxNS:AppResources.Options_Id}">
            <dc:ButtonDropDown.Image>
              <Image Source="images/OptionIcon.png"/>
            </dc:ButtonDropDown.Image>
          </dc:ButtonDropDown>
          <Separator Style="{DynamicResource AppMenuSeparator}"/>
          <dc:ButtonDropDown Click="OnAppMenuExit" Name="AppMenuExit" Header="{x:Static CommonResxNS:AppResources.Exit_Id}">
            <dc:ButtonDropDown.Image>
              <Image Source="images/ExitIcon.png"/>
            </dc:ButtonDropDown.Image>
          </dc:ButtonDropDown>
        </dc:ApplicationMenu>
      </dc:Ribbon.ApplicationMenu>
      <dc:Ribbon.QuickAccessToolbar>
        <dc:Qat Visibility="{Binding Converter={StaticResource CloudNativeModeVisibilityConverter}, Path=IsCloudNativeMode}">
          <dc:ButtonDropDown Name="QATDummy" Header="{x:Static CommonResxNS:AppResources.Dummy_Id}" Visibility="Collapsed"/>
          <dc:ButtonDropDown Click="OnQATOpen" Name="QATOpen" Header="{x:Static CommonResxNS:AppResources.Open_Id}"
                             PartVisibility="ImageOnly" ToolTip="{x:Static CommonResxNS:AppResources.Open_Id}"
                             IsEnabled="{Binding Path=BlockFlashReadRadio}">
            <dc:ButtonDropDown.Image>
              <Image Source="images/FileOpenIcon.png"/>
            </dc:ButtonDropDown.Image>
          </dc:ButtonDropDown>
          <dc:ButtonDropDown Click="OnAppMenuSave" Name="QATSave" Header="{x:Static CommonResxNS:AppResources.Save_ID_}"
                             PartVisibility="ImageOnly" ToolTip="{x:Static CommonResxNS:AppResources.Saves_Codeplug}">
            <UIElement.IsEnabled>
              <MultiBinding Converter="{StaticResource MainMenuEnabledConverter}">
                <Binding Path="CurrentAppMode"/>
                <Binding Path="CpgOpenFlag"/>
              </MultiBinding>
            </UIElement.IsEnabled>
            <dc:ButtonDropDown.Image>
              <Image Source="icons/SaveIcon.png"/>
            </dc:ButtonDropDown.Image>
          </dc:ButtonDropDown>
          <dc:ButtonDropDown Click="OnAppMenuRadioManagement" Name="QATRMC"
                             Header="{x:Static CommonResxNS:AppResources.Radio_Management}" PartVisibility="ImageOnly"
                             ToolTip="{x:Static CommonResxNS:AppResources.Radio_Management}"
                             Visibility="{Binding Path=IsRmAvailable, Converter={StaticResource BooleanToVisibility}, Mode=OneWay}">
            <dc:ButtonDropDown.Image>
              <Image Source="icons/RM.ico"/>
            </dc:ButtonDropDown.Image>
          </dc:ButtonDropDown>
          <dc:QatCustomizeButton/>
        </dc:Qat>
      </dc:Ribbon.QuickAccessToolbar>
      <dc:RibbonTab Name="ribbonTabCodeplug" Header="{x:Static CommonResxNS:AppResources.Codeplug_Id}"
                    Visibility="{Binding Path=CurrentAppMode, Converter={StaticResource CpCfgMenuVisibilityConverter}, Mode=OneWay}">
        <dc:RibbonBarPanel Name="ribbonBarPanelCodeplug" Height="70">
          <dc:RibbonBar Header="{x:Static CommonResxNS:AppResources.Archive_Id}"
                        CollapsedHeader="{x:Static CommonResxNS:AppResources.Archive_Id}" Padding="3"
                        ContextMenuService.IsEnabled="False" ResizeOrderIndex="1" HorizontalContentAlignment="Stretch">
            <StackPanel Orientation="Vertical">
              <dc:ButtonDropDown Click="OnRibbonBarSaveCodeplug" Name="RibbonBarSave"
                                 Header="{x:Static CommonResxNS:AppResources.Save_ID}" dc:RibbonBar.MinAutoSizeHint="Medium"
                                 ExpandPosition="Bottom" PopupType="Menu" ContentExpands="true" VerticalContentAlignment="Center" Visibility="{Binding Converter={StaticResource CloudNativeModeVisibilityConverter}, Path=IsCloudNativeMode}">
                <UIElement.IsEnabled>
                  <MultiBinding Converter="{StaticResource MainMenuEnabledConverter}">
                    <Binding Path="CurrentAppMode"/>
                    <Binding Path="CpgOpenFlag"/>
                  </MultiBinding>
                </UIElement.IsEnabled>
                <dc:ButtonDropDown.Image>
                  <Image Style="{StaticResource Image16x16Style}" Source="icons/SaveIcon.png"/>
                </dc:ButtonDropDown.Image>
                <FrameworkElement.ToolTip>
                  <dc:SuperToolTip>
                    <TextBlock TextWrapping="Wrap" Width="180" Text="{x:Static CommonResxNS:AppResources.Saves_Codeplug}"/>
                  </dc:SuperToolTip>
                </FrameworkElement.ToolTip>
              </dc:ButtonDropDown>
              <dc:ButtonDropDown Click="OnPublish" Name="RibbonBarPublish" AutomationProperties.AutomationId="RibbonBarPublish"
                                 Header="{x:Static CommonResxNS:AppResources.Publish_to_RadioCentral}"
                                 dc:RibbonBar.MinAutoSizeHint="Medium" ExpandPosition="Bottom" PopupType="Menu"
                                 ContentExpands="true" VerticalContentAlignment="Center"
                                 Visibility="{Binding Converter={StaticResource CloudNativeModeVisibilityInvertedConverter}, Path=IsCloudNativeMode}">
                <UIElement.IsEnabled>
                  <MultiBinding Converter="{StaticResource MainMenuEnabledConverter}">
                    <Binding Path="CurrentAppMode"/>
                    <Binding Path="CpgOpenFlag"/>
                  </MultiBinding>
                </UIElement.IsEnabled>
                <dc:ButtonDropDown.Image>
                  <Image Style="{StaticResource Image16x16Style}" Source="icons/SaveIcon.png"/>
                </dc:ButtonDropDown.Image>
              </dc:ButtonDropDown>
            </StackPanel>
          </dc:RibbonBar>
          <dc:RibbonBar Name="ribbonBarEdit" Header="{x:Static CommonResxNS:AppResources.Edit_Id}"
                        CollapsedHeader="{x:Static CommonResxNS:AppResources.Edit_Id}" Padding="3"
                        ContextMenuService.IsEnabled="False" ResizeOrderIndex="2">
            <dc:RibbonBar.CollapsedImage>
              <Image Source="images/Edit_Undo.png"/>
            </dc:RibbonBar.CollapsedImage>
            <StackPanel Orientation="Vertical">
              <dc:ButtonDropDown Click="OnQATUndo" Name="QATUndo" Header="{x:Static CommonResxNS:AppResources.Undo_Id}"
                                 IsEnabled="{Binding Path=CanUndo}">
                <dc:ButtonDropDown.Image>
                  <Image Style="{StaticResource Image16x16Style}" Source="images/Edit_Undo.png"/>
                </dc:ButtonDropDown.Image>
              </dc:ButtonDropDown>
              <dc:ButtonDropDown Click="OnQATRedo" Name="QATRedo" Header="{x:Static CommonResxNS:AppResources.Redo_Id}"
                                 IsEnabled="{Binding Path=CanRedo}">
                <dc:ButtonDropDown.Image>
                  <Image Style="{StaticResource Image16x16Style}" RenderTransformOrigin="0.5,0.5"
                         Source="images/Edit_Undo.png">
                    <UIElement.RenderTransform>
                      <ScaleTransform ScaleX="-1"/>
                    </UIElement.RenderTransform>
                  </Image>
                </dc:ButtonDropDown.Image>
              </dc:ButtonDropDown>
            </StackPanel>
          </dc:RibbonBar>
          <dc:RibbonBar GotFocus="OnRibbonBarRestoreButtonsGotFoucs" LostFocus="OnRibbonBarRestoreButtonsLostFocus"
                        Name="ribbonBarRestore" Header="{x:Static CommonResxNS:AppResources.Restore_ID}"
                        CollapsedHeader="{x:Static CommonResxNS:AppResources.Restore_ID}" Padding="3"
                        ContextMenuService.IsEnabled="False" ResizeOrderIndex="3" HorizontalContentAlignment="Stretch">
            <dc:RibbonBar.CollapsedImage>
              <Image Style="{StaticResource Image32x32Style}" Source="{StaticResource RtdDrawingImage}"/>
            </dc:RibbonBar.CollapsedImage>
            <dc:ButtonDropDown Name="RibbonBarRtd" Header="{x:Static CommonResxNS:AppResources.Restore_To_Default}"
                               ExpandPosition="Bottom" Role="DropDown" ContentExpands="true" HorizontalAlignment="Left"
                               VerticalContentAlignment="Center">
              <UIElement.IsEnabled>
                <MultiBinding Converter="{StaticResource RTDMenuEnabledConverter}">
                  <Binding Path="CurrentAppMode"/>
                  <Binding Path="CpgOpenFlag"/>
                </MultiBinding>
              </UIElement.IsEnabled>
              <dc:ButtonDropDown.Image>
                <Image Style="{StaticResource Image16x16Style}" Source="{StaticResource RtdDrawingImage}"/>
              </dc:ButtonDropDown.Image>
              <dc:ButtonDropDown Click="OnRibbonBarShowRtdButtons" Name="ribbonBarShowRtdButtons"
                                 Header="{x:Static CommonResxNS:AppResources.Show_Hide_Restore_To_Default_Buttons}" Tag="Opened"
                                 Role="MenuItem">
                <UIElement.IsEnabled>
                  <MultiBinding Converter="{StaticResource ComparatorMenuItemsEnabledConverter}">
                    <Binding Path="CurrentAppMode"/>
                    <Binding Path="CpgOpenFlag"/>
                  </MultiBinding>
                </UIElement.IsEnabled>
                <dc:ButtonDropDown.Image>
                  <Image Style="{StaticResource Image16x16Style}" Source="icons/ShowHideRestoreButtons.png"/>
                </dc:ButtonDropDown.Image>
                <FrameworkElement.ToolTip>
                  <dc:SuperToolTip>
                    <TextBlock TextWrapping="Wrap" Width="180" Text="{x:Static CommonResxNS:AppResources.Restore_To_Default}"/>
                  </dc:SuperToolTip>
                </FrameworkElement.ToolTip>
              </dc:ButtonDropDown>
              <dc:ButtonDropDown Click="OnRibbonBarPageRestoreAll" Name="RibbonBarRtdPageRestoreAll"
                                 Header="{x:Static CommonResxNS:AppResources.Restore_All_Fields}" Tag="Opened" Role="MenuItem">
                <dc:ButtonDropDown.Image>
                  <Image Style="{StaticResource Image16x16Style}" Source="icons/refresh.png"/>
                </dc:ButtonDropDown.Image>
                <FrameworkElement.ToolTip>
                  <dc:SuperToolTip>
                    <TextBlock TextWrapping="Wrap" Width="180" Text="{x:Static CommonResxNS:AppResources.Restore_To_Default}"/>
                  </dc:SuperToolTip>
                </FrameworkElement.ToolTip>
              </dc:ButtonDropDown>
              <dc:ButtonDropDown Click="OnRibbonBarPageRestoreAllInvalids" Name="RibbonBarRtdInvalidsRestoreAll"
                                 Header="{x:Static CommonResxNS:AppResources.Restore_All_Invalid_Fields}" Tag="Opened"
                                 Role="MenuItem">
                <dc:ButtonDropDown.Image>
                  <Image Style="{StaticResource Image16x16Style}" Source="icons/RestoreInvalids.png"/>
                </dc:ButtonDropDown.Image>
                <FrameworkElement.ToolTip>
                  <dc:SuperToolTip>
                    <TextBlock TextWrapping="Wrap" Width="180"
                               Text="{x:Static CommonResxNS:AppResources.Restore_All_Invalid_Fields_To_Default}"/>
                  </dc:SuperToolTip>
