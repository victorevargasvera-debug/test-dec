<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:igEditors="http://infragistics.com/Editors"
                    xmlns:AcpUINS="clr-namespace:AcpUI;assembly=AcpUI">
  <Style TargetType="{x:Type AcpUINS:AcpPasswordEyeBox}">
    <Setter Property="Control.Background"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBox, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTextBoxBackground}}}"/>
    <Setter Property="Control.Foreground"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBox, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTextBoxForeground}}}"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpValid}" Value="false">
        <Setter Property="Control.Foreground"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBox, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTextBoxInValidForeground}}}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpApplicable}" Value="false">
        <Setter Property="UIElement.IsEnabled" Value="False"/>
        <Setter Property="Control.Background" Value="{x:Static JetSystemColors.ControlBrush}"/>
        <Setter Property="Control.Foreground" Value="{x:Static JetSystemColors.GrayTextBrush}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpEditable}" Value="false">
        <Setter Property="UIElement.IsEnabled" Value="False"/>
        <Setter Property="Control.Background" Value="{x:Static JetSystemColors.ControlBrush}"/>
        <Setter Property="Control.Foreground" Value="{x:Static JetSystemColors.GrayTextBrush}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpVisible}" Value="false">
        <Setter Property="UIElement.Visibility" Value="Collapsed"/>
      </DataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpValid}" Value="false"/>
          <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpApplicable}" Value="false"/>
        </MultiDataTrigger.Conditions>
        <Setter Property="Control.Foreground"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBox, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTextBoxInValidForeground}}}"/>
        <Setter Property="Control.Background" Value="{x:Static JetSystemColors.ControlBrush}"/>
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpValid}" Value="false"/>
          <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpEditable}" Value="false"/>
        </MultiDataTrigger.Conditions>
        <Setter Property="Control.Foreground"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBox, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTextBoxInValidForeground}}}"/>
        <Setter Property="Control.Background" Value="{x:Static JetSystemColors.ControlBrush}"/>
      </MultiDataTrigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="{x:Type AcpUINS:AcpTablePasswordEyeBox}">
    <Setter Property="Control.Background"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTableTextBoxBase, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTableTextBoxBackground}}}"/>
    <Setter Property="Control.Foreground"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTableTextBoxBase, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTableTextBoxForeground}}}"/>
    <Setter Property="AcpUINS:AcpPasswordEyeBox.IsEyeVisible" Value="0"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpValid}" Value="false">
        <Setter Property="Control.Foreground"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBox, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTextBoxInValidForeground}}}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpApplicable}" Value="false">
        <Setter Property="UIElement.IsEnabled" Value="False"/>
        <Setter Property="Control.Background"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTableTextBoxBase, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTableTextBoxInapplicableBackground}}}"/>
        <Setter Property="Control.Foreground" Value="{x:Static JetSystemColors.GrayTextBrush}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpEditable}" Value="false">
        <Setter Property="UIElement.IsEnabled" Value="False"/>
        <Setter Property="Control.Background"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBox, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTableTextBoxInapplicableBackground}}}"/>
        <Setter Property="Control.Foreground" Value="{x:Static JetSystemColors.GrayTextBrush}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpVisible}" Value="false">
        <Setter Property="UIElement.Visibility" Value="Collapsed"/>
      </DataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpValid}" Value="false"/>
          <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpApplicable}" Value="false"/>
        </MultiDataTrigger.Conditions>
        <Setter Property="Control.Foreground"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBox, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTextBoxInValidForeground}}}"/>
        <Setter Property="Control.Background"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBox, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTableTextBoxInapplicableBackground}}}"/>
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpValid}" Value="false"/>
          <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpEditable}" Value="false"/>
        </MultiDataTrigger.Conditions>
        <Setter Property="Control.Foreground"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBox, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTextBoxInValidForeground}}}"/>
        <Setter Property="Control.Background"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBox, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTableTextBoxInapplicableBackground}}}"/>
      </MultiDataTrigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="UIElement.IsMouseOver" Value="true"/>
          <Condition Property="AcpUINS:AcpPasswordEyeBox.IsAcpEditable" Value="true"/>
          <Condition Property="AcpUINS:AcpPasswordEyeBox.IsAcpApplicable" Value="true"/>
        </MultiTrigger.Conditions>
        <Setter Property="AcpUINS:AcpPasswordEyeBox.IsEyeVisible" Value="1"/>
      </MultiTrigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>