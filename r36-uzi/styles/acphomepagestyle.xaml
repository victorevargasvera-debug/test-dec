  <Style x:Key="HorizontalSliderThumbStyle" TargetType="{x:Type Thumb}">
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="true"/>
    <Setter Property="Control.Foreground" Value="{x:Null}"/>
    <Setter Property="Control.Background" Value="{DynamicResource {x:Static JetSystemColors.ControlBrushKey}}"/>
    <Setter Property="FrameworkElement.Height" Value="21"/>
    <Setter Property="FrameworkElement.Width" Value="11"/>
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Microsoft_Windows_Themes:ClassicBorderDecorator Background="{TemplateBinding Control.Background}"
                                                           BorderBrush="{x:Static Microsoft_Windows_Themes:ClassicBorderDecorator.ClassicBorderBrush}"
                                                           BorderStyle="Raised" BorderThickness="3">
            <Rectangle x:Name="ForegroundRect" Opacity="0.5" Margin="-1" Fill="{TemplateBinding Control.Foreground}"/>
          </Microsoft_Windows_Themes:ClassicBorderDecorator>
          <ControlTemplate.Triggers>
            <Trigger Property="Thumb.IsDragging" Value="true">
              <Setter Value="{DynamicResource {x:Static JetSystemColors.ControlLightLightBrushKey}}"
                      Property="Control.Foreground"/>
            </Trigger>
            <Trigger Property="UIElement.IsEnabled" Value="false">
              <Setter Value="{DynamicResource {x:Static JetSystemColors.ControlLightLightBrushKey}}"
                      Property="Control.Foreground"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="HorizontalSliderUpThumbStyle" TargetType="{x:Type Thumb}">
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="true"/>
    <Setter Property="Control.Foreground" Value="{x:Null}"/>
    <Setter Property="Control.Background" Value="{DynamicResource {x:Static JetSystemColors.ControlBrushKey}}"/>
    <Setter Property="FrameworkElement.Height" Value="21"/>
    <Setter Property="FrameworkElement.Width" Value="11"/>
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Canvas SnapsToDevicePixels="true">
            <Path Fill="{TemplateBinding Control.Background}" Data="M 11,21 L 0,21 0,6 5,1 6,1 11,6 Z"/>
            <Path Stroke="{DynamicResource {x:Static JetSystemColors.ControlLightLightBrushKey}}"
                  StrokeThickness="1.0" Data="M 0.5,20 L 0.5,5.5 5,0.5 5.5,0.5 "/>
            <Path Stroke="{DynamicResource {x:Static JetSystemColors.ControlDarkDarkBrushKey}}" StrokeThickness="1.0"
                  Data="M 5.5,0.5 L 6,0.5 10.5,5.5 10.5,20.5 0,20.5 "/>
            <Path Stroke="{DynamicResource {x:Static JetSystemColors.ControlLightBrushKey}}" StrokeThickness="1.0"
                  Data="M 1.5,19 L 1.5,5.5 5,1.5 5.5,1.5 "/>
            <Path Stroke="{DynamicResource {x:Static JetSystemColors.ControlDarkBrushKey}}" StrokeThickness="1.0"
                  Data="M 5.5,1.5 L 6,1.5 9.5,5.5 9.5,19.5 1,19.5 "/>
            <Path Opacity="0.5" Fill="{TemplateBinding Control.Foreground}" Data="M 9,19 L 2,19 2,6 5.5,2 9,6 Z"/>
          </Canvas>
          <ControlTemplate.Triggers>
            <Trigger Property="Thumb.IsDragging" Value="true">
              <Setter Value="{DynamicResource {x:Static JetSystemColors.ControlLightLightBrushKey}}"
                      Property="Control.Foreground"/>
            </Trigger>
            <Trigger Property="UIElement.IsEnabled" Value="false">
              <Setter Value="{DynamicResource {x:Static JetSystemColors.ControlLightLightBrushKey}}"
                      Property="Control.Foreground"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
