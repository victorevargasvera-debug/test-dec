<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style TargetType="{x:Type ProgressBar}">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ProgressBar}">
          <Grid>
            <Border x:Name="PART_Track" BorderThickness="1" CornerRadius="1,1,1,1">
              <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                  <GradientStop Color="#FF000000" Offset="0"/>
                  <GradientStop Color="#FF292929" Offset="0.405"/>
                </LinearGradientBrush>
              </Border.Background>
              <Border.BorderBrush>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                  <GradientStop Color="#FF000000" Offset="0"/>
                  <GradientStop Color="#FF797979" Offset="1"/>
                </LinearGradientBrush>
              </Border.BorderBrush>
            </Border>
            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" BorderThickness="1" CornerRadius="2"
                    BorderBrush="{x:Null}">
              <UIElement.OpacityMask>
                <LinearGradientBrush EndPoint="0.017,0.333" StartPoint="0.544,1.333">
                  <GradientStop Color="#FF000000" Offset="0"/>
                  <GradientStop Color="#22000000" Offset="1"/>
                </LinearGradientBrush>
              </UIElement.OpacityMask>
              <Border.Background>
                <LinearGradientBrush EndPoint="0.993,0.244" StartPoint="0,0">
                  <GradientStop Color="#FFFF9632" Offset="0.758"/>
                  <GradientStop Color="#FFFECA24" Offset="0.907"/>
                  <GradientStop Color="#FFD7771A" Offset="0.37"/>
                  <GradientStop Color="#FFFCE7A5" Offset="0.991"/>
                </LinearGradientBrush>
              </Border.Background>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>