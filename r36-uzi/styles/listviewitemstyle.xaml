<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:AcpUINS="clr-namespace:AcpUI;assembly=AcpUI">
  <Style TargetType="{x:Type ListView}">
    <Setter Property="Control.Background" Value="Transparent"/>
  </Style>
  <Style x:Key="ListViewItemStyleBase" TargetType="{x:Type ListViewItem}">
    <Setter Property="Control.Background"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=ListViewItem, ResourceId={x:Static AcpUINS:AcpColorKeys.ListViewItemNormalBackground}}}"/>
    <Setter Property="Control.Foreground"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=ListViewItem, ResourceId={x:Static AcpUINS:AcpColorKeys.ListViewItemNormalForeground}}}"/>
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListViewItem}">
          <Border Background="{TemplateBinding Control.Background}"
                  BorderBrush="{TemplateBinding Control.BorderBrush}"
                  BorderThickness="{TemplateBinding Control.BorderThickness}"
                  Padding="{TemplateBinding Control.Padding}">
            <StackPanel>
              <GridViewRowPresenter/>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="ListBoxItem.IsSelected" Value="true">
              <Trigger.Setters>
              </Trigger.Setters>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="ListBoxItem.IsSelected" Value="true">
        <Trigger.Setters>
          <Setter Property="Control.Background"
                  Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=ListViewItem, ResourceId={x:Static AcpUINS:AcpColorKeys.ListViewItemIsSelectedBackground}}}"/>
          <Setter Property="Control.Foreground"
                  Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=ListViewItem, ResourceId={x:Static AcpUINS:AcpColorKeys.ListViewItemIsSelectedForeground}}}"/>
        </Trigger.Setters>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="ListViewItemStyleWhite" TargetType="{x:Type ListViewItem}"
         BasedOn="{StaticResource ListViewItemStyleBase}">
    <Setter Property="Control.Background" Value="White"/>
  </Style>
  <Style x:Key="ListViewItemStyleBlue" TargetType="{x:Type ListViewItem}"
         BasedOn="{StaticResource ListViewItemStyleBase}">
    <Setter Property="Control.Background" Value="AliceBlue"/>
  </Style>
  <Style x:Key="ListViewItemContentStyle" TargetType="{x:Type ListViewItem}"
         BasedOn="{StaticResource ListViewItemStyleBase}">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListViewItem}">
          <Border Background="{TemplateBinding Control.Background}"
                  BorderBrush="{TemplateBinding Control.BorderBrush}"
                  BorderThickness="{TemplateBinding Control.BorderThickness}"
                  Padding="{TemplateBinding Control.Padding}">
            <StackPanel>
              <ContentPresenter/>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="ListBoxItem.IsSelected" Value="true">
              <Trigger.Setters>
              </Trigger.Setters>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>