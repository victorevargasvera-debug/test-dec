<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:igEditors="http://infragistics.com/Editors"
                    xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
                    xmlns:AcpUINS="clr-namespace:AcpUI;assembly=AcpUI">
  <Style TargetType="{x:Type TextBox}">
    <Setter Property="Control.Background"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBox, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTextBoxBackground}}}"/>
    <Setter Property="Control.Foreground"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBox, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTextBoxForeground}}}"/>
  </Style>
  <ContextMenu x:Key="EmptyContextMenu" Visibility="Collapsed" IsEnabled="False"/>
  <Style TargetType="{x:Type AcpUINS:AcpTextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
    <Style.Triggers>
      <Trigger Property="AcpUINS:AcpTextBox.IsMasked" Value="true">
        <Setter Property="Control.Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type AcpUINS:AcpTextBox}">
              <XamMaskedEditor FrameworkElement.Name="xamlTextEd" FrameworkElement.ContextMenu="{StaticResource EmptyContextMenu}"
                               InvalidValueBehavior="RevertValue" Control.BorderBrush="{x:Static JetSystemColors.HighlightBrush}"
                               Mask="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=MaskType}"
                               Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Text, Mode=TwoWay}"
                               Control.Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Background, Mode=OneWay}"
                               Control.Foreground="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Foreground, Mode=OneWay}"/>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsFocused" Value="true">
                  <Setter TargetName="xamlTextEd" Property="ValueEditor.IsInEditMode" Value="true"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpValid}" Value="false">
        <Setter Property="Control.Foreground"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBox, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTextBoxInValidForeground}}}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpApplicable}" Value="false">
        <Setter Property="UIElement.IsEnabled" Value="False"/>
        <Setter Property="Control.Background" Value="{x:Static JetSystemColors.ControlBrush}"/>
        <Setter Property="Control.Foreground" Value="{x:Static JetSystemColors.GrayTextBrush}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpEditable}" Value="false">
        <Setter Property="UIElement.IsEnabled" Value="False"/>
        <Setter Property="Control.Background" Value="{x:Static JetSystemColors.ControlBrush}"/>
        <Setter Property="Control.Foreground" Value="{x:Static JetSystemColors.GrayTextBrush}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpVisible}" Value="false">
        <Setter Property="UIElement.Visibility" Value="Collapsed"/>
      </DataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpValid}" Value="false"/>
          <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpApplicable}" Value="false"/>
        </MultiDataTrigger.Conditions>
        <Setter Property="Control.Foreground"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBox, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTextBoxInValidForeground}}}"/>
        <Setter Property="Control.Background" Value="{x:Static JetSystemColors.ControlBrush}"/>
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpValid}" Value="false"/>
          <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpEditable}" Value="false"/>
        </MultiDataTrigger.Conditions>
        <Setter Property="Control.Foreground"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBox, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTextBoxInValidForeground}}}"/>
        <Setter Property="Control.Background" Value="{x:Static JetSystemColors.ControlBrush}"/>
      </MultiDataTrigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="{x:Type AcpUINS:AcpTableTextBoxBase}">
    <Setter Property="Control.Background"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTableTextBoxBase, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTableTextBoxBackground}}}"/>
    <Setter Property="Control.Foreground"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTableTextBoxBase, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTableTextBoxForeground}}}"/>
    <Style.Triggers>
      <Trigger Property="AcpUINS:AcpTextBox.IsMasked" Value="true">
        <Setter Property="Control.Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type AcpUINS:AcpTableTextBoxBase}">
              <XamMaskedEditor FrameworkElement.Name="xamlTextEd" FrameworkElement.ContextMenu="{StaticResource EmptyContextMenu}"
                               InvalidValueBehavior="RevertValue" Control.BorderBrush="Transparent"
                               Mask="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=MaskType}"
                               Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Text, Mode=TwoWay}"
                               Control.Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Background, Mode=OneWay}"
                               Control.Foreground="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Foreground, Mode=OneWay}"/>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsFocused" Value="true">
                  <Setter TargetName="xamlTextEd" Property="ValueEditor.IsInEditMode" Value="true"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
      <Trigger Property="AcpUINS:AcpTextBox.IsMasked" Value="false">
        <Setter Property="Control.Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type AcpUINS:AcpTableTextBoxBase}">
              <Grid Background="Transparent" Margin="1">
                <ScrollViewer x:Name="PART_ContentHost" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"
                              Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Background, Mode=OneWay}"/>
                <TextBlock x:Name="textBlock" Opacity="0.345" TextWrapping="Wrap" Visibility="Hidden"
                           VerticalAlignment="Center" HorizontalAlignment="Left" Padding="3"/>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsEnabled" Value="false">
                  <Setter TargetName="PART_ContentHost"
                          Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTableTextBoxBase, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTableTextBoxInapplicableBackground}}}"
                          Property="Control.Background"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpValid}" Value="false">
        <Setter Property="Control.Foreground"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBox, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTextBoxInValidForeground}}}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpApplicable}" Value="false">
        <Setter Property="UIElement.IsEnabled" Value="False"/>
        <Setter Property="Control.Background"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTableTextBoxBase, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTableTextBoxInapplicableBackground}}}"/>
        <Setter Property="Control.Foreground" Value="{x:Static JetSystemColors.GrayTextBrush}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpEditable}" Value="false">
        <Setter Property="UIElement.IsEnabled" Value="False"/>
        <Setter Property="Control.Background"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTableTextBoxBase, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTableTextBoxInapplicableBackground}}}"/>
        <Setter Property="Control.Foreground" Value="{x:Static JetSystemColors.GrayTextBrush}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpVisible}" Value="false">
        <Setter Property="UIElement.Visibility" Value="Collapsed"/>
      </DataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpValid}" Value="false"/>
          <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpApplicable}" Value="false"/>
        </MultiDataTrigger.Conditions>
        <Setter Property="Control.Foreground"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBox, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTextBoxInValidForeground}}}"/>
        <Setter Property="Control.Background"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBox, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTableTextBoxInapplicableBackground}}}"/>
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpValid}" Value="false"/>
          <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpEditable}" Value="false"/>
        </MultiDataTrigger.Conditions>
        <Setter Property="Control.Foreground"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBox, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTextBoxInValidForeground}}}"/>
        <Setter Property="Control.Background"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBox, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTableTextBoxInapplicableBackground}}}"/>
      </MultiDataTrigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="{x:Type AcpUINS:AcpTableTextBox}">
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource MyFocusVisual}"/>
    <Setter Property="Control.Background"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTableTextBoxBase, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTableTextBoxBackground}}}"/>
    <Setter Property="Control.Foreground"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTableTextBoxBase, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTableTextBoxForeground}}}"/>
    <Style.Triggers>
      <Trigger Property="AcpUINS:AcpTextBox.IsMasked" Value="true">
        <Setter Property="Control.Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type AcpUINS:AcpTableTextBox}">
              <XamMaskedEditor FrameworkElement.Name="xamlTextEd" FrameworkElement.ContextMenu="{StaticResource EmptyContextMenu}"
                               InvalidValueBehavior="RevertValue" Control.BorderBrush="Transparent"
                               Mask="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=MaskType}"
                               Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Text, Mode=TwoWay}"
                               Control.Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Background, Mode=OneWay}"
                               Control.Foreground="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Foreground, Mode=OneWay}">
                <i:Interaction.Triggers>
                  <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                    <AcpUINS:AcpInvokeCommandAction Command="{Binding Source={StaticResource viewModel}, Path=MouseLeftButtonDownCommand}"
                                                    CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=., Mode=TwoWay}"/>
                  </i:EventTrigger>
                </i:Interaction.Triggers>
              </XamMaskedEditor>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsFocused" Value="true">
                  <Setter TargetName="xamlTextEd" Property="ValueEditor.IsInEditMode" Value="true"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
      <Trigger Property="AcpUINS:AcpTextBox.IsMasked" Value="false">
        <Setter Property="Control.Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type AcpUINS:AcpTableTextBox}">
              <Grid Background="Transparent" Margin="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <ScrollViewer x:Name="PART_ContentHost" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}"
                              Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Background, Mode=OneWay}"/>
                <TextBlock x:Name="textBlock" Opacity="0.345" TextWrapping="Wrap" Visibility="Hidden"
                           VerticalAlignment="Center" HorizontalAlignment="Left" Padding="3"/>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsEnabled" Value="false">
                  <Setter TargetName="PART_ContentHost"
                          Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTableTextBoxBase, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTableTextBoxInapplicableBackground}}}"
                          Property="Control.Background"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpValid}" Value="false">
        <Setter Property="Control.Foreground"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBox, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTextBoxInValidForeground}}}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpApplicable}" Value="false">
        <Setter Property="UIElement.IsEnabled" Value="False"/>
        <Setter Property="Control.Background"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTableTextBoxBase, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTableTextBoxInapplicableBackground}}}"/>
        <Setter Property="Control.Foreground" Value="{x:Static JetSystemColors.GrayTextBrush}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpEditable}" Value="false">
        <Setter Property="UIElement.IsEnabled" Value="False"/>
        <Setter Property="Control.Background"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBox, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTableTextBoxInapplicableBackground}}}"/>
        <Setter Property="Control.Foreground" Value="{x:Static JetSystemColors.GrayTextBrush}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpVisible}" Value="false">
        <Setter Property="UIElement.Visibility" Value="Collapsed"/>
      </DataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpValid}" Value="false"/>
          <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpApplicable}" Value="false"/>
        </MultiDataTrigger.Conditions>
        <Setter Property="Control.Foreground"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBox, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTextBoxInValidForeground}}}"/>
        <Setter Property="Control.Background"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBox, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTableTextBoxInapplicableBackground}}}"/>
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpValid}" Value="false"/>
          <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpEditable}" Value="false"/>
        </MultiDataTrigger.Conditions>
        <Setter Property="Control.Foreground"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBox, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTextBoxInValidForeground}}}"/>
        <Setter Property="Control.Background"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpTextBox, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpTableTextBoxInapplicableBackground}}}"/>
      </MultiDataTrigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>