<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:AcpUINS="clr-namespace:AcpUI;assembly=AcpUI">
  <Style x:Key="AcpViewOnlyCtrlStyleBase" TargetType="{x:Type AcpUINS:AcpViewOnlyCtrl}">
    <Setter Property="Control.Foreground"
            Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpViewOnlyCtrl, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpViewOnlyCtrlForeground}}}"/>
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Label}">
          <Border BorderThickness="1"
                  BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpViewOnlyCtrl, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpViewOnlyCtrlBorderBrush}}}">
            <ContentPresenter RecognizesAccessKey="False"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsEnabled" Value="False">
              <Setter Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpViewOnlyCtrl, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpViewOnlyCtrlDisabledForeground}}}"
                      Property="Control.Foreground"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type AcpUINS:AcpViewOnlyCtrl}" BasedOn="{StaticResource AcpViewOnlyCtrlStyleBase}">
    <Style.Triggers>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpValid}" Value="false">
        <Setter Property="Control.Foreground"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpViewOnlyCtrl, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpViewOnlyCtrlInValidForeground}}}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpApplicable}" Value="false">
        <Setter Property="UIElement.IsEnabled" Value="False"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpVisible}" Value="false">
        <Setter Property="UIElement.Visibility" Value="Collapsed"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="{x:Type AcpUINS:AcpTableViewOnlyCtrl}"
         BasedOn="{StaticResource AcpViewOnlyCtrlStyleBase}">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type AcpUINS:AcpTableViewOnlyCtrl}">
          <ContentPresenter RecognizesAccessKey="False"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpValid}" Value="false">
        <Setter Property="Control.Foreground"
                Value="{DynamicResource {ComponentResourceKey TypeInTargetAssembly=AcpUINS:AcpViewOnlyCtrl, ResourceId={x:Static AcpUINS:AcpColorKeys.AcpViewOnlyCtrlInValidForeground}}}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpApplicable}" Value="false">
        <Setter Property="UIElement.IsEnabled" Value="False"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsAcpVisible}" Value="false">
        <Setter Property="UIElement.Visibility" Value="Collapsed"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>