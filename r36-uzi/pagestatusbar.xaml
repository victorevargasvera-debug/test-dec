<Page x:Class="MackinawCPS.PageStatusBar"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Width="Auto" Height="Auto">
  <DockPanel>
    <StatusBar DockPanel.Dock="Bottom" MinHeight="25">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <DockPanel LastChildFill="True"/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <StatusBarItem DockPanel.Dock="Left" Margin="5,0,0,0">
        <TextBlock Name="StatusText" Text="{Binding Path=Status}"/>
      </StatusBarItem>
      <StatusBarItem DockPanel.Dock="Right" Margin="0,0,15,0">
        <TextBlock Name="CPSVersionText" Text="{Binding Path=CPSVersion}"/>
      </StatusBarItem>
      <Separator DockPanel.Dock="Right"/>
      <StatusBarItem DockPanel.Dock="Right">
        <TextBlock Name="SerialNumText" Text="{Binding Path=SerialNum}"/>
      </StatusBarItem>
      <Separator DockPanel.Dock="Right"/>
      <StatusBarItem DockPanel.Dock="Right">
        <TextBlock Name="ModelText" Text="{Binding Path=RadioModel}"/>
      </StatusBarItem>
      <Separator DockPanel.Dock="Right"/>
      <StatusBarItem DockPanel.Dock="Right">
        <TextBlock Name="CodeplugIdentifierText" Text="{Binding Path=CodeplugIdentifier}"/>
      </StatusBarItem>
      <Separator DockPanel.Dock="Right"/>
      <StatusBarItem DockPanel.Dock="Right">
        <ProgressBar Name="ProgBar" Width="100" Height="15" Visibility="Collapsed"/>
      </StatusBarItem>
      <StatusBarItem/>
    </StatusBar>
  </DockPanel>
</Page>