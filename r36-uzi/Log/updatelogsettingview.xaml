<PageFunction x:Class="MackinawCPS.Log.UpdateLogSettingView" x:TypeArguments="sys:String"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:sys="clr-namespace:System;assembly=mscorlib"
              xmlns:AcpUINS="clr-namespace:AcpUI;assembly=AcpUI"
              xmlns:CommonResxNS="clr-namespace:CommonResources;assembly=CommonResources"
              ShowsNavigationUI="False" RemoveFromJournal="True"
              Title="{x:Static CommonResxNS:AppResources.LogSetting}" Width="480">
  <FrameworkElement.Resources>
    <Style x:Key="FieldLabelStyle" TargetType="{x:Type TextBlock}">
      <Setter Property="FrameworkElement.HorizontalAlignment" Value="Right"/>
      <Setter Property="FrameworkElement.VerticalAlignment" Value="Center"/>
      <Setter Property="TextBlock.TextWrapping" Value="Wrap"/>
      <Setter Property="FrameworkElement.Height" Value="Auto"/>
    </Style>
  </FrameworkElement.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="10"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="40"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Text="{x:Static CommonResxNS:AppResources.ASTROCPS_UploadAppLogPrompt}" TextAlignment="Left"
               TextWrapping="Wrap"/>
    <Grid Row="2" HorizontalAlignment="Center" Margin="5,0"
          AutomationProperties.AutomationId="CPSHideDialogOption">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <AcpUINS:AcpCheckBox AutomationProperties.AutomationId="rcbHideDialog" IsEnabled="True"
                           IsChecked="{Binding LogSetting.HideDialogChecked, Mode=TwoWay}"/>
      <TextBlock Grid.Column="1" Margin="5,0,0,0" Text="{x:Static CommonResxNS:AppResources.Dont_show_again}"
                 Style="{StaticResource FieldLabelStyle}"/>
    </Grid>
    <Grid Row="4" HorizontalAlignment="Right" Width="200">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition Width="10"/>
        <ColumnDefinition/>
      </Grid.ColumnDefinitions>
      <AcpUINS:AcpButton x:Name="btnYes" Content="{x:Static CommonResxNS:AppResources.Yes_Id}" CommandParameter="true"
                         Command="{Binding UpdateLogSettingCommand}"/>
      <AcpUINS:AcpButton x:Name="btnNo" Grid.Column="2" Content="{x:Static CommonResxNS:AppResources.No_Id}"
                         CommandParameter="false" Command="{Binding UpdateLogSettingCommand}"/>
    </Grid>
  </Grid>
</PageFunction>